---
export interface ReportData {
  heading: string;
  intro: string;
  metrics: { label: string; value: string }[];
  proseTitle?: string;
  prose?: string;
  chart: {
    title: string;
    caption: string;
    bars: { label: string; value: number; display?: string }[];
  };
  table?: {
    title: string;
    columns: string[];
    rows: string[][];
  };
}
const { report } = Astro.props as { report: ReportData };
const maxBar = Math.max(...report.chart.bars.map((b) => Math.abs(b.value)), 1);
---

<article class="lc-report">
  <header class="lc-report__head">
    <h4 class="lc-report__heading">{report.heading}</h4>
    <p class="lc-report__intro">{report.intro}</p>
  </header>

  <div class="lc-report__metrics">
    {report.metrics.map((m) => (
      <div class="lc-metric">
        <span class="lc-metric__label">{m.label}</span>
        <span class="lc-metric__value">{m.value}</span>
      </div>
    ))}
  </div>

  {report.proseTitle && (
    <section class="lc-report__section">
      <h5 class="lc-report__sub">{report.proseTitle}</h5>
      <p class="lc-report__prose">{report.prose}</p>
    </section>
  )}

  <figure class="lc-chart">
    <figcaption class="lc-chart__title">{report.chart.title}</figcaption>
    <div class="lc-chart__bars" role="img" aria-label={report.chart.title}>
      {report.chart.bars.map((b) => {
        const w = Math.max(2, Math.round((Math.abs(b.value) / maxBar) * 100));
        return (
          <div class="lc-bar">
            <span class="lc-bar__label">{b.label}</span>
            <div class="lc-bar__track">
              <div class="lc-bar__fill" style={`width: ${w}%`}></div>
            </div>
            <span class="lc-bar__value">{b.display ?? b.value}</span>
          </div>
        );
      })}
    </div>
    <p class="lc-chart__caption">{report.chart.caption}</p>
  </figure>

  {report.table && (
    <div class="lc-table-wrap">
      <p class="lc-table__caption">{report.table.title}</p>
      <table class="lc-table">
        <thead>
          <tr>{report.table.columns.map((c) => <th>{c}</th>)}</tr>
        </thead>
        <tbody>
          {report.table.rows.map((row) => (
            <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</article>

<style>
  .lc-report {
    color: #111827;
    font-family: var(--font-sans, ui-sans-serif, system-ui);
    background: #ffffff;
    max-height: 640px;
    overflow-y: auto;
  }
  .lc-report__head {
    padding: 22px 24px 16px;
    border-bottom: 1px solid color-mix(in oklab, #4338CA 8%, rgba(17, 24, 39, 0.08));
  }
  .lc-report__heading {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.25;
    margin: 0;
    color: #0e0e0c;
    letter-spacing: -0.01em;
  }
  .lc-report__intro {
    margin: 6px 0 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: #4b5563;
  }

  .lc-report__metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: color-mix(in oklab, #4338CA 6%, rgba(17, 24, 39, 0.07));
    border-bottom: 1px solid color-mix(in oklab, #4338CA 8%, rgba(17, 24, 39, 0.08));
  }
  .lc-metric {
    background: #fff;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .lc-metric__label {
    font-family: var(--font-mono, ui-monospace);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: color-mix(in oklab, #4338CA 75%, #6b7280);
    text-transform: uppercase;
  }
  .lc-metric__value {
    font-size: 17px;
    font-weight: 600;
    color: #0e0e0c;
    letter-spacing: -0.01em;
  }

  .lc-report__section {
    padding: 18px 24px 4px;
  }
  .lc-report__sub {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 6px;
    color: #0e0e0c;
  }
  .lc-report__prose {
    font-size: 13.5px;
    line-height: 1.6;
    color: #4b5563;
    margin: 0;
  }

  .lc-chart {
    padding: 18px 24px;
    margin: 0;
  }
  .lc-chart__title {
    font-size: 14px;
    font-weight: 600;
    color: #0e0e0c;
    margin-bottom: 12px;
  }
  .lc-chart__bars {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .lc-bar {
    display: grid;
    grid-template-columns: 130px 1fr 70px;
    gap: 12px;
    align-items: center;
  }
  .lc-bar__label {
    font-size: 12px;
    color: #4b5563;
  }
  .lc-bar__track {
    height: 11px;
    background: rgba(17, 24, 39, 0.06);
    border-radius: 3px;
    overflow: hidden;
  }
  .lc-bar__fill {
    height: 100%;
    background: linear-gradient(90deg, #4338CA, #6366f1);
    border-radius: 3px;
  }
  .lc-bar__value {
    font-family: var(--font-mono, ui-monospace);
    font-size: 11.5px;
    color: #0e0e0c;
    text-align: right;
  }
  .lc-chart__caption {
    font-family: var(--font-mono, ui-monospace);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: color-mix(in oklab, #4338CA 60%, #6b7280);
    margin: 12px 0 0;
    text-transform: uppercase;
  }

  .lc-table-wrap {
    padding: 0 24px 22px;
  }
  .lc-table__caption {
    font-family: var(--font-mono, ui-monospace);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: color-mix(in oklab, #4338CA 60%, #6b7280);
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .lc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
  }
  .lc-table th {
    text-align: left;
    padding: 8px 10px;
    background: color-mix(in oklab, #4338CA 5%, rgba(17, 24, 39, 0.04));
    color: #0e0e0c;
    font-weight: 600;
    border-bottom: 1px solid color-mix(in oklab, #4338CA 10%, rgba(17, 24, 39, 0.08));
  }
  .lc-table td {
    padding: 8px 10px;
    border-bottom: 1px solid rgba(17, 24, 39, 0.06);
    color: #1f2937;
  }
  .lc-table tr:last-child td {
    border-bottom: none;
  }
</style>
