---
import LifecycleReport, { type ReportData } from "./LifecycleReport.astro";

type Followup = { title: string; body: string };
type Stage = {
  id: string;
  label: string;
  title: string;
  body: string;
  report: ReportData;
  followups: Followup[];
};

const stages: Stage[] = [
  {
    id: "market-research",
    label: "Market Research",
    title: "Turn public filings into structured intelligence in hours.",
    body: "Pull SERFF filings, public rate manuals, and reference materials into a vault. The agent extracts factor tables, base rates, and rating algorithms into structured, queryable artifacts so your team can review filed material quickly and consistently.",
    report: {
      heading: "SERFF Filing Diff — Travelers CGL CA",
      intro: "Filed change vs the prior version. Indexed against your in-force book.",
      metrics: [
        { label: "Factors changed", value: "14" },
        { label: "Rate level", value: "+3.8%" },
        { label: "Territory moves", value: "6" },
        { label: "Filed pages", value: "87" },
      ],
      blocks: [
        {
          kind: "prose",
          title: "Material changes",
          body: "Base rate +3.8%. Six territory factors widened, with LA Basin up 6.2 points. A construction class adjustment (CCM 1.10 for ≥3-story Class B) was added.",
        },
        {
          kind: "chart",
          title: "Territory factor moves (Δ vs prior version)",
          caption: "Data source: SERFF filing TRVA-26-0411",
          bars: [
            { label: "LA Basin", value: 6.2, display: "+6.2%" },
            { label: "Bay Area", value: 4.1, display: "+4.1%" },
            { label: "Inland Empire", value: 3.8, display: "+3.8%" },
            { label: "Sacramento", value: 2.1, display: "+2.1%" },
            { label: "San Diego", value: 1.4, display: "+1.4%" },
            { label: "Central Valley", value: 0.9, display: "+0.9%" },
          ],
        },
        {
          kind: "callout",
          tone: "finding",
          title: "Finding",
          body: "Your in-force book has 38% concentration in LA Basin. At the new factor, expect a 2.4% gross rate-on-rate pickup before any UW response.",
        },
        {
          kind: "table",
          title: "Top changed factors",
          columns: ["Factor", "Prior", "Filed", "Δ"],
          rows: [
            ["Base rate", "$1,194", "$1,240", "+3.8%"],
            ["LA Basin territory", "1.31", "1.39", "+6.2%"],
            ["≥3-story CCM", "—", "1.10", "new"],
            ["Med pay limit", "$5,000", "$7,500", "+50%"],
          ],
        },
      ],
    },
    followups: [
      { title: "Summarize the ILF curve", body: "Pull the increased-limit factor table from the filing and produce a concise curve summary." },
      { title: "Jurisdiction comparison", body: "Compare base rates and territory loadings across the jurisdictions named in the filing." },
      { title: "Diff vs. prior version", body: "Compute a diff against the prior version of the filing and call out the largest factor changes." },
      { title: "Extract filing rationale", body: "Lift the actuarial memo prose and key assumptions out of the filing into a readable summary." },
      { title: "Schedule a re-run on cron", body: "Propose a routine that re-runs this scan when the carrier files an update on SERFF." },
    ],
  },
  {
    id: "loss-modeling",
    label: "Loss Modeling",
    title: "Fit factors against your book without a Python team.",
    body: "Bring your loss triangles and exposure data into the workbench. Use the assistant to fit GLM/credibility-weighted factors, profile experience by segment, and produce a defensible memo of every assumption.",
    report: {
      heading: "Severity Fit — CGL, AY 2018–2024",
      intro: "Lognormal severity fit, 12,840 claims, credibility-weighted to ISO industry prior.",
      metrics: [
        { label: "Claims used", value: "12,840" },
        { label: "E[severity]", value: "$48,217" },
        { label: "CV", value: "2.31" },
        { label: "Cred. weight", value: "0.62" },
      ],
      blocks: [
        {
          kind: "prose",
          title: "Fit quality",
          body: "Anderson-Darling p = 0.31, no tail divergence. Trimming the top three losses moves the mean by 4.2%. The ISO prior pulled credibility weight to 0.62 for the smaller class segments.",
        },
        {
          kind: "chart",
          title: "Expected severity by class ($K)",
          caption: "Data source: book_losses.cgl_2018_2024",
          bars: [
            { label: "Premises Ops", value: 31, display: "$31K" },
            { label: "Products", value: 58, display: "$58K" },
            { label: "Tools/Equip", value: 42, display: "$42K" },
            { label: "Hired Auto", value: 71, display: "$71K" },
            { label: "Property Damage", value: 26, display: "$26K" },
          ],
        },
        {
          kind: "callout",
          tone: "finding",
          title: "Selected fit",
          body: "Lognormal beats gamma by 72 AIC points. Hired Auto severity is 2.3× book mean — segment it out of the base class before reserving.",
        },
        {
          kind: "table",
          title: "Segment fit",
          columns: ["Segment", "N", "E[X]", "99th pct"],
          rows: [
            ["Premises Ops", "5,210", "$31,408", "$612K"],
            ["Products", "2,184", "$58,012", "$1.4M"],
            ["Tools/Equip", "1,890", "$42,331", "$880K"],
            ["Hired Auto", "1,672", "$71,229", "$2.1M"],
          ],
        },
      ],
    },
    followups: [
      { title: "Credibility-weight against industry", body: "Re-fit using credibility weighting against an ISO-published industry severity prior." },
      { title: "Sensitivity to large losses", body: "Run a sensitivity study trimming the top-N losses; show how the fit shifts." },
      { title: "Add actuarial memo prose", body: "Generate the actuarial-memo prose section that documents the fit selection and assumptions." },
      { title: "Slice by segment", body: "Slice the fit by the three largest class-code segments and surface differences." },
      { title: "Show fitted-constant provenance", body: "Annotate every fitted constant with the analysis run, dataset cut, and reviewer that produced it." },
    ],
  },
  {
    id: "rating-deployment",
    label: "Rating Deployment",
    title: "From Excel rater to live API, with a full audit trail.",
    body: "Shipping a rating model safely takes more work than building one. The Workbench versions every model, gates promotions through dev to test to prod, runs trauma studies before deploys, and keeps every historical version live for on-leveling.",
    report: {
      heading: "Rater Promotion — CGL v2.4 → v2.5",
      intro: "Promoting v2.5 to production. SOX-grade controls. Author, reviewer, approver separated.",
      metrics: [
        { label: "Test cases", value: "38/38" },
        { label: "Avg Δ premium", value: "+2.8%" },
        { label: "In-force re-rated", value: "14,221" },
        { label: "Outliers >10%", value: "89" },
      ],
      blocks: [
        {
          kind: "prose",
          title: "Trauma study",
          body: "Re-rated the in-force book at v2.5. 92% of policies move within ±5%. 89 outliers traced to two new schedule debits. The round-trip test suite passes against the filed rate manual.",
        },
        {
          kind: "chart",
          title: "Premium delta distribution (% of book)",
          caption: "Data source: in_force.policy as of 2026-05-01",
          bars: [
            { label: "< -10%", value: 0.6, display: "0.6%" },
            { label: "-5%", value: 12.4, display: "12.4%" },
            { label: "0%", value: 51.2, display: "51.2%" },
            { label: "+5%", value: 28.8, display: "28.8%" },
            { label: "+10%", value: 6.3, display: "6.3%" },
            { label: "> +10%", value: 0.7, display: "0.7%" },
          ],
        },
        {
          kind: "callout",
          tone: "warn",
          title: "Gate check",
          body: "89 outliers exceed the ±10% guardrail. Promotion will block until each is reviewed or the guardrail is widened with a signed override.",
        },
        {
          kind: "table",
          title: "Promotion record",
          columns: ["Step", "Identity", "Timestamp"],
          rows: [
            ["Author", "P. Yang", "May 16, 09:12"],
            ["Reviewer", "M. Reyes", "May 17, 14:33"],
            ["Approver", "F. Marotti", "May 18, 11:07"],
          ],
        },
      ],
    },
    followups: [
      { title: "Add experience modifier", body: "Add an experience modifier input and a schedule credit/debit input, with the matching premium adjustment." },
      { title: "Show territory factor table", body: "Surface the territory factor lookup table that this rater is reading from, in-place." },
      { title: "Show multiplier breakdown", body: "Add a panel that walks through every multiplier and shows the rolling premium step by step." },
      { title: "Add audit provenance panel", body: "Show the provenance citations for every constant in this rater (rate manual page, reviewer, hash)." },
      { title: "Run a trauma study", body: "Re-rate the in-force book at the proposed version and show the distribution of premium changes." },
    ],
  },
  {
    id: "underwriting",
    label: "Underwriting",
    title: "Submissions and portfolio analytics on the same rating engine.",
    body: "A submissions queue and a real-time portfolio view that share the rating models you already deployed, so a single quote and a portfolio-wide on-leveling use the exact same code path.",
    report: {
      heading: "Submission #20446 — Bind-Ready",
      intro: "Roofing contractor, $4.2M payroll, CGL + Commercial Auto. Auto-priced at CGL v2.5.",
      metrics: [
        { label: "Gross premium", value: "$48,200" },
        { label: "Quote time", value: "4 min" },
        { label: "Referral flags", value: "2" },
        { label: "Comparables", value: "87" },
      ],
      blocks: [
        {
          kind: "prose",
          title: "Referral reasons",
          body: "Two flags fired: class 91585 carries a schedule debit greater than 3, requiring an authorized signer; the named insured shares loss history with a prior bound policy.",
        },
        {
          kind: "chart",
          title: "Bind ratio — last 30 days, by class (%)",
          caption: "Data source: submissions.queue rolling 30d",
          bars: [
            { label: "Roofing", value: 38, display: "38%" },
            { label: "Painting", value: 52, display: "52%" },
            { label: "Carpentry", value: 47, display: "47%" },
            { label: "HVAC", value: 61, display: "61%" },
            { label: "Plumbing", value: 44, display: "44%" },
          ],
        },
        {
          kind: "callout",
          tone: "info",
          title: "Portfolio impact",
          body: "Binding this submission moves the Roofing concentration in LA Basin from 4.1% to 4.4%. Within the 5% segment cap set in the underwriting guideline.",
        },
        {
          kind: "table",
          title: "Comparable bound policies",
          columns: ["Insured", "Class", "Premium", "LR"],
          rows: [
            ["Acme Roofing", "91585", "$51,200", "0.42"],
            ["Pinnacle Const.", "91550", "$44,800", "0.61"],
            ["Summit Coverall", "91585", "$49,950", "0.38"],
          ],
        },
      ],
    },
    followups: [
      { title: "Add portfolio context", body: "Show how this submission would change concentration across territory and class code." },
      { title: "List referral reasons", body: "Enumerate the underwriting referral reasons triggered by this submission." },
      { title: "Show comparable bound policies", body: "Find the closest in-force policies and compare their premium and loss experience." },
      { title: "Show bind-time governance", body: "Show the rating-engine guardrails that fire at bind time so an underwriter cannot use a retired version." },
      { title: "Show integration touchpoints", body: "List the policy administration and underwriting platforms this rating engine is wired into." },
    ],
  },
  {
    id: "reserving",
    label: "Reserving",
    title: "Close the loop. Reserves and BI on the same data spine.",
    body: "Once policies, claims, and exposures live in one place, reserving and BI become a thin presentation layer. Start with chain-ladder and Bornhuetter-Ferguson dashboards driven by the same canonical data the rater uses.",
    report: {
      heading: "Chain-Ladder Triangle — CGL Q3 2026",
      intro: "Paid loss development, 8 accident years. Bornhuetter-Ferguson cross-check applied at AY7–AY8.",
      metrics: [
        { label: "AY booked", value: "8" },
        { label: "Ult. loss", value: "$128.4M" },
        { label: "IBNR", value: "$14.7M" },
        { label: "Tail factor", value: "1.022" },
      ],
      blocks: [
        {
          kind: "prose",
          title: "Development pattern",
          body: "Selected age-to-age factors stable through AY6. Sherman exponential decay applied for the tail beyond AY8. BF cross-check at AY7–AY8 within ±2.1% of chain-ladder.",
        },
        {
          kind: "chart",
          title: "Cumulative paid by AY ($M)",
          caption: "Data source: claims.paid_cumulative as of 2026-09-30",
          bars: [
            { label: "AY 2019", value: 18.2, display: "$18.2M" },
            { label: "AY 2020", value: 17.5, display: "$17.5M" },
            { label: "AY 2021", value: 16.8, display: "$16.8M" },
            { label: "AY 2022", value: 14.9, display: "$14.9M" },
            { label: "AY 2023", value: 12.1, display: "$12.1M" },
            { label: "AY 2024", value: 8.4, display: "$8.4M" },
            { label: "AY 2025", value: 4.7, display: "$4.7M" },
            { label: "AY 2026", value: 1.2, display: "$1.2M" },
          ],
        },
        {
          kind: "callout",
          tone: "finding",
          title: "Cross-check",
          body: "BF reserve estimate $129.6M vs chain-ladder $128.4M, gap 0.9%. Recommend chain-ladder selected; BF as documented sensitivity.",
        },
        {
          kind: "table",
          title: "Development factors",
          columns: ["Age (mo)", "ATA", "Selected"],
          rows: [
            ["12–24", "1.418", "1.420"],
            ["24–36", "1.182", "1.180"],
            ["36–48", "1.091", "1.090"],
            ["48–60", "1.048", "1.050"],
          ],
        },
      ],
    },
    followups: [
      { title: "Switch to Bornhuetter-Ferguson", body: "Re-run reserves under Bornhuetter-Ferguson with an a-priori loss ratio." },
      { title: "Add tail factor analysis", body: "Fit a tail factor beyond the latest observed development period." },
      { title: "Slice by segment", body: "Slice reserves by hazard group and surface differences." },
      { title: "Add BI dashboards", body: "Add the standard BI roll-ups (loss ratio by segment, retention, growth) on the same data spine." },
    ],
  },
  {
    id: "misc",
    label: "Capital + Re + Captives",
    title: "Capital modeling, reinsurance program design, and captive analytics on the same spine.",
    body: "The same exposures and loss data that drive pricing and reserving also drive capital, reinsurance program design, and captive structuring. Run portfolio-level analytics without a separate data pipeline.",
    report: {
      heading: "1-in-200 Capital Stress — CGL",
      intro: "Catastrophe scenario applied. Current program: 80% quota share + $5M xs $5M XOL.",
      metrics: [
        { label: "Gross loss", value: "$42.1M" },
        { label: "Net loss", value: "$9.4M" },
        { label: "Capital used", value: "38%" },
        { label: "RAROC", value: "11.2%" },
      ],
      blocks: [
        {
          kind: "prose",
          title: "Net loss profile",
          body: "Gross 1-in-200 loss of $42.1M reduces to $9.4M net of the current program. Reinsurance recoveries $32.7M. RAROC stays above the 10% target.",
        },
        {
          kind: "chart",
          title: "Net loss by alternative structure ($M)",
          caption: "Data source: cap_model.scenarios.cat_200",
          bars: [
            { label: "Current", value: 9.4, display: "$9.4M" },
            { label: "70% QS only", value: 12.6, display: "$12.6M" },
            { label: "+ $5M xs $10M", value: 7.8, display: "$7.8M" },
            { label: "Stop-Loss 75%", value: 8.9, display: "$8.9M" },
          ],
        },
        {
          kind: "callout",
          tone: "finding",
          title: "Recommendation",
          body: "Adding a $5M xs $10M XOL layer cuts net loss to $7.8M and lifts RAROC to 11.9%. Cession cost estimated at $1.8M annually.",
        },
        {
          kind: "table",
          title: "Structure compare",
          columns: ["Structure", "Net Loss", "RAROC"],
          rows: [
            ["Current (80% QS + $5M xs $5M)", "$9.4M", "11.2%"],
            ["70% QS only", "$12.6M", "9.8%"],
            ["+ $5M xs $10M layer", "$7.8M", "11.9%"],
          ],
        },
      ],
    },
    followups: [
      { title: "Run a 1-in-200 cat stress", body: "Apply the catastrophe stress scenario from the scenario library and re-score capital and reinsurance." },
      { title: "Compare an alternative structure", body: "Score an alternative reinsurance structure side-by-side against the current program." },
      { title: "Captive funding study", body: "Produce a funding study for the GL captive cell at three confidence levels." },
    ],
  },
];
---

<section id="lifecycle" class="border-y border-[var(--rule)] bg-[var(--bg)] scroll-mt-24">
  <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
    <div class="grid md:grid-cols-12 gap-8 mb-10">
      <div class="md:col-span-5 reveal">
        <p class="eyebrow mb-3">The lifecycle</p>
        <h2 class="font-semibold text-[2rem] md:text-[2.25rem] leading-[1.1] tracking-[-0.015em]">
          The carrier product lifecycle, on one workbench.
        </h2>
      </div>
      <p class="md:col-span-7 reveal text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)] mt-2" data-reveal-delay="120">
        From filings intake to bound policy to reserved triangle, the work shares one data spine and one audit trail. The handoffs between actuarial, pricing, and underwriting stay lossless.
      </p>
    </div>

    {/* Tab strip */}
    <div class="lifecycle-tabs reveal" role="tablist" aria-label="Carrier product lifecycle">
      {stages.map((s, i) => (
        <button
          type="button"
          role="tab"
          id={`lc-tab-${s.id}`}
          aria-controls={`lc-panel-${s.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          data-stage={s.id}
          class:list={["lifecycle-tab", i === 0 && "is-active"]}
        >
          <span class="lifecycle-tab__num">{String(i + 1).padStart(2, "0")}</span>
          <span class="lifecycle-tab__label">{s.label}</span>
        </button>
      ))}
    </div>

    {/* Panels */}
    <div class="mt-8 reveal" data-reveal-delay="120">
      {stages.map((s, i) => (
        <div
          role="tabpanel"
          id={`lc-panel-${s.id}`}
          aria-labelledby={`lc-tab-${s.id}`}
          data-stage-panel={s.id}
          class:list={["lifecycle-panel", i !== 0 && "is-hidden"]}
        >
          <div class="grid md:grid-cols-12 gap-8 md:gap-10 items-start">
            <div class="md:col-span-5">
              <h3 class="font-semibold text-[1.5rem] md:text-[1.625rem] leading-[1.2] tracking-[-0.008em]">
                {s.title}
              </h3>
              <p class="mt-4 text-[1rem] leading-[1.6] text-[var(--fg-muted)]">
                {s.body}
              </p>
              <p class="lifecycle-followup__eyebrow mt-8">Ask a follow-up</p>
              <ul class="lifecycle-followup__list">
                {s.followups.map((f) => (
                  <li class="lifecycle-followup">
                    <p class="lifecycle-followup__title">{f.title}</p>
                    <p class="lifecycle-followup__body">{f.body}</p>
                  </li>
                ))}
              </ul>
            </div>
            <div class="md:col-span-7">
              <figure class="lifecycle-mockup">
                <LifecycleReport report={s.report} />
              </figure>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .lifecycle-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 12px;
  }
  .lifecycle-tab {
    --lc-accent: #4338CA;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: 999px;
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--fg);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    cursor: pointer;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
  }
  .lifecycle-tab:hover {
    border-color: color-mix(in oklab, var(--lc-accent) 50%, transparent);
    color: var(--lc-accent);
  }
  .lifecycle-tab.is-active {
    background: color-mix(in oklab, var(--lc-accent) 8%, transparent);
    border-color: color-mix(in oklab, var(--lc-accent) 55%, transparent);
    color: var(--lc-accent);
  }
  .lifecycle-tab__num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: color-mix(in oklab, var(--lc-accent) 80%, var(--fg-muted));
    font-weight: 600;
  }
  .lifecycle-tab.is-active .lifecycle-tab__num {
    color: var(--lc-accent);
  }

  .lifecycle-panel.is-hidden {
    display: none;
  }

  .lifecycle-followup__eyebrow {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in oklab, #4338CA 70%, var(--fg-muted));
    margin-bottom: 12px;
  }
  .lifecycle-followup__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .lifecycle-mockup {
    --lc-accent: #4338CA;
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid color-mix(in oklab, var(--lc-accent) 18%, rgba(14, 14, 12, 0.08));
    box-shadow:
      0 1px 0 rgba(14, 14, 12, 0.04),
      0 24px 60px -34px color-mix(in oklab, var(--lc-accent) 40%, rgba(14, 14, 12, 0.18));
  }
  .lifecycle-followup {
    --lc-accent: #4338CA;
    border: 1px solid color-mix(in oklab, var(--lc-accent) 14%, rgba(14, 14, 12, 0.08));
    background: #ffffff;
    border-radius: 10px;
    padding: 12px 14px;
    color: var(--color-ink, #0e0e0c);
    box-shadow:
      0 1px 0 rgba(14, 14, 12, 0.02),
      0 10px 28px -24px color-mix(in oklab, var(--lc-accent) 36%, rgba(14, 14, 12, 0.18));
  }
  [data-theme="dark"] .lifecycle-followup {
    background: rgba(250, 247, 240, 0.03);
    border-color: color-mix(in oklab, var(--lc-accent) 24%, rgba(250, 247, 240, 0.12));
    color: var(--color-bone);
  }
  .lifecycle-followup__title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: var(--color-ink, #0e0e0c);
  }
  [data-theme="dark"] .lifecycle-followup__title {
    color: var(--color-bone);
  }
  .lifecycle-followup__body {
    margin-top: 4px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-smoke, #6b6760);
  }
  [data-theme="dark"] .lifecycle-followup__body {
    color: rgba(250, 247, 240, 0.72);
  }
</style>

<script is:inline>
  (function () {
    const tabs = document.querySelectorAll(".lifecycle-tab");
    const panels = document.querySelectorAll("[data-stage-panel]");
    if (!tabs.length) return;
    const validStages = new Set(Array.from(tabs).map(function (t) { return t.getAttribute("data-stage"); }));
    function selectStage(stage) {
      if (!validStages.has(stage)) return false;
      tabs.forEach(function (x) {
        const active = x.getAttribute("data-stage") === stage;
        x.classList.toggle("is-active", active);
        x.setAttribute("aria-selected", active ? "true" : "false");
      });
      panels.forEach(function (p) {
        p.classList.toggle("is-hidden", p.getAttribute("data-stage-panel") !== stage);
      });
      return true;
    }
    tabs.forEach(function (t) {
      t.addEventListener("click", function () { selectStage(t.getAttribute("data-stage")); });
    });
    function syncFromHash() {
      const hash = (window.location.hash || "").replace(/^#/, "");
      if (selectStage(hash)) {
        const section = document.getElementById("lifecycle");
        if (section) section.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }
    syncFromHash();
    window.addEventListener("hashchange", syncFromHash);
  })();
</script>
