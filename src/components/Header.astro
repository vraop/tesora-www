---
import { u } from "../lib/url";

export interface Props {
  variant?: "light" | "transparent";
}
const { variant = "light" } = Astro.props;

const primaryNav = [
  { label: "Agents", href: u("/agents") },
  { label: "Customers", href: u("/customers") },
];

const companyNav = [
  { label: "Careers", href: u("/careers") },
  { label: "Security", href: u("/security") },
  { label: "Media", href: u("/media") },
  { label: "About", href: u("/about") },
];

const positionClass =
  variant === "transparent"
    ? "absolute top-0 left-0 right-0"
    : "sticky top-0";
const bgClass =
  variant === "transparent"
    ? "bg-transparent"
    : "backdrop-blur-sm bg-[var(--bg)]/85 border-b border-[var(--rule)]";
const textClass =
  variant === "transparent" ? "text-[var(--color-bone)]" : "text-[var(--fg)]";
const ctaClass =
  variant === "transparent"
    ? "border border-[var(--color-bone)]/40 text-[var(--color-bone)] hover:bg-[var(--color-bone)] hover:text-[var(--color-ink)] px-4 py-2 text-sm transition-colors"
    : "btn !py-2 !px-4";
const toggleClass =
  variant === "transparent"
    ? "text-[var(--color-bone)] hover:opacity-75"
    : "text-[var(--fg)] hover:opacity-75";
const panelBgClass =
  variant === "transparent"
    ? "bg-[var(--color-ink)]/95 border border-[var(--color-bone)]/15"
    : "bg-[var(--bg)] border border-[var(--rule)]";
const panelTextClass =
  variant === "transparent" ? "text-[var(--color-bone)]" : "text-[var(--fg)]";
---

<header class={`${positionClass} z-50 ${bgClass}`}>
  <div class={`mx-auto max-w-[1180px] px-6 md:px-10 py-5 flex justify-between items-center text-sm ${textClass}`}>
    <a href={u("/")} class="font-semibold text-base tracking-tight">Tesora</a>

    <nav class="hidden md:flex items-center gap-8">
      {primaryNav.map((item) => (
        <a href={item.href} class="hover:text-[var(--color-oxblood)] transition-colors">
          {item.label}
        </a>
      ))}
      <div class="relative" data-company-menu>
        <button
          type="button"
          class="inline-flex items-center gap-1 hover:text-[var(--color-oxblood)] transition-colors"
          aria-haspopup="true"
          aria-expanded="false"
          data-company-toggle
        >
          Company
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <polyline points="2,4 5,7 8,4" />
          </svg>
        </button>
        <div
          class={`absolute right-0 top-full mt-3 min-w-[180px] py-2 ${panelBgClass} ${panelTextClass} shadow-lg hidden`}
          data-company-panel
        >
          {companyNav.map((item) => (
            <a
              href={item.href}
              class="block px-4 py-2 text-sm hover:text-[var(--color-oxblood)] transition-colors"
            >
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <div class="flex items-center gap-3">
      <a href="mailto:founders@tesora.ai?subject=Tesora%20intro" class={`hidden sm:inline-flex ${ctaClass}`}>
        Talk to Tesora
      </a>
      <button
        type="button"
        id="mobile-nav-toggle"
        class={`md:hidden inline-flex items-center justify-center p-2 ${toggleClass}`}
        aria-label="Open menu"
        aria-controls="mobile-nav-panel"
        aria-expanded="false"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav-panel"
    class="md:hidden hidden border-t border-[var(--rule)] bg-[var(--bg)]"
  >
    <nav class="mx-auto max-w-[1180px] px-6 py-4 flex flex-col gap-1 text-base">
      {primaryNav.map((item) => (
        <a
          href={item.href}
          class="block py-2 text-[var(--fg)] hover:text-[var(--color-oxblood)] transition-colors"
        >
          {item.label}
        </a>
      ))}
      <p class="mt-3 text-xs uppercase tracking-[0.18em] text-[var(--fg-muted)]">Company</p>
      {companyNav.map((item) => (
        <a
          href={item.href}
          class="block py-2 text-[var(--fg)] hover:text-[var(--color-oxblood)] transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a
        href="mailto:founders@tesora.ai?subject=Tesora%20intro"
        class="block py-2 mt-3 text-[var(--color-oxblood)] font-medium"
      >
        Talk to Tesora →
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-nav-toggle");
  const panel = document.getElementById("mobile-nav-panel");
  if (btn && panel) {
    btn.addEventListener("click", () => {
      const open = panel.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    });
  }

  const companyMenus = document.querySelectorAll<HTMLElement>("[data-company-menu]");
  companyMenus.forEach((menu) => {
    const toggle = menu.querySelector<HTMLButtonElement>("[data-company-toggle]");
    const dropdown = menu.querySelector<HTMLElement>("[data-company-panel]");
    if (!toggle || !dropdown) return;

    const open = () => {
      dropdown.classList.remove("hidden");
      toggle.setAttribute("aria-expanded", "true");
    };
    const close = () => {
      dropdown.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
    };

    menu.addEventListener("mouseenter", open);
    menu.addEventListener("mouseleave", close);
    toggle.addEventListener("click", (e) => {
      e.preventDefault();
      dropdown.classList.contains("hidden") ? open() : close();
    });
    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target as Node)) close();
    });
  });
</script>
