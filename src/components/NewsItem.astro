---
import { u } from "../lib/url";

export interface Props {
  date: string;
  headline: string;
  body: string;
  link?: { label: string; href: string };
  logo?: { slug: string; ext?: string; alt: string };
}

const { date, headline, body, link, logo } = Astro.props;
const logoExt = logo?.ext ?? "svg";
---

<article class="grid md:grid-cols-12 gap-4 md:gap-10 py-8 border-t border-[var(--rule)] first:border-t-0">
  <div class="md:col-span-3">
    <p class="eyebrow tabular" style="font-family: var(--font-mono);">{date}</p>
    {logo && (
      <img
        src={u(`/logos/${logo.slug}.${logoExt}`)}
        alt={logo.alt}
        class="mt-3 h-5 w-auto opacity-70"
        style="filter: var(--logo-filter);"
        loading="lazy"
      />
    )}
  </div>
  <div class="md:col-span-9">
    <h3 class="font-semibold text-[1.25rem] leading-[1.25] tracking-[-0.005em]">{headline}</h3>
    <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{body}</p>
    {link && (
      <p class="mt-3">
        <a href={link.href} class="link text-sm">{link.label} →</a>
      </p>
    )}
  </div>
</article>
