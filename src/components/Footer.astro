---
import { u } from "../lib/url";

const investors = [
  { name: "Foundation Capital", logo: u("/logos/foundation-capital.svg"), tag: "Seed (2026)" },
  { name: "Y Combinator", logo: u("/logos/y-combinator.svg"), tag: "Batch S25" },
];

const footerNav = [
  { label: "Agents", href: u("/agents") },
  { label: "Customers", href: u("/customers") },
  { label: "Students", href: u("/students") },
  { label: "Team & writing", href: u("/media") },
  { label: "News", href: u("/news") },
  { label: "Careers", href: u("/careers") },
  { label: "Security", href: u("/security") },
];
---

<footer class="border-t border-[var(--rule)] mt-32">
  <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
    <div class="grid md:grid-cols-12 gap-10 items-start">
      <div class="md:col-span-5">
        <p class="text-base font-semibold tracking-tight text-[var(--fg)]">Tesora</p>
        <p class="mt-3 text-sm text-[var(--fg-muted)] max-w-[360px] leading-relaxed">
          Frontier AI for actuaries. Built for chief actuaries at specialty P&amp;C carriers and MGAs.
        </p>
        <p class="mt-6 text-sm text-[var(--fg-muted)]">
          <a href="mailto:founders@tesora.ai" class="link">founders@tesora.ai</a>
        </p>
      </div>

      <div class="md:col-span-4">
        <p class="eyebrow mb-4">Backed by</p>
        <ul class="flex flex-col gap-4">
          {investors.map((inv) => (
            <li class="flex items-center gap-4">
              <img
                src={inv.logo}
                alt={inv.name}
                class="h-7 w-7 rounded-full object-contain"
                style="filter: var(--logo-filter);"
                loading="lazy"
                decoding="async"
              />
              <div class="flex flex-col leading-tight">
                <span class="text-sm font-semibold text-[var(--fg)]">{inv.name}</span>
                <span class="text-xs text-[var(--fg-muted)]">{inv.tag}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-3">
        <p class="eyebrow mb-4">Site</p>
        <ul class="grid grid-cols-2 gap-y-2 text-sm">
          {footerNav.map((item) => (
            <li>
              <a href={item.href} class="text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-[var(--rule)] flex flex-col md:flex-row justify-between gap-3 text-xs text-[var(--fg-muted)]">
      <p>© {new Date().getFullYear()} Tesora AI · Made in USA · HQ: NY &amp; SF · YC Batch S25</p>
      <p>
        <a href={u("/llms.txt")} class="hover:text-[var(--fg)]">llms.txt</a>
      </p>
    </div>
  </div>
</footer>
