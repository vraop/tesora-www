---
const backgrounds = [
  { slug: "genre", label: "Gen Re", ext: "svg" },
  { slug: "wrberkley", label: "W.R. Berkley", ext: "svg" },
  { slug: "hereford", label: "Hereford", ext: "png" },
  { slug: "mckinsey", label: "McKinsey", ext: "svg" },
  { slug: "sycamore", label: "Sycamore Partners", ext: "svg" },
  { slug: "kumo", label: "Kumo", ext: "svg" },
  { slug: "google", label: "Google", ext: "svg" },
];

const doubled = [...backgrounds, ...backgrounds];
---

<section class="border-t border-b border-[var(--rule)] bg-[var(--bg)]">
  <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-10">
    <p class="eyebrow text-center mb-6">The team comes from</p>
    <div class="bg-strip-mask">
      <div class="bg-strip-track">
        {doubled.map((b) => (
          <img
            src={`/logos/${b.slug}.${b.ext}`}
            alt={b.label}
            class="bg-strip-mark"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .bg-strip-mask {
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 8%,
      black 92%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 8%,
      black 92%,
      transparent 100%
    );
  }

  .bg-strip-track {
    display: flex;
    gap: 4rem;
    width: max-content;
    animation: bg-strip-scroll 40s linear infinite;
    align-items: center;
  }

  .bg-strip-track:hover {
    animation-play-state: paused;
  }

  .bg-strip-mark {
    height: 28px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    filter: grayscale(1) brightness(0.45);
    opacity: 0.78;
    transition: opacity 200ms ease, filter 200ms ease;
  }

  .bg-strip-mark:hover {
    opacity: 1;
    filter: grayscale(0) brightness(1);
  }

  @keyframes bg-strip-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-strip-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem 3rem;
    }
  }
</style>
