---
import { u } from "../lib/url";

// Heights tuned per-logo so each wordmark sits visually balanced
// (some marks have ascenders/descenders or thinner strokes).
// Only places the founding team actually came from. Carrier logos belong to
// the carriers; they are not sponsors and do not want to be cited here.
const backgrounds = [
  { slug: "stanford", label: "Stanford", ext: "svg", h: 26 },
  { slug: "mckinsey", label: "McKinsey & Company", ext: "svg", h: 22 },
  { slug: "kumo", label: "Kumo · Predictive AI Labs", ext: "svg", h: 24 },
  { slug: "sycamore", label: "Sycamore Partners", ext: "svg", h: 22 },
];

const doubled = [...backgrounds, ...backgrounds];
---

<section class="border-t border-b border-[var(--rule)] bg-[var(--bg)]">
  <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-10">
    <div class="bg-strip-mask">
      <div class="bg-strip-track">
        {doubled.map((b) => (
          <div class="bg-strip-cell">
            <img
              src={u(`/logos/${b.slug}.${b.ext}`)}
              alt={b.label}
              class="bg-strip-mark"
              style={`height: ${b.h}px;`}
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .bg-strip-mask {
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 8%,
      black 92%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 8%,
      black 92%,
      transparent 100%
    );
  }

  .bg-strip-track {
    display: flex;
    width: max-content;
    animation: bg-strip-scroll 40s linear infinite;
    align-items: center;
  }

  .bg-strip-track:hover {
    animation-play-state: paused;
  }

  .bg-strip-cell {
    width: 220px;
    flex: 0 0 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.25rem;
  }

  .bg-strip-mark {
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: var(--logo-filter);
    opacity: 0.72;
    transition: opacity 220ms ease, filter 220ms ease;
  }

  .bg-strip-cell:hover .bg-strip-mark {
    opacity: 1;
    filter: grayscale(0) brightness(1);
  }

  @keyframes bg-strip-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-strip-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
    }
    .bg-strip-cell {
      width: auto;
      flex: 0 0 auto;
      padding: 0.75rem 1.5rem;
    }
  }
</style>
