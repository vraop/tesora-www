---
import "../styles/global.css";
import SEO from "../components/SEO.astro";

export interface Props {
  title: string;
  description: string;
  canonical: string;
  schemaType?: "WebPage" | "Article" | "Product" | "FAQPage";
  publishedAt?: string;
  updatedAt?: string;
  schema?: Record<string, unknown>;
  ogImage?: string;
  noindex?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Tesora AI" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {/* llms.txt discovery hint — not a standard yet, but search starting to index it */}
    <link rel="alternate" type="text/plain" title="LLM-friendly summary" href="/llms.txt" />

    {/* Fonts: Inter Tight (everything), JetBrains Mono (code/data only).
        Source Serif 4 loaded only on long-form routes that opt in. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,400..700;1,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <SEO {...props} />
  </head>
  <body class="min-h-screen antialiased">
    <slot />
  </body>
</html>
