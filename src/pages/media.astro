---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import { u } from "../lib/url";

const team = [
  {
    name: "Vivek Rao",
    role: "CEO",
    body: "Vivek is co-founder and CEO of Tesora. Previously at McKinsey and as a private-equity investor focused on insurance.",
    affiliations: [{ slug: "mckinsey", alt: "McKinsey & Company" }],
  },
  {
    name: "Federico Reyes Gomez",
    role: "CTO",
    body: "Federico is co-founder and CTO of Tesora. Previously led ML research on graph neural networks for relational and tabular data at Kumo Labs and Stanford.",
    affiliations: [
      { slug: "kumo", alt: "Kumo Labs" },
      { slug: "stanford", alt: "Stanford" },
    ],
  },
  {
    name: "Philo Bishay",
    role: "Chief Product Officer",
    body: "Philo is Chief Product Officer at Tesora. Previously a chief actuary with fifteen years in specialty P&C pricing. FCAS.",
    affiliations: [],
  },
];

// Single blog feed — announcements + posts, newest first.
const blog = [
  {
    date: "2026 · OCT (FORTHCOMING)",
    kind: "post",
    title: "The chief actuary's case for AI agents.",
    authors: "Philo Bishay, Vivek Rao",
    body: "What changes when a credentialed actuary works alongside a credentialed agent. Working draft for the CAS Annual Meeting panel.",
  },
  {
    date: "2026 · MAY",
    kind: "news",
    title: "Philo Bishay joins Tesora as Chief Product Officer.",
    body: "Philo, a former chief actuary with fifteen years inside the rating function, joins to lead product.",
  },
  {
    date: "2026 · APR",
    kind: "post",
    title: "The substrate thesis: why insurance is next.",
    authors: "Vivek Rao",
    body: "Software had a substrate. Law is getting one. Insurance is next. The case for a typed, lineage-bearing graph underneath rating, and why context is the thing that compounds.",
    href: "https://tesoraai.substack.com/",
  },
  {
    date: "2026 · APR",
    kind: "post",
    title: "Schedule rating without the vibes.",
    authors: "Philo Bishay, Vivek Rao",
    body: "Schedule rating is where pricing discipline goes to die. A transparent credit framework grounded in the carrier's own loss data, with every adjustment auditable.",
    href: "https://tesoraai.substack.com/",
  },
  {
    date: "2026 · MAR",
    kind: "post",
    title: "Exposure-base leakage in contractor's GL.",
    authors: "Philo Bishay",
    body: "Three to five points of loss-ratio leakage in contractor's GL isn't social inflation. It's exposure bases captured wrong on day one.",
    href: "https://tesoraai.substack.com/",
  },
  {
    date: "2026 · MAR",
    kind: "post",
    title: "Reconstructing a state filing in ten minutes.",
    authors: "Vivek Rao",
    body: "Walkthrough of how the Workbench reads three SERFF filings and yields a working rater with side-by-side regression tests against the original filings.",
    href: "https://tesoraai.substack.com/",
  },
  {
    date: "2025 · OCT",
    kind: "news",
    title: "Top startup award finalist at DPW Amsterdam 2025.",
    body: "Tesora was a top startup award finalist at DPW Amsterdam 2025.",
    logo: { slug: "dpw", alt: "DPW Amsterdam" },
  },
  {
    date: "2025 · SEP",
    kind: "news",
    title: "Tesora completes Y Combinator S25.",
    body: "Tesora completed the Y Combinator Summer 2025 cohort focused on AI-native applications for regulated industries.",
    logo: { slug: "y-combinator", alt: "Y Combinator S25" },
  },
];

const federicoWork = [
  {
    title: "Relational deep learning for enterprise data.",
    venue: "Stanford / Kumo Labs · 2024",
    body: "Graph neural networks operating directly on relational tables. The prior research that underpins the substrate Tesora uses to hold filings, raters, exposures, and quotes as one typed graph.",
    href: "https://relbench.stanford.edu",
    logos: [
      { slug: "stanford", alt: "Stanford" },
      { slug: "kumo", alt: "Kumo Labs" },
    ],
  },
  {
    title: "Learned ontologies for heterogeneous tabular sources.",
    venue: "Working note · 2025",
    body: "How Tesora reconciles SERFF fields, ISO field codes, and carrier-internal schemas without a hand-written mapping layer. The technique generalizes from raters to submissions to portfolio.",
    logos: [],
  },
];
---

<Layout
  title="Media · Tesora"
  description="Tesora pairs relational-AI research on the engineering side, former chief-actuary depth on the practice side, and McKinsey and private-equity insurance experience on the customer side. Backed by Foundation Capital and Y Combinator."
  canonical="/media"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/research-loop.mp4")}
    headline="The team, the writing, the record."
    deck="Researchers and operators from Stanford, Kumo Labs, McKinsey, and the rating function inside specialty P&C carriers."
    primaryCta={{ label: "Read on Substack", href: "https://tesoraai.substack.com/" }}
    secondaryCta={{ label: "Email the team", href: "mailto:founders@tesora.ai" }}
  />

  {/* Team */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-24" id="team">
    <p class="eyebrow mb-8">Team</p>
    {team.map((m) => (
      <article class="grid md:grid-cols-12 gap-6 md:gap-10 py-10 border-t border-[var(--rule)] first:border-t-0">
        <div class="md:col-span-4">
          <h3 class="font-semibold text-[1.5rem] leading-[1.2] tracking-[-0.008em]">{m.name}</h3>
          <p class="mt-2 text-sm text-[var(--fg-muted)]">{m.role}</p>
          {m.affiliations.length > 0 && (
            <div class="mt-4 flex items-center gap-4">
              {m.affiliations.map((a) => (
                <img
                  src={u(`/logos/${a.slug}.svg`)}
                  alt={a.alt}
                  class="h-4 w-auto opacity-60"
                  style="filter: var(--logo-filter);"
                  loading="lazy"
                />
              ))}
            </div>
          )}
        </div>
        <div class="md:col-span-8">
          <p class="text-[1.0625rem] leading-[1.65] text-[var(--fg)]">{m.body}</p>
        </div>
      </article>
    ))}
  </section>

  {/* Investors */}
  <section class="bg-[var(--bg-panel)] border-y border-[var(--rule)]" id="investors">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">Investors</p>
          <h2 class="font-semibold text-[2rem] leading-[1.15] tracking-[-0.012em]">
            Foundation Capital. Y Combinator S25.
          </h2>
        </div>
        <div class="md:col-span-7">
          <p class="text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
            Foundation Capital led our seed in early 2026. Y Combinator backed us in the S25 cohort focused on AI-native applications for regulated industries.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Blog — news + writing in one feed */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-24" id="blog">
    <div class="grid md:grid-cols-12 gap-10 mb-12">
      <div class="md:col-span-4">
        <p class="eyebrow mb-3">Blog</p>
        <h2 class="font-semibold text-[2rem] leading-[1.15] tracking-[-0.012em]">
          Notes and announcements.
        </h2>
      </div>
      <p class="md:col-span-8 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)] mt-2">
        Short pieces from the people building Tesora, mixed in with company news. Newest first.
      </p>
    </div>

    <div>
      {blog.map((p) => (
        <article class="grid md:grid-cols-12 gap-6 md:gap-10 py-8 border-t border-[var(--rule)] first:border-t-0">
          <div class="md:col-span-3">
            <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{p.date}</p>
            <p class="mt-2 text-[0.8125rem] text-[var(--fg-muted)]">
              {p.kind === "news" ? "Tesora" : p.authors}
            </p>
            {p.logo && (
              <img
                src={u(`/logos/${p.logo.slug}.svg`)}
                alt={p.logo.alt}
                class="mt-3 h-4 w-auto opacity-60"
                style="filter: var(--logo-filter);"
                loading="lazy"
              />
            )}
          </div>
          <div class="md:col-span-9">
            <h3 class="font-semibold text-[1.25rem] leading-[1.25] tracking-[-0.005em]">{p.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{p.body}</p>
            {p.href && (
              <p class="mt-3">
                <a href={p.href} class="link text-sm" target="_blank" rel="noopener">Read on Substack →</a>
              </p>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  {/* Federico's prior research — kept distinct */}
  <section class="bg-[var(--bg-panel)] border-y border-[var(--rule)]" id="prior-research">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
      <div class="grid md:grid-cols-12 gap-10 mb-10">
        <div class="md:col-span-4">
          <p class="eyebrow mb-3">Prior research</p>
          <h2 class="font-semibold text-[1.875rem] leading-[1.15] tracking-[-0.012em]">
            Federico Reyes Gomez
          </h2>
          <p class="text-sm text-[var(--fg-muted)] mt-2">Co-founder &amp; CTO</p>
        </div>
        <p class="md:col-span-8 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)] mt-2">
          Federico's prior published work on graph neural networks for relational and tabular data is the technical foundation underneath Tesora's substrate. Kept distinct because the research predates the company and lives in academic venues under his name.
        </p>
      </div>
      <div>
        {federicoWork.map((w) => (
          <article class="border-t border-[var(--rule)] py-8 first:border-t-0">
            <div class="flex items-center gap-4 flex-wrap">
              <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{w.venue}</p>
              {w.logos && w.logos.length > 0 && (
                <div class="flex items-center gap-3">
                  {w.logos.map((l) => (
                    <img
                      src={u(`/logos/${l.slug}.svg`)}
                      alt={l.alt}
                      class="h-4 w-auto opacity-60"
                      style="filter: var(--logo-filter);"
                      loading="lazy"
                    />
                  ))}
                </div>
              )}
            </div>
            <h3 class="mt-2 font-semibold text-[1.25rem] leading-[1.25] tracking-[-0.005em]">{w.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{w.body}</p>
            {w.href && (
              <p class="mt-3">
                <a href={w.href} class="link text-sm" target="_blank" rel="noopener">Read →</a>
              </p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
