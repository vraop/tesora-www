---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import { u } from "../lib/url";

const priorResearch = [
  {
    title: "Relational deep learning for enterprise data.",
    venue: "Stanford / Kumo Labs · 2024",
    body: "Graph neural networks operating directly on relational tables. The prior research that underpins the substrate Tesora uses to hold filings, raters, exposures, and quotes as one typed graph.",
    href: "https://relbench.stanford.edu",
    logos: [
      { slug: "stanford", alt: "Stanford" },
      { slug: "kumo", alt: "Kumo Labs" },
    ],
  },
  {
    title: "Learned ontologies for heterogeneous tabular sources.",
    venue: "Working note · 2025",
    body: "Reconciling SERFF fields, ISO field codes, and carrier-internal schemas without a hand-written mapping layer. The technique generalizes from raters to submissions to portfolio.",
    logos: [],
  },
];
---

<Layout
  title="Media · Tesora"
  description="Notes, announcements, and prior research from Tesora. Backed by Foundation Capital and Y Combinator."
  canonical="/media"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/research-loop.mp4")}
    headline="Notes, announcements, and prior research."
    deck="Short pieces on specialty P&C pricing, the substrate thesis, and the rating function — mixed in with company news."
    primaryCta={{ label: "Read on Substack", href: "https://tesoraai.substack.com/" }}
    secondaryCta={{ label: "Email us", href: "mailto:founders@tesora.ai" }}
  />

  {/* Investors */}
  <section class="bg-[var(--bg-panel)] border-y border-[var(--rule)]" id="investors">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20">
      <div class="grid md:grid-cols-12 gap-10 mb-12">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">Investors</p>
          <h2 class="font-semibold text-[2rem] leading-[1.15] tracking-[-0.012em]">
            Backed by the people who fund regulated-industry AI.
          </h2>
        </div>
        <div class="md:col-span-7">
          <p class="text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
            Foundation Capital leads our financing. Y Combinator backed us in the S25 cohort focused on AI-native applications for regulated industries. Z47 (formerly Matrix Partners) and DeVC joined as co-investors.
          </p>
          <p class="mt-5 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
            We're backed by leading AI investors with over $3.5M of initial funding. After completing Y Combinator, we kept building against a contrarian view: the most valuable AI will be opinionated to its users, not broad generalized agents and LLMs. Specific evals and systems will let it outperform on domain-specific tasks. We chose to focus in on pricing risk, handling filings, and being auditable for regulatory court. We started where the rest of the market chose to stop.
          </p>
        </div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-10 items-center">
        {[
          { slug: "foundation-capital", alt: "Foundation Capital", h: 28 },
          { slug: "y-combinator", alt: "Y Combinator S25", h: 28 },
          { slug: "z47", alt: "Z47 (fka Matrix Partners)", h: 28 },
          { slug: "devc", alt: "DeVC", h: 28 },
        ].map((inv) => (
          <div class="flex items-center justify-center py-2">
            <img
              src={u(`/logos/${inv.slug}.svg`)}
              alt={inv.alt}
              style={`height: ${inv.h}px; filter: var(--logo-filter);`}
              class="w-auto opacity-70 hover:opacity-100 transition-opacity"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Prior research */}
  <section class="bg-[var(--bg-panel)] border-y border-[var(--rule)]" id="prior-research">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
      <div class="grid md:grid-cols-12 gap-10 mb-10">
        <div class="md:col-span-4">
          <p class="eyebrow mb-3">Prior research</p>
          <h2 class="font-semibold text-[1.875rem] leading-[1.15] tracking-[-0.012em]">
            The research under the substrate.
          </h2>
        </div>
        <p class="md:col-span-8 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)] mt-2">
          The technical foundation underneath Tesora's substrate — published work on graph neural networks for relational and tabular data, kept distinct because it predates the company and lives in academic venues.
        </p>
      </div>
      <div>
        {priorResearch.map((w) => (
          <article class="border-t border-[var(--rule)] py-8 first:border-t-0">
            <div class="flex items-center gap-4 flex-wrap">
              <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{w.venue}</p>
              {w.logos && w.logos.length > 0 && (
                <div class="flex items-center gap-3">
                  {w.logos.map((l) => (
                    <img
                      src={u(`/logos/${l.slug}.svg`)}
                      alt={l.alt}
                      class="h-4 w-auto opacity-60"
                      style="filter: var(--logo-filter);"
                      loading="lazy"
                    />
                  ))}
                </div>
              )}
            </div>
            <h3 class="mt-2 font-semibold text-[1.25rem] leading-[1.25] tracking-[-0.005em]">{w.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{w.body}</p>
            {w.href && (
              <p class="mt-3">
                <a href={w.href} class="link text-sm" target="_blank" rel="noopener">Read →</a>
              </p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
