---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import { u } from "../lib/url";

const roles = [
  {
    title: "Agent Orchestrator",
    team: "Engineering",
    location: "New York, NY",
    body: "Own the runtime that schedules, gates, and audits Tesora's agents across rating, submission, and portfolio. You will design the control plane the rest of the product depends on, from review gating to lineage capture to reproducible runs.",
  },
  {
    title: "Forward-Deployed Actuarial Engineer",
    team: "Engineering",
    location: "New York, NY · or remote-US",
    body: "Sit alongside customer actuaries during pilots. Reconstruct raters in days. Build the customer-specific glue between the carrier's data and Tesora's substrate. Credentialed actuary preferred but not required if the depth is real.",
  },
  {
    title: "GTM Account Executive · Insurance",
    team: "GTM",
    location: "New York, NY",
    body: "Sell to chief actuaries at specialty P&C carriers and MGAs. You should have closed into the rating, pricing, or actuarial function before, or come from a carrier seat with the relationships to open doors. Carrier procurement is hard; this role is for someone who has walked through it before.",
  },
  {
    title: "Customer Engineer · MGA",
    team: "GTM",
    location: "New York, NY · or remote-US",
    body: "MGAs move fast. You own time-to-value for new MGA programs, from kickoff to first quote in Tesora's environment, in weeks not quarters. This role is hands-on with the product and with the customer's actuary.",
  },
];
---

<Layout
  title="Careers · Tesora"
  description="Open roles at Tesora. Frontier AI for actuaries, built by a team that has actually priced these lines."
  canonical="/careers"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/careers-loop.mp4")}
    headline="Build the substrate underneath specialty P&C pricing."
    deck="We're hiring engineers and operators who care about regulated AI, opinionated product, and being in the room with chief actuaries. Small team. New York. Y Combinator S25."
    primaryCta={{ label: "See open roles", href: "#roles" }}
    secondaryCta={{ label: "founders@tesora.ai", href: "mailto:founders@tesora.ai" }}
  />

  <section id="roles" class="mx-auto max-w-[1180px] px-6 md:px-10 pt-24 pb-24">
    <p class="eyebrow mb-6">Open roles</p>
    {roles.map((r) => (
      <article class="grid md:grid-cols-12 gap-6 md:gap-10 py-10 border-t border-[var(--rule)] first:border-t-0">
        <div class="md:col-span-5">
          <h3 class="font-semibold text-[1.5rem] leading-[1.2] tracking-[-0.008em]">{r.title}</h3>
          <p class="mt-2 text-sm text-[var(--fg-muted)]">{r.team} · {r.location}</p>
        </div>
        <div class="md:col-span-7">
          <p class="text-[1rem] leading-[1.6] text-[var(--fg)]">{r.body}</p>
          <p class="mt-5">
            <a href={`mailto:founders@tesora.ai?subject=${encodeURIComponent(r.title)}`} class="link text-sm">
              Apply →
            </a>
          </p>
        </div>
      </article>
    ))}
  </section>

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-24 text-center border-t border-[var(--rule)]">
    <h2 class="font-semibold text-[1.75rem] leading-[1.15] tracking-[-0.01em] max-w-[640px] mx-auto">
      Don't see your role?
    </h2>
    <p class="text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)] mt-5 max-w-[520px] mx-auto">
      If you've priced specialty lines, run an actuarial team, or built infrastructure for regulated AI, write to us. We hire ahead of the role.
    </p>
    <div class="mt-8">
      <a href="mailto:founders@tesora.ai" class="btn">founders@tesora.ai</a>
    </div>
  </section>

  <Footer />
</Layout>
