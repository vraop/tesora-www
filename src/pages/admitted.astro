---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import LayeredStack from "../components/LayeredStack.astro";
import { u } from "../lib/url";

const admittedLayers = [
  { num: "01", title: "Filings ingestion", body: "SERFF filings, public rate manuals, and your own actuarial memos parsed and normalized.", bullets: ["SERFF watch", "Memo extraction", "Loss runs and schedules of values"] },
  { num: "02", title: "Filing diff", body: "Compare every new filing against the prior version. Top changed factors surfaced in minutes.", bullets: ["Factor-level diff", "Territory move tracker", "Indication callouts"] },
  { num: "03", title: "Book overlay", body: "Run your in-force book through a competitor's rate plan, apples to apples.", bullets: ["Exposure replay", "Rate-on-rate impact", "Segment cuts"] },
  { num: "04", title: "GLM development", body: "Build or reverse-engineer GLMs from your own data, with a defensibility memo your reviewer can sign.", bullets: ["Curve fits", "Segmentation", "Defensibility memo"] },
  { num: "05", title: "Rate filing assistance", body: "Help with the filing itself and the responses to objection letters. Every input and citation preserved for the regulator's review months later.", bullets: ["Filing draft", "Objection response", "Full replay"] },
];

const admittedCapabilities = [
  { label: "Reproducible competitive analysis", body: "Reconstruct competitor rate plans from public filings and run your book through them, apples to apples. Every step recorded, every input preserved." },
  { label: "GLM development support", body: "Develop GLMs from your own data, or reverse-engineer a competitor GLM. Agents help with curve fitting, segmentation, and the defensibility memo." },
  { label: "Rate filing assistance", body: "Help with the filing itself and with responses to objection letters. The full analysis trail is preserved for the regulator review." },
  { label: "Multi-competitor comparison", body: "Run your book of exposures through multiple competitor rate plans in one pass, where the time used to be spent hunting filings and rebuilding them one by one." },
];
---

<Layout
  title="Admitted · Tesora"
  description="Tesora for admitted carriers. Watch every filing. Defend every move. Competitor SERFF filings parsed and diffed against your in-force book."
  canonical="/admitted"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/research-loop.mp4")}
    headline="Competitive analysis once thought unthinkable"
    deck="Now done in minutes. Reconstruct competitor rate plans, run your book through them, and keep every input and output preserved for review."
    primaryCta={{ label: "Request a walkthrough", href: "https://cal.com/team/tesora/quick-chat" }}
    secondaryCta={{ label: "Non-admitted (E&S)", href: u("/non-admitted") }}
  />

  <section class="bg-[var(--bg)] border-b border-[var(--rule)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20 grid md:grid-cols-12 gap-10 items-start">
      <div class="md:col-span-5">
        <p class="eyebrow mb-3">The filing cycle problem</p>
        <h2 class="font-semibold text-[2.125rem] leading-[1.1] tracking-[-0.013em]" style="text-wrap: balance;">
          A competitor's filing drops Monday. The committee meets Friday
        </h2>
      </div>
      <div class="md:col-span-7 grid gap-4">
        <p class="text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)]" style="text-wrap: pretty;">
          A new SERFF filing hits the public docket and the question is the same every time: what changed, what does it do to our book, and is there an indication to follow it. The work used to take days of hunting the manual, reconstructing the formulas, and running exposures. By the time the answer arrives, the committee has already moved on.
        </p>
        <p class="text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)]" style="text-wrap: pretty;">
          Tesora reconstructs the competitor rate plan, diffs it to the prior version, and runs your in-force book through it overnight. Every factor change is cited to the page. Every result is reproducible against the same data and the same standards months later, when the DOI asks how the analysis was done.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--bg)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20 md:py-24">
      <LayeredStack
        eyebrow="The admitted stack"
        title="From filing diff to your own rate plan"
        intro="Multi-competitor rate analysis used to mean days or weeks of hunting filings, reconstructing them, and running your book through each. Tesora runs it soup to nuts in one pass, with every input, analysis step, and output preserved."
        layers={admittedLayers}
      />
    </div>
  </section>

  <section class="bg-[var(--bg)] border-t border-[var(--rule)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20 grid md:grid-cols-12 gap-10 items-start">
      <div class="md:col-span-5">
        <p class="eyebrow mb-3">Where the time goes</p>
        <h2 class="font-semibold text-[2.125rem] leading-[1.1] tracking-[-0.013em]">
          Rate filings, GLMs, and competitive analysis
        </h2>
      </div>
      <div class="md:col-span-7">
        <p class="text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)]">
          Admitted pricing teams spend time on:
        </p>
        <ul class="mt-4 flex flex-col gap-2.5 text-[1.0625rem] leading-[1.55] text-[var(--fg-muted)]">
          <li class="flex gap-3 items-start">
            <span class="mt-[0.6rem] inline-block h-px w-5 bg-[var(--color-oxblood,#B400FE)]/70 flex-shrink-0" aria-hidden="true"></span>
            <span>Drafting rate filings and answering objection letters</span>
          </li>
          <li class="flex gap-3 items-start">
            <span class="mt-[0.6rem] inline-block h-px w-5 bg-[var(--color-oxblood,#B400FE)]/70 flex-shrink-0" aria-hidden="true"></span>
            <span>Building or reverse-engineering GLMs from their own data</span>
          </li>
          <li class="flex gap-3 items-start">
            <span class="mt-[0.6rem] inline-block h-px w-5 bg-[var(--color-oxblood,#B400FE)]/70 flex-shrink-0" aria-hidden="true"></span>
            <span>Ad-hoc competitive analysis that follows every new public filing</span>
          </li>
        </ul>
        <p class="mt-5 text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)]">
          Doing this work with a general-purpose AI is possible but slow, and the analysis is not reproducible weeks later. Tesora is an agentic harness for the same work, with every input, every analysis step, and every output preserved for review.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--bg-panel)] border-t border-[var(--rule)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20 grid md:grid-cols-12 gap-10">
      <div class="md:col-span-4">
        <p class="eyebrow mb-3">What the pricing team uses</p>
        <h2 class="font-semibold text-[2.125rem] leading-[1.1] tracking-[-0.013em]">
          Capabilities the admitted pricing team leans on
        </h2>
      </div>
      <div class="md:col-span-8 grid md:grid-cols-2 gap-x-10 gap-y-6">
        {admittedCapabilities.map((c) => (
          <div class="flex gap-3">
            <span class="mt-2 inline-block h-1.5 w-1.5 rounded-full flex-shrink-0 bg-[var(--color-oxblood,#6b1a1a)]" aria-hidden="true"></span>
            <div>
              <p class="font-semibold text-[1rem]">{c.label}</p>
              <p class="mt-1 text-[0.9375rem] leading-[1.55] text-[var(--fg-muted)]">{c.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
