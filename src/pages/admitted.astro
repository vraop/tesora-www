---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import AgentStack from "../components/AgentStack.astro";
import { u } from "../lib/url";

const admittedStack = {
  eyebrow: "Tesora agent stack",
  title: "Filing → rate-committee brief",
  agentChip: "Workbench + Audit",
  steps: [
    { num: "01", title: "Watch", body: "Every competitor SERFF filing parsed, classified, and diffed against the prior version. No manual triage." },
    { num: "02", title: "Diff", body: "Factor moves, schedule rating bands, base rates, surcharges. Surfaced against your in-force book in one view." },
    { num: "03", title: "Brief", body: "Class-level trend signals rolled up into a defensible narrative for rate committee or DOI prep." },
    { num: "04", title: "Audit", body: "Specialist agent verifies methodology and source citations before the rate committee sees the deck." },
  ],
  outputs: [
    { label: "Filing diff" },
    { label: "Rate-committee brief" },
    { label: "DOI prep packet" },
  ],
};

const admittedTags = ["Filing diff", "Class trends", "Loss-cost bench", "Committee prep", "DOI defense"];

const admittedCapabilities = [
  { label: "Filing diff", body: "Every competitor filing diffed against the prior version. Factor moves, schedule rating bands, base rates, surcharges. One view." },
  { label: "Class trends", body: "Roll up filing moves to class-level trend signals. Contractor classes, telematics credits, replacement cost, ordinance and law." },
  { label: "Loss-cost benchmarks", body: "Tesora ingests public bureau loss costs and competitor filings; you compare against your own book in plain English." },
  { label: "Defensible briefs", body: "Briefings for rate committee and state DOI prep, with each claim cited back to the originating filing artifact." },
];
---

<Layout
  title="Admitted · Tesora"
  description="Tesora for admitted carriers. Watch every filing. Defend every move. Competitor SERFF filings parsed and diffed against your in-force book."
  canonical="/admitted"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/research-loop.mp4")}
    headline="Watch every filing. Defend every move."
    deck="Filing-driven raters with SOX-grade audit. Every competitor SERFF filing parsed, classified, and diffed against your in-force book."
    primaryCta={{ label: "Request a walkthrough", href: "https://cal.com/team/tesora/quick-chat" }}
    secondaryCta={{ label: "Non-admitted (E&S)", href: u("/non-admitted") }}
  />

  <section class="vulcan-band">
    <video
      class="absolute inset-0 h-full w-full object-cover"
      src={u("/video/research-loop.mp4")}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    ></video>
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-ink,#0e0e0c)]/88 via-[var(--color-ink,#0e0e0c)]/74 to-[var(--color-ink,#0e0e0c)]/62"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_color-mix(in_oklab,_var(--color-oxblood)_28%,_transparent)_0%,_transparent_58%)]"></div>

    <div class="relative mx-auto max-w-[1180px] grid md:grid-cols-12 gap-10 md:gap-12 px-6 md:px-10 py-20 md:py-24">
      <div class="md:col-span-6 self-center text-[var(--color-bone)]">
        <p class="text-[10px] font-bold uppercase tracking-[0.28em] text-[var(--color-bone)]/65 mb-4">Admitted · Market intelligence</p>
        <h2 class="font-semibold text-[2.25rem] md:text-[2.75rem] leading-[1.05] tracking-[-0.018em]">
          Filing-driven raters.<br/>SOX-grade audit.
        </h2>
        <p class="mt-6 text-[1.0625rem] leading-[1.55] text-[var(--color-bone)]/80 max-w-[520px]">
          Admitted carriers in Commercial Auto, BOP, and Homeowners use Tesora to monitor what competitors actually file. Every change parsed, diffed against your in-force book, and tied back to the originating SERFF artifact.
        </p>
        <div class="mt-7 flex flex-wrap gap-2">
          {admittedTags.map((t) => (
            <span class="px-3 py-1 rounded-full text-[11px] font-medium tracking-[0.04em] uppercase border border-[var(--color-bone)]/20 text-[var(--color-bone)]/85">
              {t}
            </span>
          ))}
        </div>
      </div>

      <div class="md:col-span-6">
        <AgentStack
          eyebrow={admittedStack.eyebrow}
          title={admittedStack.title}
          agentChip={admittedStack.agentChip}
          steps={admittedStack.steps}
          outputs={admittedStack.outputs}
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-20">
    <div class="grid md:grid-cols-12 gap-10">
      <div class="md:col-span-4">
        <p class="eyebrow mb-3">What the rate manager uses</p>
        <h2 class="font-semibold text-[1.75rem] leading-[1.15] tracking-[-0.01em]">
          Capabilities an admitted-line team leans on weekly.
        </h2>
      </div>
      <div class="md:col-span-8 grid md:grid-cols-2 gap-x-10 gap-y-6">
        {admittedCapabilities.map((c) => (
          <div class="flex gap-3">
            <span class="mt-2 inline-block h-1.5 w-1.5 rounded-full flex-shrink-0 bg-[var(--color-oxblood,#6b1a1a)]" aria-hidden="true"></span>
            <div>
              <p class="font-semibold text-[1rem]">{c.label}</p>
              <p class="mt-1 text-[0.9375rem] leading-[1.55] text-[var(--fg-muted)]">{c.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
