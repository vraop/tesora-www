---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import TesoraStack from "../components/TesoraStack.astro";
import { u } from "../lib/url";

// Layers that carry the most weight for an admitted motion: filings
// ingestion (SERFF watch), substrate (in-force book), rating engine (the
// actual rater you ship), and audit (rate-committee and DOI defense).
const admittedHighlightNums = ["03", "04", "05", "07"];

const admittedTags = ["Filing diff", "Class trends", "Loss-cost bench", "Committee prep", "DOI defense"];

const admittedCapabilities = [
  { label: "Filing diff", body: "Every competitor filing diffed against the prior version. Factor moves, schedule rating bands, base rates, surcharges. One view." },
  { label: "Class trends", body: "Roll up filing moves to class-level trend signals. Contractor classes, telematics credits, replacement cost, ordinance and law." },
  { label: "Loss-cost benchmarks", body: "Tesora ingests public bureau loss costs and competitor filings; you compare against your own book in plain English." },
  { label: "Defensible briefs", body: "Briefings for rate committee and state DOI prep, with each claim cited back to the originating filing artifact." },
];
---

<Layout
  title="Admitted · Tesora"
  description="Tesora for admitted carriers. Watch every filing. Defend every move. Competitor SERFF filings parsed and diffed against your in-force book."
  canonical="/admitted"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/research-loop.mp4")}
    headline="Watch every filing. Defend every move."
    deck="Filing-driven raters with SOX-grade audit. Every competitor SERFF filing parsed, classified, and diffed against your in-force book."
    primaryCta={{ label: "Request a walkthrough", href: "https://cal.com/team/tesora/quick-chat" }}
    secondaryCta={{ label: "Non-admitted (E&S)", href: u("/non-admitted") }}
  />

  <section class="bg-[var(--bg)]">
    <div class="mx-auto max-w-[1180px] grid md:grid-cols-12 gap-10 md:gap-12 px-6 md:px-10 py-20 md:py-24">
      <div class="md:col-span-6 self-center">
        <p class="eyebrow mb-4">Admitted · Market intelligence</p>
        <h2 class="font-semibold text-[2.25rem] md:text-[2.75rem] leading-[1.05] tracking-[-0.018em] text-[var(--fg)]">
          Filing-driven raters.<br/>SOX-grade audit.
        </h2>
        <p class="mt-6 text-[1.0625rem] leading-[1.55] text-[var(--fg-muted)] max-w-[520px]">
          Admitted carriers in Commercial Auto, BOP, and Homeowners use Tesora to monitor what competitors actually file. Every change parsed, diffed against your in-force book, and tied back to the originating SERFF artifact.
        </p>
        <div class="mt-7 flex flex-wrap gap-2">
          {admittedTags.map((t) => (
            <span class="px-3 py-1 rounded-full text-[11px] font-medium tracking-[0.04em] uppercase border border-[var(--rule)] text-[var(--fg-muted)]">
              {t}
            </span>
          ))}
        </div>
      </div>

      <div class="md:col-span-6">
        <TesoraStack
          title="The stack behind every filing-driven rater."
          caption="Every filed rate runs the same seven layers. The four that carry the admitted motion are highlighted; the rest are present whether you're filing in Texas or quoting in Florida."
          highlightNums={admittedHighlightNums}
        />
      </div>
    </div>
  </section>

  <section class="bg-[var(--bg-panel)] border-t border-[var(--rule)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20 grid md:grid-cols-12 gap-10">
      <div class="md:col-span-4">
        <p class="eyebrow mb-3">What the rate manager uses</p>
        <h2 class="font-semibold text-[1.75rem] leading-[1.15] tracking-[-0.01em]">
          Capabilities an admitted-line team leans on weekly.
        </h2>
      </div>
      <div class="md:col-span-8 grid md:grid-cols-2 gap-x-10 gap-y-6">
        {admittedCapabilities.map((c) => (
          <div class="flex gap-3">
            <span class="mt-2 inline-block h-1.5 w-1.5 rounded-full flex-shrink-0 bg-[var(--color-oxblood,#6b1a1a)]" aria-hidden="true"></span>
            <div>
              <p class="font-semibold text-[1rem]">{c.label}</p>
              <p class="mt-1 text-[0.9375rem] leading-[1.55] text-[var(--fg-muted)]">{c.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
