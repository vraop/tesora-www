---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Tabs from "../components/Tabs.astro";
import CinematicHero from "../components/CinematicHero.astro";
import { u } from "../lib/url";

const tabs = [
  { id: "non-admitted", label: "Non-admitted (E&S)" },
  { id: "admitted", label: "Admitted carriers" },
  { id: "students", label: "Actuarial students" },
];

const specialtyLines = [
  { name: "Contractor's general liability", note: "Schedule rating without the vibes. Audit-true payroll exposure across the book." },
  { name: "Excess casualty", note: "Layered tower pricing with cedant-specific loss data, not industry averages." },
  { name: "Professional lines (E&O / D&O)", note: "Class-by-class severity curves, judicial-jurisdiction-aware, regulator-defensible coefficients." },
  { name: "Medical professional liability", note: "Specialty mix and venue effects modeled on the carrier's own closed-claim file." },
  { name: "Cyber", note: "Risk classification informed by the insured's actual security posture, not a self-reported questionnaire." },
  { name: "Transactional E&S (program business)", note: "Multi-class program raters reconstructed from filings and stood up in days, not quarters." },
  { name: "Inland marine and specialty property", note: "Construction-class accumulation, exposure-base reconciliation, valuation discipline." },
];
---

<Layout
  title="Customers · Tesora"
  description="Tesora serves specialty P&C carriers, admitted carriers needing market intelligence, and actuarial students with research access."
  canonical="/customers"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/customers-loop.mp4")}
    headline="Built for chief actuaries. Extended to the rooms they share."
    deck="Tesora's primary buyer is the chief actuary at a specialty P&C carrier or MGA. The same substrate serves admitted carriers as market intelligence and actuarial students as research access."
    primaryCta={{ label: "Talk to Tesora", href: "mailto:vivek@tesora.ai" }}
  />

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 pb-32">
    <Tabs tabs={tabs} initial="non-admitted">
      {/* Non-admitted */}
      <div class="tesora-tab-panel" data-tab="non-admitted">
        <div class="grid md:grid-cols-12 gap-10">
          <div class="md:col-span-5">
            <p class="eyebrow mb-3">Specialty · E&amp;S</p>
            <h2 class="font-semibold text-[1.875rem] leading-[1.15] tracking-[-0.012em]">
              The lines that don't fit a textbook.
            </h2>
            <p class="mt-5 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
              Specialty and excess and surplus carriers price the lines where every risk is bespoke and ISO's loop is a starting point, not the answer. Tesora is built for that buyer: hard-to-rate exposures, multi-class programs, and chief actuaries who own the rate plan end to end.
            </p>
          </div>
          <div class="md:col-span-7">
            {specialtyLines.map((line) => (
              <div class="border-t border-[var(--rule)] first:border-t-0 py-5">
                <p class="font-semibold text-[1.0625rem]">{line.name}</p>
                <p class="mt-1 text-[0.9375rem] leading-[1.55] text-[var(--fg-muted)]">{line.note}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Admitted */}
      <div class="tesora-tab-panel" data-tab="admitted" hidden>
        <div class="grid md:grid-cols-12 gap-10">
          <div class="md:col-span-5">
            <p class="eyebrow mb-3">Admitted · Market intelligence</p>
            <h2 class="font-semibold text-[1.875rem] leading-[1.15] tracking-[-0.012em]">
              Watch the market without watching every filing.
            </h2>
            <p class="mt-5 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
              Admitted carriers in Commercial Auto, BOP, and Homeowners use Tesora to monitor what competitors actually file. Every change parsed, classified, and surfaced against your in-force book. No more SERFF triage by hand.
            </p>
          </div>
          <div class="md:col-span-7 space-y-6">
            <div class="border border-[var(--rule)] rounded-md p-6">
              <p class="font-semibold">Filing diff</p>
              <p class="mt-2 text-sm text-[var(--fg-muted)]">Every competitor filing diffed against the prior version. Factor moves, schedule rating bands, base rates, surcharges, all surfaced in one view.</p>
            </div>
            <div class="border border-[var(--rule)] rounded-md p-6">
              <p class="font-semibold">Class trends</p>
              <p class="mt-2 text-sm text-[var(--fg-muted)]">Roll up filing moves to class-level trend signals. Where is the market going on contractor classes, telematics credits, replacement cost, ordinance and law?</p>
            </div>
            <div class="border border-[var(--rule)] rounded-md p-6">
              <p class="font-semibold">Defensible briefs</p>
              <p class="mt-2 text-sm text-[var(--fg-muted)]">Briefings for rate committee and state DOI prep, with each claim cited back to the originating filing artifact.</p>
            </div>
          </div>
        </div>
      </div>

      {/* Students */}
      <div class="tesora-tab-panel" data-tab="students" hidden>
        <div class="grid md:grid-cols-12 gap-10">
          <div class="md:col-span-6">
            <p class="eyebrow mb-3">Actuarial Research Access</p>
            <h2 class="font-semibold text-[1.875rem] leading-[1.15] tracking-[-0.012em]">
              For the next generation of pricing actuaries.
            </h2>
            <p class="mt-5 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
              Tesora opens a research surface for actuarial students working on capstone projects, exam papers, or independent research in pricing. Free access to a sandboxed substrate, public SERFF corpora, and one of our team as an informal advisor.
            </p>
            <p class="mt-5 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">
              Tell us where you study and when you graduate. We respond within a week.
            </p>
          </div>
          <div class="md:col-span-6">
            <div class="border border-[var(--rule)] rounded-md p-8 bg-[var(--bg-panel)]">
              <p class="font-semibold">Apply for research access</p>
              <p class="mt-2 text-sm text-[var(--fg-muted)]">A short form. Two minutes. We read every submission.</p>
              <a
                href="https://forms.gle/your-form-id-here"
                target="_blank"
                rel="noopener"
                class="btn mt-6"
              >
                Open the form
              </a>
              <p class="mt-4 text-xs text-[var(--fg-muted)]">
                Or email <a href="mailto:founders@tesora.ai" class="link">founders@tesora.ai</a> with: school, expected graduation, area of interest, advisor (if any).
              </p>
            </div>
          </div>
        </div>
      </div>
    </Tabs>
  </section>

  <Footer />
</Layout>
