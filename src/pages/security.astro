---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import { u } from "../lib/url";

const compliance = [
  {
    label: "SOC 2",
    body: "Audited annually. Trust services criteria for security, availability, processing integrity, and confidentiality. Report available under NDA.",
  },
  {
    label: "SOX-aligned audit trail",
    body: "Every change to a rate plan is recorded with reviewer, timestamp, model version, and source. Designed to survive a SOX walkthrough for carriers with public-company parents.",
  },
  {
    label: "Aligned with the actuarial standards",
    body: "Built to support actuaries operating under the Actuarial Standards of Practice, the AAA/CAS/SOA Code of Professional Conduct, the US Qualification Standards, and the CAS Statements of Principles.",
  },
];

const dataPosture = [
  {
    label: "No training on customer data",
    body: "Customer rate plans, filings, books, and submissions are never used to train shared models. Period.",
  },
  {
    label: "Per-tenant isolation",
    body: "Each customer's data lives in a dedicated tenant. No cross-tenant inference, no shared embeddings, no shared vector store.",
  },
  {
    label: "US-only data residency",
    body: "Production data stays in US-region infrastructure (AWS us-east, us-west). EU residency on request.",
  },
  {
    label: "Encryption",
    body: "AES-256 at rest, TLS 1.3 in transit, customer-scoped KMS keys, no plaintext PII in logs.",
  },
  {
    label: "SSO, SAML, RBAC",
    body: "Okta, Azure AD, Google Workspace integrations. Granular role-based access. Customer-controlled user provisioning.",
  },
  {
    label: "Data source tracing",
    body: "Every value Tesora populates traces back to the cell or page it came from. The provenance is preserved as a stable reference.",
  },
];
---

<Layout
  title="Security · Tesora"
  description="Tesora is SOC 2 audited, SOX-aligned, and built to support actuaries operating under the Actuarial Standards of Practice and the broader compliance framework."
  canonical="/security"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/security-loop.mp4")}
    headline="Built for one of the most heavily regulated industries"
    deck="Tesora was built by actuaries who understand the regulatory frameworks, and serves people who operate under those frameworks every day."
    primaryCta={{ label: "Request a demo", href: "https://cal.com/team/tesora/quick-chat" }}
  />

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
    <div class="grid md:grid-cols-12 gap-10 items-start mb-12">
      <div class="md:col-span-3 flex md:justify-start">
        <img
          src={u("/logos/soc2-badge.svg")}
          alt="AICPA SOC 2"
          class="h-28 w-28 md:h-32 md:w-32"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="md:col-span-9">
        <p class="eyebrow mb-3">Compliance</p>
        <h2 class="font-semibold text-[1.75rem] leading-[1.15] tracking-[-0.01em] max-w-[640px]">
          SOC 2 audited, SOX-aligned, actuarial standards-aware
        </h2>
        <p class="mt-4 text-[1rem] leading-[1.6] text-[var(--fg-muted)] max-w-[640px]">
          Tesora is audited annually against the AICPA SOC 2 trust services criteria for security, availability, processing integrity, and confidentiality. Report available under mutual NDA.
        </p>
      </div>
    </div>
    <dl class="grid md:grid-cols-2 gap-x-16 gap-y-10">
      {compliance.map((c) => (
        <div class="border-t border-[var(--rule)] pt-6">
          <dt class="font-semibold text-[1.125rem] tracking-tight">{c.label}</dt>
          <dd class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{c.body}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
    <p class="eyebrow mb-8">Data posture</p>
    <dl class="grid md:grid-cols-2 gap-x-16 gap-y-10">
      {dataPosture.map((d) => (
        <div class="border-t border-[var(--rule)] pt-6">
          <dt class="font-semibold text-[1.125rem] tracking-tight">{d.label}</dt>
          <dd class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{d.body}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="bg-[var(--bg-panel)] border-y border-[var(--rule)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
      <div class="max-w-[760px]">
        <p class="eyebrow mb-5">Deployment</p>
        <h2 class="font-semibold text-[2rem] leading-[1.15] tracking-[-0.012em]">
          On-prem or hosted in an isolated environment
        </h2>
        <p class="mt-5 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
          Most carriers deploy Tesora in a hosted environment with full encryption and per-tenant isolation. For carriers with internal-only model policies, Tesora supports on-prem deployment with model inference in the carrier's own VPC. Same audit trail, same control plane, same agents.
        </p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
