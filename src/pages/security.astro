---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import { u } from "../lib/url";

const compliance = [
  {
    label: "SOC 2 Type II",
    body: "Audited annually. Trust services criteria for security, availability, processing integrity, confidentiality. Report available under NDA.",
  },
  {
    label: "SOX-aligned audit trail",
    body: "Every change to a rate plan recorded with reviewer, timestamp, model version, and originating filing. Designed to survive a SOX walkthrough for carriers with public-company parents.",
  },
  {
    label: "ASOP 56 (Modeling)",
    body: "Model governance, intended use, reliance, and limitations documented for every Tesora-touched model. Output suitable for inclusion in an actuarial work product.",
  },
  {
    label: "ASOP 41 (Actuarial Communications)",
    body: "Every quote, brief, and refit proposal carries an actuarial communication artifact, with assumptions and reliance disclosed.",
  },
  {
    label: "ASOP 12 (Risk Classification)",
    body: "Risk-classification systems reviewed against the homogeneity, credibility, and practicality tests laid out in ASOP 12.",
  },
  {
    label: "NAIC Model Bulletin 2023-25",
    body: "AI system governance, third-party AI documentation, and consumer-impact review aligned with the NAIC AI bulletin adopted across the state regulators.",
  },
];

const dataPosture = [
  {
    label: "No training on customer data",
    body: "Customer rate plans, filings, books, and submissions are never used to train shared models. Period.",
  },
  {
    label: "Per-tenant isolation",
    body: "Each customer's data lives in a dedicated tenant. No cross-tenant inference, no shared embeddings, no shared vector store.",
  },
  {
    label: "US-only data residency",
    body: "Production data stays in US-region infrastructure (AWS us-east, us-west). EU residency on request.",
  },
  {
    label: "Encryption",
    body: "AES-256 at rest, TLS 1.3 in transit, customer-scoped KMS keys, no plaintext PII in logs.",
  },
  {
    label: "SSO, SAML, RBAC",
    body: "Okta, Azure AD, Google Workspace integrations. Granular role-based access. Customer-controlled user provisioning.",
  },
  {
    label: "SERFF lineage",
    body: "Every value Tesora populates traces back to a specific page of a specific filing, preserved as a stable artifact reference.",
  },
];
---

<Layout
  title="Security · Tesora"
  description="Tesora is SOC 2 Type II, SOX-aligned, ASOP 56/41/12 compliant, and built for the regulatory posture chief actuaries answer to."
  canonical="/security"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/security-loop.mp4")}
    headline="Built for the regulatory posture chief actuaries answer to."
    deck="Specialty P&C is a regulated industry. Tesora is engineered for the standard of practice a chief actuary signs against, not the standard a SaaS vendor checks a box for."
    primaryCta={{ label: "Request a demo", href: "mailto:founders@tesora.ai?subject=Tesora%20demo" }}
  />

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
    <div class="grid md:grid-cols-12 gap-10 items-start mb-12">
      <div class="md:col-span-3 flex md:justify-start">
        <img
          src={u("/logos/soc2-badge.svg")}
          alt="AICPA SOC 2 Type II"
          class="h-28 w-28 md:h-32 md:w-32"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="md:col-span-9">
        <p class="eyebrow mb-3">Compliance</p>
        <h2 class="font-semibold text-[1.75rem] leading-[1.15] tracking-[-0.01em] max-w-[640px]">
          SOC 2 Type II audited. SOX-ready. ASOP-aware.
        </h2>
        <p class="mt-4 text-[1rem] leading-[1.6] text-[var(--fg-muted)] max-w-[640px]">
          Tesora is audited annually against the AICPA SOC 2 Type II trust services criteria for security, availability, processing integrity, and confidentiality. Report available under mutual NDA.
        </p>
      </div>
    </div>
    <dl class="grid md:grid-cols-2 gap-x-16 gap-y-10">
      {compliance.map((c) => (
        <div class="border-t border-[var(--rule)] pt-6">
          <dt class="font-semibold text-[1.125rem] tracking-tight">{c.label}</dt>
          <dd class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{c.body}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
    <p class="eyebrow mb-8">Data posture</p>
    <dl class="grid md:grid-cols-2 gap-x-16 gap-y-10">
      {dataPosture.map((d) => (
        <div class="border-t border-[var(--rule)] pt-6">
          <dt class="font-semibold text-[1.125rem] tracking-tight">{d.label}</dt>
          <dd class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{d.body}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="bg-[var(--bg-panel)] border-y border-[var(--rule)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
      <div class="max-w-[760px]">
        <p class="eyebrow mb-5">Deployment options</p>
        <h2 class="font-semibold text-[2rem] leading-[1.15] tracking-[-0.012em]">
          Cloud-hosted by default. On-prem for carriers that require it.
        </h2>
        <p class="mt-5 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
          Most carriers deploy Tesora in our hosted environment with full encryption and per-tenant isolation. For carriers with internal-only model policies, Tesora supports on-prem deployment with model inference in the carrier's own VPC. Same audit trail, same control plane, same agents.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-32 text-center">
    <h2 class="font-semibold text-[1.75rem] leading-[1.15] tracking-[-0.01em] max-w-[640px] mx-auto">
      Need the SOC 2 report?
    </h2>
    <p class="text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)] mt-5 max-w-[520px] mx-auto">
      Request a demo and we'll send it over. Mutual NDA, then full pack within a business day.
    </p>
    <div class="mt-8">
      <a href="mailto:founders@tesora.ai?subject=Tesora%20demo" class="btn">Request a demo →</a>
    </div>
  </section>

  <Footer />
</Layout>
