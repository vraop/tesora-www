---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import TesoraStack from "../components/TesoraStack.astro";
import { u } from "../lib/url";

// Layers that carry the most weight for an E&S motion: ingestion (broker
// submissions are messy), substrate (one spine), workbench (the underwriter
// surface), and audit (every quote has a defensible trail).
const esHighlightNums = ["03", "04", "06", "07"];

const specialtyLines = [
  { name: "Contractor's general liability", note: "Schedule rating without the vibes. Audit-true payroll exposure across the book." },
  { name: "Excess casualty", note: "Layered tower pricing with cedant-specific loss data, not industry averages." },
  { name: "Professional lines (E&O / D&O)", note: "Class-by-class severity curves, judicial-jurisdiction-aware, regulator-defensible coefficients." },
  { name: "Cyber", note: "Risk classification informed by the insured's actual security posture, not a self-reported questionnaire." },
  { name: "Transactional E&S (program business)", note: "Multi-class program raters reconstructed from filings and stood up in days, not quarters." },
];
---

<Layout
  title="Non-Admitted · Tesora"
  description="Tesora for non-admitted and E&S carriers. Quote at E&S speed. Hold up under E&S audit. Bind-ready pricing with full lineage from loss run to quote."
  canonical="/non-admitted"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/customers-loop.mp4")}
    headline="Quote E&S with conviction."
    deck="Bind-ready pricing for specialty and E&S carriers. Submission triage, manuscript flex, deviation accounting. Quotes that land before the broker calls back."
    primaryCta={{ label: "Request a walkthrough", href: "https://cal.com/team/tesora/quick-chat" }}
  />

  <section class="bg-[var(--bg)]">
    <div class="mx-auto max-w-[1180px] grid md:grid-cols-12 gap-10 md:gap-12 px-6 md:px-10 py-20 md:py-24">
      <div class="md:col-span-6 self-center">
        <p class="eyebrow mb-4">Specialty · E&amp;S</p>
        <h2 class="font-semibold text-[2.25rem] md:text-[2.75rem] leading-[1.05] tracking-[-0.018em] text-[var(--fg)]">
          Quote in under 6 weeks,<br/>not six months.
        </h2>
        <p class="mt-6 text-[1.0625rem] leading-[1.55] text-[var(--fg-muted)] max-w-[520px]">
          Tesora ingests the submission, prices the risk, and leaves an audit trail the chief actuary can sign against. Every credit traces back to your own loss data.
        </p>
      </div>

      <div class="md:col-span-6">
        <TesoraStack
          title="The stack behind the bind-ready quote."
          caption="Every quote rides the same seven layers. The four that carry the E&S motion are highlighted; the rest are present whether the file is admitted or non-admitted."
          highlightNums={esHighlightNums}
        />
      </div>
    </div>
  </section>

  <section class="bg-[var(--bg)] border-t border-[var(--rule)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20 grid md:grid-cols-12 gap-10 items-start">
      <div class="md:col-span-5">
        <p class="eyebrow mb-3">The reality on the E&amp;S desk</p>
        <h2 class="font-semibold text-[1.75rem] leading-[1.15] tracking-[-0.01em]">
          The submission shows up the way it always has.
        </h2>
      </div>
      <div class="md:col-span-7">
        <p class="text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
          An email, an Excel, a schema nobody agreed to in advance, and a broker who needs the quote before lunch. The MGA on the other side has one credentialed actuary on staff, maybe two, and a stack of files that don't fit any textbook. About 5% of intake comes over an API. The rest is what the broker actually sent.
        </p>
        <p class="mt-4 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
          Tesora reads what the broker actually sent. Not a normalized version, not a version someone else cleaned. And it prices to the audit standard a chief actuary signs against. The portal can come later. The quote ships today.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--bg-panel)] border-t border-[var(--rule)]">
    <div class="mx-auto max-w-[1180px] grid md:grid-cols-12 gap-10 px-6 md:px-10 py-20 md:py-24">
      <div class="md:col-span-4">
        <p class="eyebrow mb-3">Lines we serve</p>
        <h2 class="font-semibold text-[1.75rem] leading-[1.15] tracking-[-0.01em]">
          The lines that don't fit a textbook.
        </h2>
        <p class="mt-4 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)] max-w-[420px]">
          Hard-to-rate exposures, multi-class programs, and chief actuaries who own the rate plan end to end.
        </p>
      </div>
      <div class="md:col-span-8">
        {specialtyLines.map((line) => (
          <div class="border-t border-[var(--rule)] first:border-t-0 py-5">
            <p class="font-semibold text-[1.0625rem]">{line.name}</p>
            <p class="mt-1 text-[0.9375rem] leading-[1.55] text-[var(--fg-muted)]">{line.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
