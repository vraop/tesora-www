---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import AgentStack from "../components/AgentStack.astro";
import { u } from "../lib/url";

const esStack = {
  eyebrow: "Tesora agent stack",
  title: "Submission → bind-ready quote",
  agentChip: "Workbench + Audit",
  steps: [
    { num: "01", title: "Ingest", body: "Loss runs, SOVs, broker decks, schedules. Any format. Normalized and source-cited before the actuary sees the file." },
    { num: "02", title: "Price", body: "Class factors, exposure base, schedule mods, ILFs. The Workbench walks the build-up; the actuary controls the calls." },
    { num: "03", title: "Defend", body: "Every credit traces back to the carrier's own loss data and the originating filing artifact." },
    { num: "04", title: "Audit", body: "Specialist agent regrades the file against actuarial best practice before the rate committee sees it." },
  ],
  outputs: [
    { label: "Bound quote" },
    { label: "Schedule-rating brief" },
    { label: "Audit trail" },
  ],
};

const esTags = ["Schedule rating", "Exposure base", "Class factors", "Audit lineage", "SOX trail"];

const specialtyLines = [
  { name: "Contractor's general liability", note: "Schedule rating without the vibes. Audit-true payroll exposure across the book." },
  { name: "Excess casualty", note: "Layered tower pricing with cedant-specific loss data, not industry averages." },
  { name: "Professional lines (E&O / D&O)", note: "Class-by-class severity curves, judicial-jurisdiction-aware, regulator-defensible coefficients." },
  { name: "Cyber", note: "Risk classification informed by the insured's actual security posture, not a self-reported questionnaire." },
  { name: "Transactional E&S (program business)", note: "Multi-class program raters reconstructed from filings and stood up in days, not quarters." },
];
---

<Layout
  title="Non-Admitted · Tesora"
  description="Tesora for non-admitted and E&S carriers. Quote at E&S speed. Hold up under E&S audit. Bind-ready pricing with full lineage from loss run to quote."
  canonical="/non-admitted"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/customers-loop.mp4")}
    headline="Quote E&S with conviction."
    deck="Bind-ready pricing for specialty and E&S carriers. Submission triage, manuscript flex, deviation accounting. Quotes that land before the broker calls back."
    primaryCta={{ label: "Request a walkthrough", href: "https://cal.com/team/tesora/quick-chat" }}
  />

  <section class="vulcan-band">
    <video
      class="absolute inset-0 h-full w-full object-cover"
      src={u("/video/numbers-loop.mp4")}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    ></video>
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-ink,#0e0e0c)]/88 via-[var(--color-ink,#0e0e0c)]/74 to-[var(--color-ink,#0e0e0c)]/62"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_color-mix(in_oklab,_var(--color-oxblood)_28%,_transparent)_0%,_transparent_58%)]"></div>

    <div class="relative mx-auto max-w-[1180px] grid md:grid-cols-12 gap-10 md:gap-12 px-6 md:px-10 py-20 md:py-24">
      <div class="md:col-span-6 self-center text-[var(--color-bone)]">
        <p class="text-[10px] font-bold uppercase tracking-[0.28em] text-[var(--color-bone)]/65 mb-4">Specialty · E&amp;S</p>
        <h2 class="font-semibold text-[2.25rem] md:text-[2.75rem] leading-[1.05] tracking-[-0.018em]">
          Quote in under 6 weeks,<br/>not six months.
        </h2>
        <p class="mt-6 text-[1.0625rem] leading-[1.55] text-[var(--color-bone)]/80 max-w-[520px]">
          Tesora ingests the submission, prices the risk, and leaves an audit trail the chief actuary can sign against. Every credit traces back to your own loss data.
        </p>
        <div class="mt-7 flex flex-wrap gap-2">
          {esTags.map((t) => (
            <span class="px-3 py-1 rounded-full text-[11px] font-medium tracking-[0.04em] uppercase border border-[var(--color-bone)]/20 text-[var(--color-bone)]/85">
              {t}
            </span>
          ))}
        </div>
      </div>

      <div class="md:col-span-6">
        <AgentStack
          eyebrow={esStack.eyebrow}
          title={esStack.title}
          agentChip={esStack.agentChip}
          steps={esStack.steps}
          outputs={esStack.outputs}
        />
      </div>
    </div>
  </section>

  <section class="vulcan-band">
    <video
      class="absolute inset-0 h-full w-full object-cover"
      src={u("/video/about-loop.mp4")}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    ></video>
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-ink,#0e0e0c)]/92 via-[var(--color-ink,#0e0e0c)]/82 to-[var(--color-ink,#0e0e0c)]/72"></div>

    <div class="relative mx-auto max-w-[1180px] grid md:grid-cols-12 gap-10 px-6 md:px-10 py-24 text-[var(--color-bone)]">
      <div class="md:col-span-4">
        <p class="text-[10px] font-bold uppercase tracking-[0.28em] text-[var(--color-bone)]/65 mb-3">Lines we serve</p>
        <h2 class="font-semibold text-[1.75rem] leading-[1.15] tracking-[-0.01em]">
          The lines that don't fit a textbook.
        </h2>
        <p class="mt-4 text-[0.9375rem] leading-[1.6] text-[var(--color-bone)]/75 max-w-[420px]">
          Hard-to-rate exposures, multi-class programs, and chief actuaries who own the rate plan end to end.
        </p>
      </div>
      <div class="md:col-span-8">
        {specialtyLines.map((line) => (
          <div class="border-t border-[var(--color-bone)]/12 first:border-t-0 py-5">
            <p class="font-semibold text-[1.0625rem] text-[var(--color-bone)]">{line.name}</p>
            <p class="mt-1 text-[0.9375rem] leading-[1.55] text-[var(--color-bone)]/70">{line.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
