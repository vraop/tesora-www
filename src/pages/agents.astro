---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import HarnessDiagram from "../components/HarnessDiagram.astro";
import Lifecycle from "../components/Lifecycle.astro";
import { u } from "../lib/url";

type Faq = { q: string; a: string };
const faqs: Faq[] = [
  {
    q: "Why organize the product around the carrier lifecycle instead of by feature?",
    a: "It mirrors how the work flows. Market research feeds loss modeling, which feeds the rater, which feeds underwriting, which feeds reserving. When the stages share one workbench and one data spine, the handoffs stay lossless and the audit trail stays intact end-to-end.",
  },
  {
    q: "Can we import our existing rating models?",
    a: "Yes. Upload your Excel raters directly. The system parses formulas, identifies factor tables, and creates a versioned model. Existing logic is preserved exactly.",
  },
  {
    q: "What integrations do you support?",
    a: "REST API for any system. Connectors for common policy administration and underwriting platforms. Microsoft 365 (SharePoint and Teams) for document ingestion and notifications.",
  },
  {
    q: "How does role separation work for SOX?",
    a: "Three environments: dev (actuaries build), test (QA validates), prod (underwriters use). Different roles have different access. Actuaries cannot push directly to prod. Full audit trail of who promoted what and when.",
  },
  {
    q: "Do you train on our data?",
    a: "No. Zero data retention policies are in place with our model providers. Your data is not used for model training, ours or anyone else's.",
  },
  {
    q: "Is confidential data protected?",
    a: "Yes. Each customer is deployed as a single-tenant, bespoke environment your IT team controls. Your data does not share infrastructure with any other customer.",
  },
];

type Workflow = { num: string; title: string; body: string; outcomes: string[] };

const workflows: Workflow[] = [
  {
    num: "01",
    title: "Ingest the mess.",
    body: "Loss runs come in five formats from five carriers, and reformatting them is the kind of work senior actuaries do at 11 PM. AI is finally good enough at that mechanical work that you should never do it again. The Workbench reads any format and hands back one normalized table with every value cited to the cell it came from.",
    outcomes: [
      "PDF, Excel, CSV, Word.",
      "Auto-classified and anomaly-checked.",
      "Every value cites its source cell.",
    ],
  },
  {
    num: "02",
    title: "Build raters that ship.",
    body: "Most rate plans live as a 60-page filing and a spreadsheet only one person on the team can run. The Workbench turns that into a versioned, callable pricing API in days, not quarters. Author, reviewer, and approver are three separate identities. No engineering ticket, no IT roadmap.",
    outcomes: [
      "Base rates, factors, ILFs, schedule mods.",
      "Author, reviewer, approver as separate identities.",
      "Side-by-side quotes against any plan or competitor.",
    ],
  },
  {
    num: "03",
    title: "Run the analyses.",
    body: "Trending, on-leveling, distribution fitting, BF reserving. The math has been settled for decades. What slows the work is the assembly: finding the data, picking the right method, writing the memo. The Workbench compresses the assembly without touching your judgment.",
    outcomes: [
      "Trend, on-leveling, distribution fitting, VaR/TVaR.",
      "XOL structuring, aggregate stop-loss, cession.",
      "Reserving (chain-ladder, BF, IBNR). In development.",
    ],
  },
  {
    num: "04",
    title: "Audit and ship.",
    body: "Most rate-committee surprises come from a spreadsheet nobody re-checked. A specialist audit agent regrades the analysis against CAS Statements of Principles before your committee sees it. The first time you catch a mistake at the audit step instead of in the meeting, the value is obvious.",
    outcomes: [
      "Extend reports with a new chart, year, or segment.",
      "Graded against CAS best practice.",
      "Every workflow lands as a reviewable tab.",
    ],
  },
];

const workbenchPatterns = [
  {
    label: "Be conversational.",
    body: "Type what you would say to a junior analyst.",
    example: "Trend these losses to 2026 at 4%.",
  },
  {
    label: "Point at data.",
    body: "Tell it which vault or file to use.",
    example: "Use the loss run in the Q1 vault.",
  },
  {
    label: "Iterate freely.",
    body: "Each follow-up extends the existing report.",
    example: "Add a state-level breakdown. Also fit a Pareto. Audit this.",
  },
  {
    label: "Ask why.",
    body: "Methodology and source citations are always one question away.",
    example: "Why chain ladder here and not BF?",
  },
];
---

<Layout
  title="The Agents · Tesora"
  description="The Tesora Actuarial Workbench and its agents. Built for chief actuaries at specialty P&C carriers and MGAs. Ingest messy data, build and deploy raters, run standard pricing analyses, audit and share."
  canonical="/agents"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/agents-loop.mp4")}
    headline="Agents designed for actuaries."
    deck="Claude and Codex never read the CAS syllabus. The Workbench did. Built around Werner and Modlin's Basic Ratemaking, the CAS papers, and the audit standards a chief actuary signs against. CAS-credentialed P&C teams today; SOA and IFoA come next."
    primaryCta={{ label: "Request a walkthrough", href: "https://cal.com/team/tesora/quick-chat" }}
    secondaryCta={{ label: "Why this is different", href: "#sniff-test" }}
  />

  {/* Workbench / Harness positioning */}
  <section id="harness" class="border-b border-[var(--rule)] bg-[var(--bg)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20">
      <div class="grid md:grid-cols-12 gap-10 md:gap-14 items-start mb-12">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">What we built</p>
          <h2 class="font-semibold text-[2rem] md:text-[2.25rem] leading-[1.1] tracking-[-0.015em]">
            A workbench on top of a harness.
          </h2>
        </div>
        <div class="md:col-span-7">
          <p class="text-[1.0625rem] leading-[1.65] text-[var(--fg-muted)]">
            The Workbench is what an actuary sees. Chat, tabs, side-by-side quotes, the place you sign off. The Harness is what runs underneath. A set of specialist agents, each with its own scope, guardrails, and audit trail.
          </p>
          <p class="mt-4 text-[1.0625rem] leading-[1.65] text-[var(--fg-muted)]">
            Most AI products give you a chat. We built the harness first, then put a workbench on it. The harness is the part that took two years to get right; the workbench is how you talk to it.
          </p>
        </div>
      </div>

      <HarnessDiagram />
    </div>
  </section>

  {/* Built for the syllabus */}
  <section id="sniff-test" class="border-b border-[var(--rule)] bg-[var(--bg)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
      <div class="grid md:grid-cols-12 gap-8">
        <div class="md:col-span-5 reveal">
          <p class="eyebrow mb-3">What you'd otherwise do</p>
          <h2 class="font-semibold text-[2rem] md:text-[2.25rem] leading-[1.1] tracking-[-0.015em]">
            The status quo.
          </h2>
          <p class="mt-4 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
            There are three ways to do this work today. Push the team harder, credentialed people who already have better things to do at midnight than reformat loss runs. Build internal Excel macros and Python notebooks, which stop the pain but will not survive a regulator's question. Or reach for a general model like Claude, which knows the words but not the standards. The Workbench is built to be a better answer than any of them.
          </p>
        </div>
        <div class="md:col-span-7 grid md:grid-cols-2 gap-3 self-center">
          <div class="lesson-tile reveal" data-reveal-delay="0">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Syllabus</p>
            <p class="lesson-tile-title">Trained on the syllabus.</p>
            <p class="lesson-tile-body">
              Werner and Modlin's Basic Ratemaking, Friedland on reserving, the full CAS exam reading list, and a corpus of SERFF filings. The model knows the terminology and the conventions before it touches your book.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="120">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Citations</p>
            <p class="lesson-tile-title">Citations or it didn't happen.</p>
            <p class="lesson-tile-body">
              Every base rate, factor, credit, and trend number traces back to the page and cell it came from. If the agent can't cite it, it can't ship it.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="240">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Audit</p>
            <p class="lesson-tile-title">Audited before the rate committee sees it.</p>
            <p class="lesson-tile-body">
              A specialist audit agent regrades every analysis against CAS Statements of Principles before the committee sees it. Author, reviewer, and approver are separate identities. Every promotion is recorded.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="360">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Continuity</p>
            <p class="lesson-tile-title">Your team took the exams once.</p>
            <p class="lesson-tile-body">
              Credentialed actuaries spend a decade leading, not re-reading the syllabus. The audit agent stays current on CAS papers, Statements of Principles, and new exam material every day. Your team ships work that holds up to a fresh-from-exam reviewer, under their own name.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="480">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Context</p>
            <p class="lesson-tile-title">General agents lose the thread.</p>
            <p class="lesson-tile-body">
              Claude, Codex, and GPT were not trained on Werner and Modlin, Friedland, or the CAS Statements of Principles. They sound right for one prompt and then drift. The Workbench was trained on the frameworks an actuary signs against, and holds them across the full engagement.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="600">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Toolchain</p>
            <p class="lesson-tile-title">VBA and Python duct-tape the pain.</p>
            <p class="lesson-tile-body">
              Internal Excel macros and Python notebooks stop the sharp pain. They don't survive a regulator's question, a model-risk review, or a year of staff turnover. The Workbench is the long-term substrate: typed, versioned, auditable, and not stranded with one analyst.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Time back, per workflow */}
  <section class="border-b border-[var(--rule)] bg-[var(--bg)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-10">
      <p class="eyebrow mb-5">Time back, per workflow</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-6">
        <div class="reveal">
          <p class="font-mono text-[1.5rem] leading-none tabular-nums text-[var(--fg)] tracking-tight">
            3 weeks <span class="text-[var(--color-oxblood)]">→</span> 10 min
          </p>
          <p class="mt-3 text-sm font-semibold text-[var(--fg)]">Rater from a competitor's filing.</p>
          <p class="mt-1 text-sm text-[var(--fg-muted)] leading-snug">Read the SERFF filing, reconstruct the rate plan, stand up a callable quoting API.</p>
        </div>
        <div class="md:border-l md:border-[var(--rule)] md:pl-6 reveal" data-reveal-delay="120">
          <p class="font-mono text-[1.5rem] leading-none tabular-nums text-[var(--fg)] tracking-tight">
            2 days <span class="text-[var(--color-oxblood)]">→</span> 5 min
          </p>
          <p class="mt-3 text-sm font-semibold text-[var(--fg)]">Loss-run normalization across carriers.</p>
          <p class="mt-1 text-sm text-[var(--fg-muted)] leading-snug">Five carriers, five formats, one normalized table.</p>
        </div>
        <div class="md:border-l md:border-[var(--rule)] md:pl-6 reveal" data-reveal-delay="240">
          <p class="font-mono text-[1.5rem] leading-none tabular-nums text-[var(--fg)] tracking-tight">
            1 week <span class="text-[var(--color-oxblood)]">→</span> 1 hr
          </p>
          <p class="mt-3 text-sm font-semibold text-[var(--fg)]">Rate-committee brief.</p>
          <p class="mt-1 text-sm text-[var(--fg-muted)] leading-snug">Filing diffs, class-level trends, every claim cited.</p>
        </div>
      </div>
      <p class="mt-6 text-xs text-[var(--fg-muted)] leading-relaxed max-w-[860px]">
        Pilot benchmarks from specialty P&amp;C teams. Your Day-0 baseline is the only number we promise to beat.
      </p>
    </div>
  </section>

  {/* Workflows 01–04 */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-12">
    {workflows.map((w, i) => (
      <article
        id={w.num === "02" ? "rating" : w.num === "03" ? "insight" : undefined}
        class="grid md:grid-cols-12 gap-8 md:gap-12 py-10 border-t border-[var(--rule)] first:border-t-0 scroll-mt-24 reveal"
      >
        <div class="md:col-span-5">
          <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{w.num}</p>
          <h2 class="mt-2 font-semibold text-[1.625rem] md:text-[1.875rem] leading-[1.1] tracking-[-0.015em]">{w.title}</h2>
          <p class="mt-3 text-[1rem] leading-[1.55] text-[var(--fg-muted)]">{w.body}</p>
        </div>
        <ul class="md:col-span-7 flex flex-col gap-3 self-center">
          {w.outcomes.map((line) => (
            <li class="flex gap-3 items-start">
              <span class="mt-[0.6rem] inline-block h-px w-5 bg-[var(--color-oxblood,#4338CA)]/70 flex-shrink-0" aria-hidden="true"></span>
              <p class="text-[1rem] leading-[1.45] text-[var(--fg)]">{line}</p>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <Lifecycle />

  {/* How to work with the Workbench */}
  <section id="workbench" class="bg-[var(--bg-panel)] border-y border-[var(--rule)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-14">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-oxblood,#4338CA)]" aria-hidden="true"></span>
        <p class="eyebrow">How to work with the Workbench</p>
      </div>
      <div class="grid md:grid-cols-4 gap-8 items-stretch">
        {workbenchPatterns.map((p) => (
          <div class="flex flex-col h-full">
            <p class="font-semibold text-[1rem]">{p.label}</p>
            <p class="mt-2 text-[0.9375rem] leading-[1.55] text-[var(--fg-muted)]">{p.body}</p>
            <p class="mt-auto pt-4 text-[0.9375rem] italic leading-[1.5] text-[var(--fg)] border-l-2 border-[var(--color-oxblood,#6b1a1a)] pl-3">
              "{p.example}"
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Frequently asked questions */}
  <section id="faq" class="border-t border-[var(--rule)] bg-[var(--bg)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
      <div class="grid md:grid-cols-12 gap-10 mb-8">
        <div class="md:col-span-5 reveal">
          <p class="eyebrow mb-3">FAQ</p>
          <h2 class="font-semibold text-[2rem] md:text-[2.25rem] leading-[1.1] tracking-[-0.015em]">
            Frequently asked questions.
          </h2>
        </div>
        <div class="md:col-span-7 reveal" data-reveal-delay="120">
          <p class="eyebrow mb-3 invisible select-none" aria-hidden="true">FAQ</p>
          <p class="text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
            Common questions from chief actuaries, pricing teams, and the IT and risk officers who review us alongside them.
          </p>
        </div>
      </div>

      <div class="border-t border-[var(--rule)]">
        {faqs.map((f, i) => (
          <details class="group border-b border-[var(--rule)] reveal" data-reveal-delay={String(i * 80)}>
            <summary class="flex items-start gap-4 py-5 cursor-pointer list-none">
              <span class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase mt-1 w-8 flex-shrink-0">{String(i + 1).padStart(2, "0")}</span>
              <span class="flex-1 font-semibold text-[1.0625rem] leading-[1.4] tracking-[-0.005em] text-[var(--fg)]">{f.q}</span>
              <span
                aria-hidden="true"
                class="ml-3 mt-1 inline-flex h-6 w-6 items-center justify-center rounded-full border border-[var(--rule)] text-[var(--fg-muted)] transition-transform group-open:rotate-45 flex-shrink-0"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3">
                  <path d="M12 5v14" />
                  <path d="M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="pl-12 pr-10 pb-6 text-[0.9375rem] leading-[1.65] text-[var(--fg-muted)]">
              {f.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
