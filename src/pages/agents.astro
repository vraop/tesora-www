---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import VideoBand from "../components/VideoBand.astro";
import { u } from "../lib/url";

type Feature = { label: string; body: string; wip?: boolean };
type Workflow = { num: string; title: string; intro: string; features: Feature[] };

const workflows: Workflow[] = [
  {
    num: "01",
    title: "Trustworthy data ingestion and cleaning.",
    intro: "Load the messy stuff. Turn it into something you can actually analyze.",
    features: [
      { label: "Upload anything", body: "Loss runs, SOVs, exposure files, rate manuals, filings, objection letters. PDF, Excel, CSV, Word." },
      { label: "Auto-classification and extraction", body: "Documents are read, tagged (loss run vs. SOV vs. filing), and key data is pulled out for you." },
      { label: "Normalization", body: "Multiple carriers' loss runs reshaped into one consistent table you can work with." },
      { label: "Anomaly detection", body: "Triangle outliers, suspicious development factors, missing periods, duplicate claims, exposure-base mismatches." },
      { label: "Source citations", body: "Every number traces back to the exact page and cell in the original document. Click any value to see where it came from." },
    ],
  },
  {
    num: "02",
    title: "Build, test, and deploy raters.",
    intro: "Turn a rate manual or filing into a working, production-ready pricing model.",
    features: [
      { label: "Rater construction", body: "Base rates, territory factors, class factors, ILFs, schedule mods, minimum premiums." },
      { label: "One-click deployment", body: "Every new rater ships with a callable API and a quoting UI. No engineering ticket, no separate release." },
      { label: "SOX-compliant controls", body: "Author / reviewer / approver separation, full audit trail, immutable version history, required sign-off before a rater goes live." },
      { label: "Side-by-side comparison", body: "Quote the same risk through old vs. new plan, your rater vs. a competitor's, current filing vs. proposed." },
      { label: "Test cases and regressions", body: "Store known-good inputs and expected premiums. Re-run after every change." },
    ],
  },
  {
    num: "03",
    title: "Run the standard analyses.",
    intro: "Ask in plain English. Get a full report with charts and commentary.",
    features: [
      { label: "Pricing", body: "Loss trend, on-leveling, loss-cost, credibility weighting, rate adequacy, expense build-ups." },
      { label: "Distribution fitting", body: "Lognormal, Pareto, Poisson, Weibull, Negative Binomial with AIC selection." },
      { label: "Risk metrics", body: "VaR, TVaR, aggregate loss simulation, large-loss frequency." },
      { label: "Reinsurance structuring", body: "XOL layers, aggregate stop-loss, attachment sensitivity, cession analysis." },
      { label: "Coverage and portfolio cuts", body: "By line, state, year, segment, cap tier, sector." },
      { label: "Reserving", body: "Loss triangles, age-to-age factors, chain-ladder, Bornhuetter-Ferguson, IBNR, frequency-severity.", wip: true },
    ],
  },
  {
    num: "04",
    title: "Compare, audit, and share.",
    intro: "Iterate on the work, not just deliver it.",
    features: [
      { label: "Reports are living documents", body: "Ask for a new chart, an extra year, a different segmentation. The report extends rather than restarts." },
      { label: "Side-by-side scenarios", body: "Compare methods (chain ladder vs. BF), assumptions (3% vs. 5% trend), or programs (current vs. proposed structure)." },
      { label: "Automatic audit", body: "Every analysis is reviewed by a specialist agent against actuarial best practice. Critical and major issues are flagged and fixed before hand-off." },
      { label: "Best-practice consults", body: "The Copilot cites internal actuarial docs when picking a method, so you can see why it chose what it did." },
      { label: "Artifact panel", body: "Every workflow becomes a tab with the spreadsheet, charts, and narrative your reviewer or underwriter can open directly." },
    ],
  },
];

const copilotPatterns = [
  {
    label: "Be conversational.",
    body: "Type what you would say to a junior analyst.",
    example: "Trend these losses to 2026 at 4%.",
  },
  {
    label: "Point at data.",
    body: "Tell it which vault or file to use.",
    example: "Use the loss run in the Q1 vault.",
  },
  {
    label: "Iterate freely.",
    body: "Each follow-up extends the existing report.",
    example: "Add a state-level breakdown. Also fit a Pareto. Audit this.",
  },
  {
    label: "Ask why.",
    body: "Methodology and source citations are always one question away.",
    example: "Why chain ladder here and not BF?",
  },
];
---

<Layout
  title="The Agents · Tesora"
  description="The Tesora Actuarial Workbench and its agents. Ingest messy data, build and deploy raters, run standard pricing analyses, audit and share. The Copilot runs the spreadsheet work and the write-up. You stay in the driver's seat."
  canonical="/agents"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/agents-loop.mp4")}
    headline="Frontier AI for actuaries. Starting with the Workbench."
    deck="The Copilot runs the spreadsheet work, the data wrangling, and the write-up. You stay in the driver's seat."
    primaryCta={{ label: "Request a walkthrough", href: "mailto:founders@tesora.ai?subject=Workbench%20walkthrough" }}
    secondaryCta={{ label: "How to work with the Copilot", href: "#copilot" }}
  />

  {/* Four numbered workflows */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
    {workflows.map((w) => (
      <article class="grid md:grid-cols-12 gap-8 md:gap-12 py-12 border-t border-[var(--rule)] first:border-t-0">
        <div class="md:col-span-4">
          <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{w.num}</p>
          <h2 class="mt-2 font-semibold text-[1.625rem] leading-[1.15] tracking-[-0.01em]">{w.title}</h2>
          <p class="mt-3 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{w.intro}</p>
        </div>
        <ul class="md:col-span-8 grid sm:grid-cols-2 gap-x-8 gap-y-6">
          {w.features.map((f) => (
            <li class="flex gap-3">
              <span
                class="mt-1 inline-block h-2 w-2 rounded-full flex-shrink-0"
                style={`background: ${f.wip ? "var(--color-bone-dim, #c8b48a)" : "var(--color-oxblood, #6b1a1a)"}; opacity: ${f.wip ? "0.5" : "0.85"};`}
                aria-hidden="true"
              ></span>
              <div>
                <p class="font-semibold text-[0.9375rem] leading-tight">
                  {f.label}
                  {f.wip && <span class="ml-2 text-[0.6875rem] uppercase tracking-wider text-[var(--fg-muted)]">in development</span>}
                </p>
                <p class="mt-1 text-[0.875rem] leading-[1.55] text-[var(--fg-muted)]">{f.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <VideoBand
    videoSrc={u("/video/research-loop.mp4")}
    eyebrow="The substrate"
    headline="One typed graph holds the work."
    body="Filings, raters, loss runs, and submissions live in one substrate. The agents reason over it. The actuary signs against it."
  />

  <VideoBand
    videoSrc={u("/video/customers-loop.mp4")}
    eyebrow="Lineage by default"
    headline="Every value carries its citation."
    body="A factor, a base rate, a credit, a quote. Each one traces back to the page and cell it came from. No black box, no hand-waving."
  />

  {/* How to work with the Copilot */}
  <section id="copilot" class="bg-[var(--bg-panel)] border-y border-[var(--rule)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
      <div class="flex items-center gap-3 mb-10">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-oxblood,#6b1a1a)]" aria-hidden="true"></span>
        <p class="eyebrow">How to work with the Copilot</p>
      </div>
      <div class="grid md:grid-cols-4 gap-8">
        {copilotPatterns.map((p) => (
          <div>
            <p class="font-semibold text-[1rem]">{p.label}</p>
            <p class="mt-2 text-[0.9375rem] leading-[1.55] text-[var(--fg-muted)]">{p.body}</p>
            <p class="mt-4 text-[0.9375rem] italic leading-[1.5] text-[var(--fg)] border-l-2 border-[var(--color-oxblood,#6b1a1a)] pl-3">
              "{p.example}"
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
