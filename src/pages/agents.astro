---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import VideoBand from "../components/VideoBand.astro";
import { u } from "../lib/url";

type Workflow = { num: string; title: string; body: string; outcomes: string[] };

const workflows: Workflow[] = [
  {
    num: "01",
    title: "Ingest the mess.",
    body: "Loss runs, SOVs, rate manuals, filings. Any format in. Analyzable data out.",
    outcomes: [
      "PDF, Excel, CSV, Word.",
      "Auto-classified and anomaly-checked.",
      "Every value cites its source cell.",
    ],
  },
  {
    num: "02",
    title: "Build raters that ship.",
    body: "Filing or rate manual to callable pricing API. SOX-grade controls. No engineering ticket.",
    outcomes: [
      "Base rates, factors, ILFs, schedule mods.",
      "Author, reviewer, approver as separate identities.",
      "Side-by-side quotes against any plan or competitor.",
    ],
  },
  {
    num: "03",
    title: "Run the analyses.",
    body: "Ask in plain English. Get charts, methodology, and citations.",
    outcomes: [
      "Trend, on-leveling, distribution fitting, VaR/TVaR.",
      "XOL structuring, aggregate stop-loss, cession.",
      "Reserving (chain-ladder, BF, IBNR). In development.",
    ],
  },
  {
    num: "04",
    title: "Audit and ship.",
    body: "A specialist audit agent grades the work. Every artifact survives the rate committee.",
    outcomes: [
      "Extend reports — new chart, year, or segment.",
      "Graded against CAS best practice.",
      "Every workflow lands as a reviewable tab.",
    ],
  },
];

const workbenchPatterns = [
  {
    label: "Be conversational.",
    body: "Type what you would say to a junior analyst.",
    example: "Trend these losses to 2026 at 4%.",
  },
  {
    label: "Point at data.",
    body: "Tell it which vault or file to use.",
    example: "Use the loss run in the Q1 vault.",
  },
  {
    label: "Iterate freely.",
    body: "Each follow-up extends the existing report.",
    example: "Add a state-level breakdown. Also fit a Pareto. Audit this.",
  },
  {
    label: "Ask why.",
    body: "Methodology and source citations are always one question away.",
    example: "Why chain ladder here and not BF?",
  },
];
---

<Layout
  title="The Agents · Tesora"
  description="The Tesora Actuarial Workbench and its agents. Built for chief actuaries at specialty P&C carriers and MGAs. Ingest messy data, build and deploy raters, run standard pricing analyses, audit and share."
  canonical="/agents"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/agents-loop.mp4")}
    headline="Agents designed for actuaries."
    deck="Claude and Codex never read the CAS syllabus. The Workbench did. Built around Werner and Modlin's Basic Ratemaking, the CAS papers, and the audit standards a chief actuary signs against. CAS-credentialed P&C teams today; SOA and IFoA come next."
    primaryCta={{ label: "Request a walkthrough", href: "https://cal.com/team/tesora/quick-chat" }}
    secondaryCta={{ label: "Why this is different", href: "#sniff-test" }}
  />

  {/* Built for the syllabus */}
  <section id="sniff-test" class="border-b border-[var(--rule)] bg-[var(--bg)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
      <div class="grid md:grid-cols-12 gap-8">
        <div class="md:col-span-5 reveal">
          <p class="eyebrow mb-3">Passes the sniff test</p>
          <h2 class="font-semibold text-[2rem] md:text-[2.25rem] leading-[1.1] tracking-[-0.015em]">
            The competition isn't only Claude.
          </h2>
          <p class="mt-4 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
            General-purpose models stay plausible for one turn and lose the actuarial load by turn six. VBA macros and Python notebooks duct-tape the sharp pain without surviving a regulator's question. Your team is credentialed but stretched. Actuarial work has to hold up to all three. The Workbench raises the bar on every front.
          </p>
        </div>
        <div class="md:col-span-7 grid md:grid-cols-2 gap-3 self-center">
          <div class="lesson-tile reveal" data-reveal-delay="0">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Syllabus</p>
            <p class="lesson-tile-title">Trained on the syllabus.</p>
            <p class="lesson-tile-body">
              Werner and Modlin's Basic Ratemaking, Friedland on reserving, the full CAS exam reading list, and a corpus of SERFF filings. The model knows the terminology and the conventions before it touches your book.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="120">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Citations</p>
            <p class="lesson-tile-title">Citations or it didn't happen.</p>
            <p class="lesson-tile-body">
              Every base rate, factor, credit, and trend number traces back to the page and cell it came from. If the agent can't cite it, it can't ship it.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="240">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Audit</p>
            <p class="lesson-tile-title">Audited before the rate committee sees it.</p>
            <p class="lesson-tile-body">
              A specialist audit agent regrades every analysis against CAS Statements of Principles and actuarial best practice. Author, reviewer, and approver are separate identities. SOX-grade history, immutable.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="360">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Continuity</p>
            <p class="lesson-tile-title">Your team took the exams once.</p>
            <p class="lesson-tile-body">
              Credentialed actuaries spend a decade leading, not re-reading the syllabus. The audit agent stays current on CAS papers, Statements of Principles, and new exam material every day. Your team ships work that holds up to a fresh-from-exam reviewer, under their own name.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="480">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Context</p>
            <p class="lesson-tile-title">General agents lose the thread.</p>
            <p class="lesson-tile-body">
              Claude, Codex, and GPT weren't trained on Werner and Modlin, Friedland, or CAS Statements of Principles. They stay plausible for one turn and lose the actuarial load by turn six. The Workbench is opinionated by the best frameworks the profession has, and stays opinionated across the whole engagement.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="600">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Toolchain</p>
            <p class="lesson-tile-title">VBA and Python duct-tape the pain.</p>
            <p class="lesson-tile-body">
              Internal Excel macros and Python notebooks stop the sharp pain. They don't survive a regulator's question, a model-risk review, or a year of staff turnover. The Workbench is the long-term substrate: typed, versioned, auditable, and not stranded with one analyst.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Time back, per workflow */}
  <section class="border-b border-[var(--rule)] bg-[var(--bg)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-10">
      <p class="eyebrow mb-5">Time back, per workflow</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-6">
        <div class="reveal">
          <p class="font-mono text-[1.5rem] leading-none tabular-nums text-[var(--fg)] tracking-tight">
            3 weeks <span class="text-[var(--color-oxblood)]">→</span> 10 min
          </p>
          <p class="mt-3 text-sm font-semibold text-[var(--fg)]">Rater from a competitor's filing.</p>
          <p class="mt-1 text-sm text-[var(--fg-muted)] leading-snug">Read the SERFF filing, reconstruct the rate plan, stand up a callable quoting API.</p>
        </div>
        <div class="md:border-l md:border-[var(--rule)] md:pl-6 reveal" data-reveal-delay="120">
          <p class="font-mono text-[1.5rem] leading-none tabular-nums text-[var(--fg)] tracking-tight">
            2 days <span class="text-[var(--color-oxblood)]">→</span> 5 min
          </p>
          <p class="mt-3 text-sm font-semibold text-[var(--fg)]">Loss-run normalization across carriers.</p>
          <p class="mt-1 text-sm text-[var(--fg-muted)] leading-snug">Five carriers, five formats, one normalized table.</p>
        </div>
        <div class="md:border-l md:border-[var(--rule)] md:pl-6 reveal" data-reveal-delay="240">
          <p class="font-mono text-[1.5rem] leading-none tabular-nums text-[var(--fg)] tracking-tight">
            1 week <span class="text-[var(--color-oxblood)]">→</span> 1 hr
          </p>
          <p class="mt-3 text-sm font-semibold text-[var(--fg)]">Rate-committee brief.</p>
          <p class="mt-1 text-sm text-[var(--fg-muted)] leading-snug">Filing diffs, class-level trends, every claim cited.</p>
        </div>
      </div>
      <p class="mt-6 text-xs text-[var(--fg-muted)] leading-relaxed max-w-[860px]">
        Pilot benchmarks from specialty P&amp;C teams. Your Day-0 baseline is the only number we promise to beat.
      </p>
    </div>
  </section>

  {/* Workflows 01 + 02 */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-12">
    {workflows.slice(0, 2).map((w) => (
      <article class="grid md:grid-cols-12 gap-8 md:gap-12 py-10 border-t border-[var(--rule)] first:border-t-0 reveal">
        <div class="md:col-span-5">
          <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{w.num}</p>
          <h2 class="mt-2 font-semibold text-[1.625rem] md:text-[1.875rem] leading-[1.1] tracking-[-0.015em]">{w.title}</h2>
          <p class="mt-3 text-[1rem] leading-[1.55] text-[var(--fg-muted)]">{w.body}</p>
        </div>
        <ul class="md:col-span-7 flex flex-col gap-3 self-center">
          {w.outcomes.map((line) => (
            <li class="flex gap-3 items-start">
              <span class="mt-[0.6rem] inline-block h-px w-5 bg-[var(--color-oxblood,#4338CA)]/70 flex-shrink-0" aria-hidden="true"></span>
              <p class="text-[1rem] leading-[1.45] text-[var(--fg)]">{line}</p>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <VideoBand
    videoSrc={u("/video/research-loop.mp4")}
    eyebrow="The substrate"
    headline="One typed graph holds the work."
    body="Filings, raters, loss runs, and submissions live in one substrate. The agents reason over it. The actuary signs against it."
    height="short"
    align="center"
  />

  {/* Workflows 03 + 04 */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-12">
    {workflows.slice(2, 4).map((w) => (
      <article class="grid md:grid-cols-12 gap-8 md:gap-12 py-10 border-t border-[var(--rule)] first:border-t-0 reveal">
        <div class="md:col-span-5">
          <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{w.num}</p>
          <h2 class="mt-2 font-semibold text-[1.625rem] md:text-[1.875rem] leading-[1.1] tracking-[-0.015em]">{w.title}</h2>
          <p class="mt-3 text-[1rem] leading-[1.55] text-[var(--fg-muted)]">{w.body}</p>
        </div>
        <ul class="md:col-span-7 flex flex-col gap-3 self-center">
          {w.outcomes.map((line) => (
            <li class="flex gap-3 items-start">
              <span class="mt-[0.6rem] inline-block h-px w-5 bg-[var(--color-oxblood,#4338CA)]/70 flex-shrink-0" aria-hidden="true"></span>
              <p class="text-[1rem] leading-[1.45] text-[var(--fg)]">{line}</p>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <VideoBand
    videoSrc={u("/video/customers-loop.mp4")}
    eyebrow="Lineage by default"
    headline="Every value carries its citation."
    body="A factor, a base rate, a credit, a quote. Each one traces back to the page and cell it came from."
    height="short"
    align="center"
  />

  {/* How to work with the Workbench */}
  <section id="workbench" class="bg-[var(--bg-panel)] border-y border-[var(--rule)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-14">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-oxblood,#4338CA)]" aria-hidden="true"></span>
        <p class="eyebrow">How to work with the Workbench</p>
      </div>
      <div class="grid md:grid-cols-4 gap-8">
        {workbenchPatterns.map((p) => (
          <div>
            <p class="font-semibold text-[1rem]">{p.label}</p>
            <p class="mt-2 text-[0.9375rem] leading-[1.55] text-[var(--fg-muted)]">{p.body}</p>
            <p class="mt-4 text-[0.9375rem] italic leading-[1.5] text-[var(--fg)] border-l-2 border-[var(--color-oxblood,#6b1a1a)] pl-3">
              "{p.example}"
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
