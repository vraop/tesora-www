---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import VideoBand from "../components/VideoBand.astro";
import { u } from "../lib/url";

type Workflow = { num: string; title: string; body: string; outcomes: string[] };

const workflows: Workflow[] = [
  {
    num: "01",
    title: "Ingest the messy stuff.",
    body: "Load loss runs, SOVs, filings, and rate manuals in any format. Tesora reads them back as data you can analyze.",
    outcomes: [
      "PDF, Excel, CSV, Word.",
      "Auto-classified, normalized, anomaly-checked.",
      "Every value cites the page and cell it came from.",
    ],
  },
  {
    num: "02",
    title: "Build, test, and deploy raters.",
    body: "From a filing or rate manual to a callable pricing API. SOX-grade controls, regression tests, no engineering ticket.",
    outcomes: [
      "Base rates, territory and class factors, ILFs, schedule mods.",
      "Author / reviewer / approver separation. Immutable history.",
      "Side-by-side quotes against current plan or a competitor's.",
    ],
  },
  {
    num: "03",
    title: "Run the standard analyses.",
    body: "Ask in plain English. Get a report with charts, methodology, and citations.",
    outcomes: [
      "Loss trend, on-leveling, distribution fitting, VaR / TVaR.",
      "XOL structuring, aggregate stop-loss, cession analysis.",
      "Reserving — chain-ladder, BF, IBNR. In development.",
    ],
  },
  {
    num: "04",
    title: "Compare, audit, and share.",
    body: "Iterate on the work, not just deliver it. A specialist audit agent catches issues before hand-off.",
    outcomes: [
      "Reports extend — new chart, new year, new segmentation.",
      "Audit agent grades every analysis against actuarial best practice.",
      "Every workflow lands as a tab a reviewer can open.",
    ],
  },
];

const workbenchPatterns = [
  {
    label: "Be conversational.",
    body: "Type what you would say to a junior analyst.",
    example: "Trend these losses to 2026 at 4%.",
  },
  {
    label: "Point at data.",
    body: "Tell it which vault or file to use.",
    example: "Use the loss run in the Q1 vault.",
  },
  {
    label: "Iterate freely.",
    body: "Each follow-up extends the existing report.",
    example: "Add a state-level breakdown. Also fit a Pareto. Audit this.",
  },
  {
    label: "Ask why.",
    body: "Methodology and source citations are always one question away.",
    example: "Why chain ladder here and not BF?",
  },
];
---

<Layout
  title="The Agents · Tesora"
  description="The Tesora Actuarial Workbench and its agents. Built for chief actuaries at specialty P&C carriers and MGAs. Ingest messy data, build and deploy raters, run standard pricing analyses, audit and share."
  canonical="/agents"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/agents-loop.mp4")}
    headline="Agents designed for actuaries."
    deck="Claude and Codex never read the CAS syllabus. The Workbench did. Built around Werner and Modlin's Basic Ratemaking, the CAS papers, and the audit standards a chief actuary signs against. CAS-credentialed P&C teams today; SOA and IFoA come next."
    primaryCta={{ label: "Request a walkthrough", href: "mailto:founders@tesora.ai?subject=Workbench%20walkthrough" }}
    secondaryCta={{ label: "Why this is different", href: "#sniff-test" }}
  />

  {/* Built for the syllabus */}
  <section id="sniff-test" class="border-b border-[var(--rule)] bg-[var(--bg)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">Passes the sniff test</p>
          <h2 class="font-semibold text-[2rem] md:text-[2.25rem] leading-[1.1] tracking-[-0.015em]">
            A general model is not an actuary.
          </h2>
          <p class="mt-5 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
            General-purpose code agents were trained to be plausible. Actuarial work has to be defensible. Two different jobs.
          </p>
        </div>
        <div class="md:col-span-7 grid md:grid-cols-2 gap-x-10 gap-y-8 self-center">
          <div>
            <p class="font-semibold text-[1rem]">Trained on the syllabus.</p>
            <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">
              Werner and Modlin's Basic Ratemaking, Friedland on reserving, the full CAS exam reading list, and a corpus of SERFF filings. The model knows the terminology and the conventions before it touches your book.
            </p>
          </div>
          <div>
            <p class="font-semibold text-[1rem]">Citations or it didn't happen.</p>
            <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">
              Every base rate, factor, credit, and trend number traces back to the page and cell it came from. If the agent can't cite it, it can't ship it.
            </p>
          </div>
          <div>
            <p class="font-semibold text-[1rem]">Audited before the rate committee sees it.</p>
            <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">
              A specialist audit agent regrades every analysis against CAS Statements of Principles and actuarial best practice. Author, reviewer, and approver are separate identities. SOX-grade history, immutable.
            </p>
          </div>
          <div>
            <p class="font-semibold text-[1rem]">CAS first, on purpose.</p>
            <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">
              Property &amp; casualty pricing is the line we know cold. SOA practice areas and IFoA-credentialed teams come once the substrate is hardened where it lives today.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Time back, per workflow */}
  <section class="border-b border-[var(--rule)] bg-[var(--bg)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
      <p class="eyebrow mb-8">Time back, per workflow</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-6">
        <div>
          <p class="font-mono text-[1.5rem] leading-none tabular-nums text-[var(--fg)] tracking-tight">
            3 weeks <span class="text-[var(--color-oxblood)]">→</span> 10 min
          </p>
          <p class="mt-4 text-sm font-semibold text-[var(--fg)]">Rater from a competitor's filing.</p>
          <p class="mt-1 text-sm text-[var(--fg-muted)] leading-snug">Tesora reads the SERFF filing, reconstructs the rate plan, and stands up a callable quoting API.</p>
        </div>
        <div class="md:border-l md:border-[var(--rule)] md:pl-6">
          <p class="font-mono text-[1.5rem] leading-none tabular-nums text-[var(--fg)] tracking-tight">
            2 days <span class="text-[var(--color-oxblood)]">→</span> 5 min
          </p>
          <p class="mt-4 text-sm font-semibold text-[var(--fg)]">Loss-run normalization across carriers.</p>
          <p class="mt-1 text-sm text-[var(--fg-muted)] leading-snug">Five carriers, five formats, one normalized table you can run the standard analyses on.</p>
        </div>
        <div class="md:border-l md:border-[var(--rule)] md:pl-6">
          <p class="font-mono text-[1.5rem] leading-none tabular-nums text-[var(--fg)] tracking-tight">
            1 week <span class="text-[var(--color-oxblood)]">→</span> 1 hr
          </p>
          <p class="mt-4 text-sm font-semibold text-[var(--fg)]">Rate-committee brief.</p>
          <p class="mt-1 text-sm text-[var(--fg-muted)] leading-snug">Filing diffs, class-level trends, and a defensible narrative, with every claim cited back to the filing.</p>
        </div>
      </div>
      <p class="mt-10 text-xs text-[var(--fg-muted)] leading-relaxed max-w-[860px]">
        Benchmarks from pilot work with specialty P&amp;C teams. Your own baseline, graded on Day 0, is the only number we promise to beat.
      </p>
    </div>
  </section>

  {/* Workflows 01 + 02 */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-32">
    {workflows.slice(0, 2).map((w) => (
      <article class="grid md:grid-cols-12 gap-10 md:gap-16 py-20 border-t border-[var(--rule)] first:border-t-0">
        <div class="md:col-span-5">
          <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{w.num}</p>
          <h2 class="mt-3 font-semibold text-[2rem] md:text-[2.25rem] leading-[1.1] tracking-[-0.015em]">{w.title}</h2>
          <p class="mt-5 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">{w.body}</p>
        </div>
        <ul class="md:col-span-7 flex flex-col gap-5 self-center">
          {w.outcomes.map((line) => (
            <li class="flex gap-4 items-start">
              <span class="mt-[0.65rem] inline-block h-px w-6 bg-[var(--color-oxblood,#6b1a1a)]/70 flex-shrink-0" aria-hidden="true"></span>
              <p class="text-[1.0625rem] leading-[1.5] text-[var(--fg)]">{line}</p>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <VideoBand
    videoSrc={u("/video/research-loop.mp4")}
    eyebrow="The substrate"
    headline="One typed graph holds the work."
    body="Filings, raters, loss runs, and submissions live in one substrate. The agents reason over it. The actuary signs against it."
    height="tall"
    align="center"
  />

  {/* Workflows 03 + 04 */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-32">
    {workflows.slice(2, 4).map((w) => (
      <article class="grid md:grid-cols-12 gap-10 md:gap-16 py-20 border-t border-[var(--rule)] first:border-t-0">
        <div class="md:col-span-5">
          <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{w.num}</p>
          <h2 class="mt-3 font-semibold text-[2rem] md:text-[2.25rem] leading-[1.1] tracking-[-0.015em]">{w.title}</h2>
          <p class="mt-5 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">{w.body}</p>
        </div>
        <ul class="md:col-span-7 flex flex-col gap-5 self-center">
          {w.outcomes.map((line) => (
            <li class="flex gap-4 items-start">
              <span class="mt-[0.65rem] inline-block h-px w-6 bg-[var(--color-oxblood,#6b1a1a)]/70 flex-shrink-0" aria-hidden="true"></span>
              <p class="text-[1.0625rem] leading-[1.5] text-[var(--fg)]">{line}</p>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <VideoBand
    videoSrc={u("/video/customers-loop.mp4")}
    eyebrow="Lineage by default"
    headline="Every value carries its citation."
    body="A factor, a base rate, a credit, a quote. Each one traces back to the page and cell it came from."
    height="tall"
    align="center"
  />

  {/* How to work with the Workbench */}
  <section id="workbench" class="bg-[var(--bg-panel)] border-y border-[var(--rule)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
      <div class="flex items-center gap-3 mb-10">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-oxblood,#4338CA)]" aria-hidden="true"></span>
        <p class="eyebrow">How to work with the Workbench</p>
      </div>
      <div class="grid md:grid-cols-4 gap-8">
        {workbenchPatterns.map((p) => (
          <div>
            <p class="font-semibold text-[1rem]">{p.label}</p>
            <p class="mt-2 text-[0.9375rem] leading-[1.55] text-[var(--fg-muted)]">{p.body}</p>
            <p class="mt-4 text-[0.9375rem] italic leading-[1.5] text-[var(--fg)] border-l-2 border-[var(--color-oxblood,#6b1a1a)] pl-3">
              "{p.example}"
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
