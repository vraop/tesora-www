---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import VideoBand from "../components/VideoBand.astro";
import { u } from "../lib/url";

type Workflow = { num: string; title: string; body: string; outcomes: string[] };

const workflows: Workflow[] = [
  {
    num: "01",
    title: "Ingest the messy stuff.",
    body: "Load loss runs, SOVs, filings, and rate manuals in any format. Tesora reads them back as data you can analyze.",
    outcomes: [
      "PDF, Excel, CSV, Word.",
      "Auto-classified, normalized, anomaly-checked.",
      "Every value cites the page and cell it came from.",
    ],
  },
  {
    num: "02",
    title: "Build, test, and deploy raters.",
    body: "From a filing or rate manual to a callable pricing API. SOX-grade controls, regression tests, no engineering ticket.",
    outcomes: [
      "Base rates, territory and class factors, ILFs, schedule mods.",
      "Author / reviewer / approver separation. Immutable history.",
      "Side-by-side quotes against current plan or a competitor's.",
    ],
  },
  {
    num: "03",
    title: "Run the standard analyses.",
    body: "Ask in plain English. Get a report with charts, methodology, and citations.",
    outcomes: [
      "Loss trend, on-leveling, distribution fitting, VaR / TVaR.",
      "XOL structuring, aggregate stop-loss, cession analysis.",
      "Reserving — chain-ladder, BF, IBNR. In development.",
    ],
  },
  {
    num: "04",
    title: "Compare, audit, and share.",
    body: "Iterate on the work, not just deliver it. A specialist audit agent catches issues before hand-off.",
    outcomes: [
      "Reports extend — new chart, new year, new segmentation.",
      "Audit agent grades every analysis against actuarial best practice.",
      "Every workflow lands as a tab a reviewer can open.",
    ],
  },
];

const copilotPatterns = [
  {
    label: "Be conversational.",
    body: "Type what you would say to a junior analyst.",
    example: "Trend these losses to 2026 at 4%.",
  },
  {
    label: "Point at data.",
    body: "Tell it which vault or file to use.",
    example: "Use the loss run in the Q1 vault.",
  },
  {
    label: "Iterate freely.",
    body: "Each follow-up extends the existing report.",
    example: "Add a state-level breakdown. Also fit a Pareto. Audit this.",
  },
  {
    label: "Ask why.",
    body: "Methodology and source citations are always one question away.",
    example: "Why chain ladder here and not BF?",
  },
];
---

<Layout
  title="The Agents · Tesora"
  description="The Tesora Actuarial Workbench and its agents. Ingest messy data, build and deploy raters, run standard pricing analyses, audit and share. The Copilot runs the spreadsheet work and the write-up. You stay in the driver's seat."
  canonical="/agents"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/agents-loop.mp4")}
    headline="Frontier AI for actuaries. Starting with the Workbench."
    deck="The Copilot runs the spreadsheet work, the data wrangling, and the write-up. You stay in the driver's seat."
    primaryCta={{ label: "Request a walkthrough", href: "mailto:founders@tesora.ai?subject=Workbench%20walkthrough" }}
    secondaryCta={{ label: "How to work with the Copilot", href: "#copilot" }}
  />

  {/* Workflows 01 + 02 */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-32">
    {workflows.slice(0, 2).map((w) => (
      <article class="grid md:grid-cols-12 gap-10 md:gap-16 py-20 border-t border-[var(--rule)] first:border-t-0">
        <div class="md:col-span-5">
          <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{w.num}</p>
          <h2 class="mt-3 font-semibold text-[2rem] md:text-[2.25rem] leading-[1.1] tracking-[-0.015em]">{w.title}</h2>
          <p class="mt-5 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">{w.body}</p>
        </div>
        <ul class="md:col-span-7 flex flex-col gap-5 self-center">
          {w.outcomes.map((line) => (
            <li class="flex gap-4 items-start">
              <span class="mt-[0.65rem] inline-block h-px w-6 bg-[var(--color-oxblood,#6b1a1a)]/70 flex-shrink-0" aria-hidden="true"></span>
              <p class="text-[1.0625rem] leading-[1.5] text-[var(--fg)]">{line}</p>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <VideoBand
    videoSrc={u("/video/research-loop.mp4")}
    eyebrow="The substrate"
    headline="One typed graph holds the work."
    body="Filings, raters, loss runs, and submissions live in one substrate. The agents reason over it. The actuary signs against it."
    height="tall"
    align="center"
  />

  {/* Workflows 03 + 04 */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-32">
    {workflows.slice(2, 4).map((w) => (
      <article class="grid md:grid-cols-12 gap-10 md:gap-16 py-20 border-t border-[var(--rule)] first:border-t-0">
        <div class="md:col-span-5">
          <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{w.num}</p>
          <h2 class="mt-3 font-semibold text-[2rem] md:text-[2.25rem] leading-[1.1] tracking-[-0.015em]">{w.title}</h2>
          <p class="mt-5 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">{w.body}</p>
        </div>
        <ul class="md:col-span-7 flex flex-col gap-5 self-center">
          {w.outcomes.map((line) => (
            <li class="flex gap-4 items-start">
              <span class="mt-[0.65rem] inline-block h-px w-6 bg-[var(--color-oxblood,#6b1a1a)]/70 flex-shrink-0" aria-hidden="true"></span>
              <p class="text-[1.0625rem] leading-[1.5] text-[var(--fg)]">{line}</p>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <VideoBand
    videoSrc={u("/video/customers-loop.mp4")}
    eyebrow="Lineage by default"
    headline="Every value carries its citation."
    body="A factor, a base rate, a credit, a quote. Each one traces back to the page and cell it came from."
    height="tall"
    align="center"
  />

  {/* How to work with the Copilot */}
  <section id="copilot" class="bg-[var(--bg-panel)] border-y border-[var(--rule)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
      <div class="flex items-center gap-3 mb-10">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-oxblood,#6b1a1a)]" aria-hidden="true"></span>
        <p class="eyebrow">How to work with the Copilot</p>
      </div>
      <div class="grid md:grid-cols-4 gap-8">
        {copilotPatterns.map((p) => (
          <div>
            <p class="font-semibold text-[1rem]">{p.label}</p>
            <p class="mt-2 text-[0.9375rem] leading-[1.55] text-[var(--fg-muted)]">{p.body}</p>
            <p class="mt-4 text-[0.9375rem] italic leading-[1.5] text-[var(--fg)] border-l-2 border-[var(--color-oxblood,#6b1a1a)] pl-3">
              "{p.example}"
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
