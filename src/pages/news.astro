---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NewsItem from "../components/NewsItem.astro";

const items = [
  {
    date: "2026 · MAY",
    headline: "Tesora names Philo Bishay Head of Actuarial.",
    body: "NEW YORK. Tesora AI today named Philo Bishay as Head of Actuarial. Bishay, a former chief actuary with fifteen years in specialty P&C pricing, will lead actuarial product direction and customer engagement.",
  },
  {
    date: "2025 · OCT",
    headline: "Tesora named top startup finalist at DPW Amsterdam 2025.",
    body: "AMSTERDAM. DPW selected Tesora AI as a top startup finalist at its 2025 Amsterdam summit, recognizing the company's work on AI-driven pricing and procurement workflows for the insurance industry.",
    logo: { slug: "dpw", alt: "DPW Amsterdam" },
  },
  {
    date: "2025 · SEP",
    headline: "Tesora completes Y Combinator S25.",
    body: "NEW YORK. Tesora AI, the AI-native pricing substrate for specialty property and casualty, today announced completion of the Y Combinator Summer 2025 cohort. The program focused on AI-native applications for regulated industries.",
    logo: { slug: "y-combinator", alt: "Y Combinator S25" },
  },
];
---

<Layout
  title="News · Tesora"
  description="Tesora press releases and milestones."
  canonical="/news"
  schemaType="WebPage"
>
  <Header />

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 pt-32 pb-16">
    <div class="max-w-[820px]">
      <p class="eyebrow mb-6">News</p>
      <h1 class="font-semibold text-[3rem] leading-[1.08] tracking-[-0.02em]">
        Press releases and milestones.
      </h1>
      <p class="text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)] mt-7 max-w-[640px]">
        For media inquiries, email <a href="mailto:press@tesora.ai" class="link">press@tesora.ai</a>.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 pb-32">
    {items.map((n) => (
      <NewsItem date={n.date} headline={n.headline} body={n.body} logo={n.logo} />
    ))}
  </section>

  <Footer />
</Layout>
