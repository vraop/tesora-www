---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackgroundsStrip from "../components/BackgroundsStrip.astro";

const team = [
  {
    name: "Vivek Rao",
    role: "Co-founder &amp; CEO",
    body: "Vivek leads AI and product at Tesora. Before Tesora, he was a consultant at McKinsey and a private-equity investor focused on insurance. He sets the wedge and runs the customer motion. Built the first version of the rater himself.",
  },
  {
    name: "Federico Reyes Gomez",
    role: "Co-founder &amp; CTO",
    body: "Federico leads engineering and the substrate. Previously led ML research on graph neural networks for relational and tabular data at Kumo Labs (Stanford). Owns the typed ontology underneath every Tesora agent.",
  },
  {
    name: "Philo Bishay",
    role: "Head of Actuarial",
    body: "Philo is a former chief actuary with fifteen years in the rating function across specialty P&amp;C carriers and MGAs. He steers actuarial product direction and sits in every first call with a chief actuary. Holds FCAS.",
  },
];
---

<Layout
  title="About · Tesora"
  description="Tesora is built by a small team out of New York. McKinsey, Kumo Labs, former chief-actuary depth. Backed by Foundation Capital and Y Combinator."
  canonical="/about"
  schemaType="WebPage"
>
  <Header />

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 pt-32 pb-16">
    <div class="max-w-[820px]">
      <p class="eyebrow mb-6">About</p>
      <h1 class="font-semibold text-[3rem] leading-[1.08] tracking-[-0.02em]">
        Frontier AI for actuaries, built by a team that has actually priced these lines.
      </h1>
      <p class="text-[1.125rem] leading-[1.6] text-[var(--fg-muted)] mt-7 max-w-[680px]">
        Tesora is a small team out of New York. McKinsey and PE on the GTM side, relational-AI research on the engineering side, former chief-actuary depth on the practice side. Backed by Foundation Capital and Y Combinator.
      </p>
    </div>
  </section>

  <BackgroundsStrip />

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
    <p class="eyebrow mb-8">Team</p>
    {team.map((m) => (
      <article class="grid md:grid-cols-12 gap-6 md:gap-10 py-10 border-t border-[var(--rule)] first:border-t-0">
        <div class="md:col-span-4">
          <h3 class="font-semibold text-[1.5rem] leading-[1.2] tracking-[-0.008em]">{m.name}</h3>
          <p class="mt-2 text-sm text-[var(--fg-muted)]" set:html={m.role}></p>
        </div>
        <div class="md:col-span-8">
          <p class="text-[1.0625rem] leading-[1.65] text-[var(--fg)]" set:html={m.body}></p>
        </div>
      </article>
    ))}
  </section>

  <section class="bg-[var(--bg-panel)] border-y border-[var(--rule)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">Investors</p>
          <h2 class="font-semibold text-[2rem] leading-[1.15] tracking-[-0.012em]">
            Foundation Capital. Y Combinator S25.
          </h2>
        </div>
        <div class="md:col-span-7">
          <p class="text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
            Foundation Capital led our seed in early 2026. Y Combinator backed us in the S25 cohort focused on AI-native applications for regulated industries.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-32 text-center">
    <h2 class="font-semibold text-[1.75rem] leading-[1.15] tracking-[-0.01em] max-w-[640px] mx-auto">
      Want to talk to the team?
    </h2>
    <p class="text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)] mt-5 max-w-[520px] mx-auto">
      Vivek reads everything that hits his inbox.
    </p>
    <div class="mt-8">
      <a href="mailto:vivek@tesora.ai" class="btn">vivek@tesora.ai</a>
    </div>
  </section>

  <Footer />
</Layout>
