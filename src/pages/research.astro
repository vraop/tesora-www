---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import { u } from "../lib/url";

const federicoWork = [
  {
    title: "Relational deep learning over enterprise data",
    venue: "Stanford / Kumo Labs · 2024",
    body: "Graph neural networks operating directly on relational tables. Federico's prior research underpins the substrate Tesora uses for filings, raters, exposures, and quotes as a single typed graph.",
    href: "https://relbench.stanford.edu",
    logos: [
      { slug: "stanford", alt: "Stanford" },
      { slug: "kumo", alt: "Kumo Labs" },
    ],
  },
  {
    title: "Learned ontologies for heterogeneous tabular sources",
    venue: "Internal note · 2025",
    body: "How Tesora reconciles SERFF fields, ISO field codes, and carrier-internal schemas without a hand-written mapping layer. The same technique generalizes from raters to submissions to portfolio.",
    logos: [],
  },
];

const philoWork = [
  {
    title: "Schedule rating without the vibes",
    venue: "Tesora blog · 2026",
    body: "Schedule rating is where pricing discipline goes to die. Philo on a transparent credit framework grounded in the carrier's own loss data, with every adjustment auditable.",
    href: "https://tesoraai.substack.com/",
  },
  {
    title: "Exposure-base leakage in contractor's GL",
    venue: "Tesora blog · 2026",
    body: "Three to five points of loss-ratio leakage in contractor's GL isn't social inflation. It's exposure bases captured wrong on day one.",
    href: "https://tesoraai.substack.com/",
  },
  {
    title: "The chief actuary's case for AI agents",
    venue: "CAS Annual Meeting · 2026 (forthcoming)",
    body: "What changes when a credentialed actuary has a credentialed agent. Philo's working draft for the CAS panel session.",
  },
];

const substantialPapers = [
  {
    title: "The substrate thesis",
    body: "Why insurance is next after software and law for an AI substrate, what that substrate looks like, and why context is the thing that matters.",
    href: "https://tesoraai.substack.com/",
  },
];
---

<Layout
  title="Research · Tesora"
  description="Research and writing from Tesora. Federico Reyes Gomez on relational AI for enterprise data, Philo Bishay on actuarial pricing, and the substrate thesis."
  canonical="/research"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/research-loop.mp4")}
    headline="We work in the open where we can."
    deck="Tesora's research thread covers the substrate underneath rating: relational deep learning, learned ontologies, governance and reproducibility, plus the actuarial practice that sits on top."
    primaryCta={{ label: "Read the Substack", href: "https://tesoraai.substack.com/" }}
  />

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-12">
    <p class="eyebrow mb-8">Federico Reyes Gomez · CTO</p>
    <div class="grid md:grid-cols-12 gap-10">
      <p class="md:col-span-4 text-[0.9375rem] leading-[1.65] text-[var(--fg-muted)]">
        Federico led ML research on graph neural networks for relational and tabular data. His work shapes the typed substrate underneath every Tesora agent.
      </p>
      <div class="md:col-span-8">
        {federicoWork.map((w) => (
          <article class="border-t border-[var(--rule)] py-6 first:border-t-0">
            <div class="flex items-center gap-4">
              <p class="text-xs text-[var(--fg-muted)] uppercase tracking-wider">{w.venue}</p>
              {w.logos && w.logos.length > 0 && (
                <div class="flex items-center gap-3">
                  {w.logos.map((l) => (
                    <img
                      src={u(`/logos/${l.slug}.svg`)}
                      alt={l.alt}
                      class="h-4 w-auto opacity-60"
                      style="filter: grayscale(1) brightness(0.5);"
                      loading="lazy"
                    />
                  ))}
                </div>
              )}
            </div>
            <h3 class="mt-2 font-semibold text-[1.125rem] leading-[1.3] tracking-[-0.005em]">{w.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{w.body}</p>
            {w.href && (
              <p class="mt-3">
                <a href={w.href} class="link text-sm" target="_blank" rel="noopener">Read →</a>
              </p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-12">
    <p class="eyebrow mb-8">Philo Bishay · Head of Actuarial</p>
    <div class="grid md:grid-cols-12 gap-10">
      <p class="md:col-span-4 text-[0.9375rem] leading-[1.65] text-[var(--fg-muted)]">
        Philo is a former chief actuary with fifteen years inside the rating function. He writes for the chief actuary who is deciding whether to bring AI into the rate plan.
      </p>
      <div class="md:col-span-8">
        {philoWork.map((w) => (
          <article class="border-t border-[var(--rule)] py-6 first:border-t-0">
            <p class="text-xs text-[var(--fg-muted)] uppercase tracking-wider">{w.venue}</p>
            <h3 class="mt-2 font-semibold text-[1.125rem] leading-[1.3] tracking-[-0.005em]">{w.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{w.body}</p>
            {w.href && (
              <p class="mt-3">
                <a href={w.href} class="link text-sm" target="_blank" rel="noopener">Read →</a>
              </p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[var(--bg-panel)] border-y border-[var(--rule)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
      <div class="grid md:grid-cols-12 gap-10 items-start">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">Substack</p>
          <h2 class="font-semibold text-[2rem] leading-[1.15] tracking-[-0.012em]">
            Long-form: tesoraai.substack.com
          </h2>
          <p class="mt-5 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
            We post working-paper-grade essays on Substack. The latest posts are mirrored here once they cross our editorial bar.
          </p>
          <p class="mt-5">
            <a href="https://tesoraai.substack.com/" class="link" target="_blank" rel="noopener">Subscribe on Substack →</a>
          </p>
        </div>
        <div class="md:col-span-7">
          {substantialPapers.map((p) => (
            <article class="border-t border-[var(--rule)] py-6 first:border-t-0">
              <h3 class="font-semibold text-[1.125rem] leading-[1.3] tracking-[-0.005em]">{p.title}</h3>
              <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{p.body}</p>
              {p.href && (
                <p class="mt-3">
                  <a href={p.href} class="link text-sm" target="_blank" rel="noopener">Read on Substack →</a>
                </p>
              )}
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
