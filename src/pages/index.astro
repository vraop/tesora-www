---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import CinematicHero from "../components/CinematicHero.astro";
import { u } from "../lib/url";
---

<Layout
  title="Tesora · Frontier AI for Actuaries"
  description="Frontier AI for Actuaries. Built for chief actuaries at specialty P&C carriers and MGAs. The Workbench ingests filings, builds and deploys raters, runs standard pricing analyses, and audits the work."
  canonical="/"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/hero-loop.mp4")}
    headline="Frontier AI for Actuaries."
    deck="Built for chief actuaries at specialty P&C carriers and MGAs. The Workbench ingests filings, builds raters, runs the standard analyses, and audits the work."
  >
    <div class="agent-pills mt-12 w-full max-w-[920px] grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5 px-2">
      <a href={`${u("/customers")}#non-admitted`} class="agent-pill group" aria-label="Non-Admitted agent — E&S motion">
        <span class="agent-pill__icon" aria-hidden="true">
          {/* lightning bolt = E&S speed */}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
            <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" />
          </svg>
        </span>
        <span class="agent-pill__body">
          <span class="agent-pill__title-row">
            <span class="agent-pill__title">Non-Admitted</span>
            <span class="agent-pill__tag">AGENT</span>
          </span>
          <span class="agent-pill__sub">Quote in under 6 weeks, not six months.</span>
        </span>
        <span class="agent-pill__arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </span>
      </a>

      <a href={`${u("/customers")}#admitted`} class="agent-pill group" aria-label="Admitted agent — filing motion">
        <span class="agent-pill__icon" aria-hidden="true">
          {/* columned building = admitted / regulated */}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
            <path d="M3 21h18" />
            <path d="M3 10h18" />
            <path d="m12 3 9 5H3l9-5Z" />
            <path d="M6 10v8" />
            <path d="M10 10v8" />
            <path d="M14 10v8" />
            <path d="M18 10v8" />
          </svg>
        </span>
        <span class="agent-pill__body">
          <span class="agent-pill__title-row">
            <span class="agent-pill__title">Admitted</span>
            <span class="agent-pill__tag">AGENT</span>
          </span>
          <span class="agent-pill__sub">Filing-driven raters with SOX-grade audit.</span>
        </span>
        <span class="agent-pill__arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </span>
      </a>
    </div>

    <style>
      .agent-pill {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        border-radius: 999px;
        background: rgba(20, 20, 22, 0.55);
        backdrop-filter: blur(14px) saturate(120%);
        -webkit-backdrop-filter: blur(14px) saturate(120%);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: var(--color-bone, #efe9d9);
        text-align: left;
        transition: background 200ms ease, border-color 200ms ease, transform 200ms ease;
        text-decoration: none;
      }
      .agent-pill:hover {
        background: rgba(30, 30, 34, 0.7);
        border-color: rgba(255, 255, 255, 0.22);
        transform: translateY(-1px);
      }
      .agent-pill__icon {
        flex: 0 0 auto;
        width: 40px;
        height: 40px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.08);
        color: var(--color-bone, #efe9d9);
      }
      .agent-pill__body {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .agent-pill__title-row {
        display: flex;
        align-items: baseline;
        gap: 10px;
      }
      .agent-pill__title {
        font-size: 1.0625rem;
        font-weight: 600;
        letter-spacing: -0.005em;
        line-height: 1.15;
      }
      .agent-pill__tag {
        font-size: 0.6875rem;
        letter-spacing: 0.16em;
        font-weight: 500;
        color: rgba(239, 233, 217, 0.65);
      }
      .agent-pill__sub {
        margin-top: 2px;
        font-size: 0.8125rem;
        color: rgba(239, 233, 217, 0.78);
        line-height: 1.35;
      }
      .agent-pill__arrow {
        flex: 0 0 auto;
        width: 32px;
        height: 32px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.06);
        color: rgba(239, 233, 217, 0.9);
        transition: background 200ms ease, transform 200ms ease;
      }
      .agent-pill:hover .agent-pill__arrow {
        background: rgba(255, 255, 255, 0.14);
        transform: translateX(2px);
      }
    </style>
  </CinematicHero>
</Layout>
