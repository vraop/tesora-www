---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import BackgroundsStrip from "../components/BackgroundsStrip.astro";
import VideoBand from "../components/VideoBand.astro";
import { u } from "../lib/url";

const workflows = [
  {
    num: "01",
    title: "Ingest the messy stuff.",
    body: "Loss runs, SOVs, exposure files, rate manuals, filings, objection letters. PDF, Excel, CSV, Word. Auto-classified, normalized, and source-cited back to the original page and cell.",
  },
  {
    num: "02",
    title: "Build, test, and deploy raters.",
    body: "Turn a rate manual or filing into a working pricing model. Base rates, territory factors, ILFs, schedule mods. Every rater ships with a callable API, a quoting UI, regression tests, and a SOX-compliant audit trail.",
  },
  {
    num: "03",
    title: "Run the standard analyses.",
    body: "Ask in plain English. Loss trend, on-leveling, credibility weighting, distribution fitting, VaR and TVaR, XOL structuring, portfolio cuts. The Copilot writes the report with charts, citations, and commentary.",
  },
  {
    num: "04",
    title: "Compare, audit, and share.",
    body: "Reports are living documents — extend a chart, add a year, swap a method, re-segment. A specialist audit agent catches issues before hand-off. Every workflow becomes a tab your reviewer or underwriter can open directly.",
  },
];

const copilotPatterns = [
  { label: "Be conversational.", body: "Type what you'd say to a junior analyst.", example: "Trend these losses to 2026 at 4%." },
  { label: "Point at data.", body: "Tell it which vault or file to use.", example: "Use the loss run in the Q1 vault." },
  { label: "Iterate freely.", body: "Each follow-up extends the existing report.", example: "Add a state-level breakdown. Also fit a Pareto." },
  { label: "Ask why.", body: "Methodology and source citations are one question away.", example: "Why chain ladder here and not BF?" },
];

---

<Layout
  title="Tesora · Frontier AI for actuaries"
  description="Frontier AI for actuaries. The Tesora Workbench ingests filings, builds and deploys raters, runs standard pricing analyses, and audits the work. The Copilot does the spreadsheet work; you stay in the driver's seat."
  canonical="/"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/hero-loop.mp4")}
    headline="Frontier AI for actuaries."
    deck="The Tesora Workbench ingests filings, builds raters, runs the standard analyses, and audits the work. The Copilot does the spreadsheet wrangling and the write-up. You stay in the driver's seat."
    primaryCta={{ label: "Request a walkthrough", href: "mailto:founders@tesora.ai?subject=Workbench%20walkthrough" }}
    secondaryCta={{ label: "Meet the agents", href: u("/agents") }}
  />

  <BackgroundsStrip />

  {/* Proof row — time compression on specific workflows */}
  <section class="border-b border-[var(--rule)] bg-[var(--bg)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-14">
      <p class="eyebrow mb-8">Time back, per workflow</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-6">
        <div>
          <p class="font-mono text-[1.5rem] leading-none tabular-nums text-[var(--fg)] tracking-tight">
            3 weeks <span class="text-[var(--color-oxblood)]">→</span> 10 min
          </p>
          <p class="mt-4 text-sm font-semibold text-[var(--fg)]">Rater from a competitor's filing.</p>
          <p class="mt-1 text-sm text-[var(--fg-muted)] leading-snug">Tesora reads the SERFF filing, reconstructs the rate plan, and stands up a callable quoting API.</p>
        </div>
        <div class="md:border-l md:border-[var(--rule)] md:pl-6">
          <p class="font-mono text-[1.5rem] leading-none tabular-nums text-[var(--fg)] tracking-tight">
            2 days <span class="text-[var(--color-oxblood)]">→</span> 5 min
          </p>
          <p class="mt-4 text-sm font-semibold text-[var(--fg)]">Loss-run normalization across carriers.</p>
          <p class="mt-1 text-sm text-[var(--fg-muted)] leading-snug">Five carriers, five formats, one normalized table you can run the standard analyses on.</p>
        </div>
        <div class="md:border-l md:border-[var(--rule)] md:pl-6">
          <p class="font-mono text-[1.5rem] leading-none tabular-nums text-[var(--fg)] tracking-tight">
            1 week <span class="text-[var(--color-oxblood)]">→</span> 1 hr
          </p>
          <p class="mt-4 text-sm font-semibold text-[var(--fg)]">Rate-committee brief.</p>
          <p class="mt-1 text-sm text-[var(--fg-muted)] leading-snug">Filing diffs, class-level trends, and a defensible narrative, with every claim cited back to the filing.</p>
        </div>
      </div>
      <p class="mt-10 text-xs text-[var(--fg-muted)] leading-relaxed max-w-[860px]">
        Benchmarks from pilot work with specialty P&amp;C teams. Your own baseline, graded on Day 0, is the only number we promise to beat.
      </p>
    </div>
  </section>

  {/* Thesis */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-32 text-center">
    <p class="eyebrow mb-6">The thesis</p>
    <h2 class="font-semibold text-[2.5rem] leading-[1.1] tracking-[-0.015em] max-w-[820px] mx-auto">
      Pricing was a relay race across spreadsheets, vendor models, and one actuary's memory. The Workbench compresses it.
    </h2>
    <p class="text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)] mt-7 max-w-[680px] mx-auto">
      Loss runs, SOVs, filings, raters, and the actuary's reasoning live in five different places today. The Workbench holds them in one substrate, with lineage from the originating page of the SERFF filing all the way to the quoted premium. Every number has a citation.
    </p>
  </section>

  {/* Workbench preview — four numbered workflows */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 pb-24 pt-8">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="eyebrow mb-3">The Workbench</p>
        <h2 class="font-semibold text-[2rem] leading-[1.15] tracking-[-0.012em] max-w-[640px]">
          Four workflows. One Copilot. Built for actuaries new to AI tools.
        </h2>
      </div>
      <a href={u("/agents")} class="link hidden md:inline-block text-sm">Full spec →</a>
    </div>

    <div class="grid md:grid-cols-2 gap-x-12 gap-y-10">
      {workflows.map((w) => (
        <article class="border-t border-[var(--rule)] pt-6">
          <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{w.num}</p>
          <h3 class="mt-2 font-semibold text-[1.25rem] leading-[1.25] tracking-[-0.005em]">{w.title}</h3>
          <p class="mt-3 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{w.body}</p>
        </article>
      ))}
    </div>

    <p class="mt-10 md:hidden">
      <a href={u("/agents")} class="link text-sm">Full spec →</a>
    </p>
  </section>

  {/* How to work with the Copilot */}
  <section class="bg-[var(--bg-panel)] border-y border-[var(--rule)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
      <div class="flex items-center gap-3 mb-10">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-oxblood,#6b1a1a)]" aria-hidden="true"></span>
        <p class="eyebrow">How to work with the Copilot</p>
      </div>
      <div class="grid md:grid-cols-4 gap-8">
        {copilotPatterns.map((p) => (
          <div>
            <p class="font-semibold text-[1rem]">{p.label}</p>
            <p class="mt-2 text-[0.9375rem] leading-[1.55] text-[var(--fg-muted)]">{p.body}</p>
            <p class="mt-4 text-[0.9375rem] italic leading-[1.5] text-[var(--fg)] border-l-2 border-[var(--color-oxblood,#6b1a1a)] pl-3">
              "{p.example}"
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <VideoBand
    videoSrc={u("/video/research-loop.mp4")}
    eyebrow="The substrate"
    headline="A typed graph from filing to premium."
    body="Loss runs, SOVs, filings, raters, and the actuary's reasoning live in one substrate, with lineage from the originating page all the way to the quote. Every number has a citation."
  />

  <Footer />
</Layout>
