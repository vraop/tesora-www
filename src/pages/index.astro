---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import CinematicHero from "../components/CinematicHero.astro";
import { u } from "../lib/url";
---

<Layout
  title="Tesora · Frontier AI for Actuaries"
  description="The Tesora Workbench helps actuaries work faster, with a reproducible audit trail. Platform-agnostic, it supplements the way your team already works."
  canonical="/"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/hero-loop.mp4")}
    headline="Frontier AI for Actuaries."
    deck="The Tesora Workbench helps actuaries work faster, with a reproducible audit trail. Platform-agnostic, it supplements the way your team already works."
    fullHeight
  >
    <div class="agent-pills mt-12 w-full max-w-[920px] grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5 px-2">
      <a href={u("/agents#insight")} class="agent-pill group" aria-label="Insight agent: loss modeling, trends, on-leveling">
        <span class="agent-pill__icon" aria-hidden="true">
          {/* trending line = insight / pricing */}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
            <path d="M3 3v18h18" />
            <path d="m6 15 4-4 4 3 6-7" />
            <path d="M14 7h6v6" />
          </svg>
        </span>
        <span class="agent-pill__body">
          <span class="agent-pill__title-row">
            <span class="agent-pill__title">Insight</span>
            <span class="agent-pill__tag">AGENT</span>
          </span>
          <span class="agent-pill__sub">Loss modeling, trends, on-leveling, market research.</span>
        </span>
        <span class="agent-pill__arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </span>
      </a>

      <a href={u("/agents#rating")} class="agent-pill group" aria-label="Rating agent: raters, factor tables, callable pricing API">
        <span class="agent-pill__icon" aria-hidden="true">
          {/* stacked layers = factor tables / rating */}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
            <path d="M12 3 2 8l10 5 10-5-10-5Z" />
            <path d="m2 13 10 5 10-5" />
            <path d="m2 18 10 5 10-5" />
          </svg>
        </span>
        <span class="agent-pill__body">
          <span class="agent-pill__title-row">
            <span class="agent-pill__title">Rating</span>
            <span class="agent-pill__tag">AGENT</span>
          </span>
          <span class="agent-pill__sub">Base rates, factors, ILFs, callable pricing API.</span>
        </span>
        <span class="agent-pill__arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </span>
      </a>
    </div>

    <style>
      .agent-pill {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        border-radius: 999px;
        background: rgba(20, 20, 22, 0.55);
        backdrop-filter: blur(14px) saturate(120%);
        -webkit-backdrop-filter: blur(14px) saturate(120%);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: var(--color-bone, #efe9d9);
        text-align: left;
        transition: background 200ms ease, border-color 200ms ease, transform 200ms ease;
        text-decoration: none;
      }
      .agent-pill:hover {
        background: rgba(30, 30, 34, 0.7);
        border-color: rgba(255, 255, 255, 0.22);
        transform: translateY(-1px);
      }
      .agent-pill__icon {
        flex: 0 0 auto;
        width: 40px;
        height: 40px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.08);
        color: var(--color-bone, #efe9d9);
      }
      .agent-pill__body {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .agent-pill__title-row {
        display: flex;
        align-items: baseline;
        gap: 10px;
      }
      .agent-pill__title {
        font-size: 1.1875rem;
        font-weight: 600;
        letter-spacing: -0.005em;
        line-height: 1.15;
      }
      .agent-pill__tag {
        font-size: 0.6875rem;
        letter-spacing: 0.16em;
        font-weight: 500;
        color: rgba(239, 233, 217, 0.65);
      }
      .agent-pill__sub {
        margin-top: 2px;
        font-size: 0.9375rem;
        color: rgba(239, 233, 217, 0.82);
        line-height: 1.4;
      }
      .agent-pill__arrow {
        flex: 0 0 auto;
        width: 32px;
        height: 32px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.06);
        color: rgba(239, 233, 217, 0.9);
        transition: background 200ms ease, transform 200ms ease;
      }
      .agent-pill:hover .agent-pill__arrow {
        background: rgba(255, 255, 255, 0.14);
        transform: translateX(2px);
      }
    </style>
  </CinematicHero>
</Layout>
