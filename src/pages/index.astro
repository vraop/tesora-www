---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import HarnessDiagram from "../components/HarnessDiagram.astro";
import Lifecycle from "../components/Lifecycle.astro";
import { u } from "../lib/url";

type Compare = { theirs: string; ours: string };
const compares: Compare[] = [
  {
    theirs: "Five tools, five exports, reconciled by hand",
    ours: "One Workbench. One audit log. One source of truth.",
  },
  {
    theirs: "Pricing cycles take 4 to 6 weeks of memo work",
    ours: "Cycles compress from quarters to days",
  },
  {
    theirs: "Reviewers cannot trace a factor back to source",
    ours: "Every figure cites the cell it came from",
  },
  {
    theirs: "Rater changes wait on IT to deploy",
    ours: "Versioned in the Workbench, callable from an API",
  },
  {
    theirs: "Generic AI hallucinates and isn't reproducible",
    ours: "Trained on the CAS syllabus, pinned to your data",
  },
];

type Step = { num: string; agent: string; title: string; body: string; outcomes: string[] };
const steps: Step[] = [
  {
    num: "01",
    agent: "Ingestion",
    title: "Read every loss run, SOV, and filing",
    body: "Loss runs, SOVs, exposure files, prior memos, and SERFF filings come in five formats from five carriers. Tesora reads them and hands back one normalized table with every value cited to the cell it came from.",
    outcomes: [
      "PDF, Excel, CSV, Word, email attachments",
      "Auto-classified and anomaly-checked",
      "Every value cites its source",
    ],
  },
  {
    num: "02",
    agent: "Insight",
    title: "Run the analysis your reviewer can sign off on",
    body: "Trending, on-leveling, severity fits, GLMs, reserving. The math was settled decades ago. What slows the work is the assembly: finding the data, picking the method, writing the memo. Tesora handles the assembly. You stay in charge of every decision.",
    outcomes: [
      "Trending, on-leveling, severity fits, GLMs",
      "Reserving (chain ladder, BF, Cape Cod)",
      "Every memo cites the analyses it builds on",
    ],
  },
  {
    num: "03",
    agent: "Rating",
    title: "Build a versioned rater your underwriters quote off of",
    body: "Source a rater from a SERFF filing or rebuild your own from Excel. Edit factor by factor in the Workbench. Every change is versioned. Deploy to a callable pricing API, a GUI, or a versioned Excel file when the reviewer and approver sign off.",
    outcomes: [
      "SERFF or Excel in. GUI, API, or Excel out.",
      "Author, reviewer, approver as separate identities",
      "Roll back any rater to any prior approved state",
    ],
  },
  {
    num: "04",
    agent: "Audit",
    title: "Regrade every analysis before it ships",
    body: "A specialist audit agent regrades every analysis against a battery of actuarial tests before it reaches the actuary. Author, reviewer, and approver are separate people. The audit log records every promotion. Pricing actuarial leadership receives a reviewable artifact, not a black box.",
    outcomes: [
      "Author, reviewer, approver as separate identities",
      "Audit trail preserved across every promotion",
      "Every workflow lands as a reviewable artifact",
    ],
  },
];

type Faq = { q: string; a: string };
const faqs: Faq[] = [
  {
    q: "Can we import our existing rating models?",
    a: "Yes. Upload your Excel raters directly and the system will rebuild, test, and deploy them for you. Formulas parsed, factor tables identified, a versioned model created. Existing logic is preserved exactly.",
  },
  {
    q: "What integrations do you support?",
    a: "Snowflake, Databricks, AWS, Microsoft Excel and Microsoft 365, Okta, and Guidewire are supported out of the box. REST API for anything else. If you use it, we can connect to it.",
  },
  {
    q: "How does role separation work for SOX?",
    a: "Three environments: dev (actuaries build), test (QA validates), prod (underwriters use). Different roles have different access. Actuaries cannot push directly to prod. Full audit trail of who promoted what and when.",
  },
  {
    q: "Do you train on our data?",
    a: "No. Zero data retention policies are in place with our model providers. Your data is not used for model training, ours or anyone else's.",
  },
  {
    q: "Is confidential data protected?",
    a: "Yes. Each customer is deployed as a single-tenant, bespoke environment your IT team controls. Your data does not share infrastructure with any other customer.",
  },
];

type Trust = { title: string; body: string };
const trustBand: Trust[] = [
  { title: "Single-tenant", body: "A bespoke environment your IT team controls. No shared infrastructure." },
  { title: "Zero data retention", body: "Your data is not used for model training. Ours or anyone else's." },
  { title: "SOC 2 + SOX ready", body: "Three environments, separated roles, full audit trail on every promotion." },
  { title: "ASOP-aligned", body: "Trained on the CAS syllabus and ASOPs 23, 41, and 56. The standards your reviewer is held to." },
];

type Stat = { stat: string; label: string };
const stats: Stat[] = [
  { stat: "Quarters → Days", label: "Pricing cycle compression" },
  { stat: "100%", label: "Of figures cite source cell" },
  { stat: "3", label: "Separate identities (author, reviewer, approver)" },
  { stat: "ASOPs 23 · 41 · 56", label: "The standards in the harness" },
];
---

<Layout
  title="Tesora · AI agents built for actuaries"
  description="One Workbench, one audit log, trained on the CAS syllabus. Every agent is geared toward auditability, so the reviewer can sign off on the work that ships. For chief actuaries at specialty P&C carriers and MGAs."
  canonical="/"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/hero-loop.mp4")}
    headline="AI agents built for actuaries."
    deck="Quote, file, and reserve with an audit trail your rate committee can sign against. Trained on the CAS syllabus. Every figure cites the cell it came from."
    primaryCta={{ label: "Request a walkthrough", href: "https://cal.com/team/tesora/quick-chat" }}
    secondaryCta={{ label: "How it works", href: "#how-it-works" }}
  />

  {/* Status quo vs Tesora */}
  <section id="compare" class="border-b border-[var(--rule)] bg-[var(--bg)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20">
      <div class="grid md:grid-cols-12 gap-10 mb-12">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">The status quo</p>
          <h2 class="font-semibold text-[2.25rem] md:text-[2.625rem] leading-[1.05] tracking-[-0.018em]" style="text-wrap: balance;">
            Specialty pricing was never built for the cycle it now runs.
          </h2>
        </div>
        <p class="md:col-span-7 text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)] mt-2" style="text-wrap: pretty;">
          Five tools per cycle, exports reconciled by hand, raters that wait on IT, and generic AI co-pilots that lose the thread between sessions. Pricing teams ship what they can in the time they have. Tesora rebuilt the cycle around the actuary, not around the tooling they inherited.
        </p>
      </div>
      <div class="compare">
        <div class="compare__row compare__row--head">
          <div class="compare__col compare__col--theirs">Without Tesora</div>
          <div class="compare__col compare__col--ours">With Tesora</div>
        </div>
        {compares.map((c) => (
          <div class="compare__row">
            <div class="compare__col compare__col--theirs">
              <span class="compare__mark" aria-hidden="true">×</span>
              <span>{c.theirs}</span>
            </div>
            <div class="compare__col compare__col--ours">
              <span class="compare__mark compare__mark--check" aria-hidden="true">
                <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
                  <polyline points="2,7 6,11 12,3" />
                </svg>
              </span>
              <span>{c.ours}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* How it works — 1·2·3·4 */}
  <section id="how-it-works" class="border-b border-[var(--rule)] bg-[var(--bg-panel)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20">
      <div class="grid md:grid-cols-12 gap-10 mb-12">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">How it works</p>
          <h2 class="font-semibold text-[2.25rem] md:text-[2.625rem] leading-[1.05] tracking-[-0.018em]" style="text-wrap: balance;">
            From loss run to rate-committee sign-off.
          </h2>
        </div>
        <p class="md:col-span-7 text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)] mt-2" style="text-wrap: pretty;">
          Each step has an agent: intake, analysis, rate, audit. The actuary makes every decision. The harness keeps the trail so the rate committee can sign against it.
        </p>
      </div>
      <ol class="steps" role="list">
        {steps.map((s) => (
          <li class="step">
            <div class="step__num" aria-hidden="true">{s.num}</div>
            <div class="step__body">
              <p class="step__eyebrow">{s.agent} Agent</p>
              <h3 class="step__title">{s.title}</h3>
              <p class="step__copy">{s.body}</p>
              <ul class="step__outcomes" role="list">
                {s.outcomes.map((o) => (
                  <li class="step__outcome">
                    <span class="step__bullet" aria-hidden="true"></span>
                    <span>{o}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* Lifecycle (existing component) */}
  <Lifecycle />

  {/* Stat band */}
  <section id="numbers" class="border-b border-[var(--rule)] bg-[var(--bg-panel)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
      <div class="grid md:grid-cols-12 gap-10 mb-10">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">By the numbers</p>
          <h2 class="font-semibold text-[2.25rem] md:text-[2.5rem] leading-[1.05] tracking-[-0.015em]" style="text-wrap: balance;">
            What the harness enforces, every cycle.
          </h2>
        </div>
        <p class="md:col-span-7 text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)] mt-2" style="text-wrap: pretty;">
          Pricing cycles measured in quarters, every figure traced to its source cell, three separate roles before anything ships, and the standards your reviewer is held to.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {stats.map((s) => (
          <div class="border border-[var(--rule)] rounded-[5px] p-6 bg-[var(--bg)]">
            <p class="font-semibold text-[1.625rem] md:text-[1.75rem] leading-[1.1] tracking-[-0.01em] text-[var(--fg)]">{s.stat}</p>
            <p class="mt-2 text-[0.9375rem] leading-[1.5] text-[var(--fg-muted)]">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Workbench + Harness */}
  <section id="workbench" class="border-b border-[var(--rule)] bg-[var(--bg)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20">
      <div class="grid md:grid-cols-12 gap-10 md:gap-14 items-start mb-12">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">Trustworthy AI</p>
          <h2 class="font-semibold text-[2.5rem] md:text-[2.875rem] leading-[1.05] tracking-[-0.018em]">
            The Workbench is the surface. The Harness is the trust.
          </h2>
        </div>
        <div class="md:col-span-7 grid gap-4">
          <p class="text-[1.1875rem] leading-[1.6] text-[var(--fg)]">
            <span class="font-semibold">The Workbench</span> is what the actuary uses. A chat window next to Excel, where you manipulate analyses, rating models, and workbooks the way you already work.
          </p>
          <p class="text-[1.1875rem] leading-[1.6] text-[var(--fg)]">
            <span class="font-semibold">The Harness</span> is the membrane around the agents. It enforces citations, regrades every analysis before it reaches you, and holds author, reviewer, and approver as separate identities. Every decision is yours.
          </p>
        </div>
      </div>
      <HarnessDiagram />
    </div>
  </section>

  {/* Trust band */}
  <section id="trust" class="border-b border-[var(--rule)] bg-[var(--bg-panel)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
      <div class="grid md:grid-cols-12 gap-10 mb-10">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">Built for the auditor</p>
          <h2 class="font-semibold text-[2.25rem] md:text-[2.5rem] leading-[1.05] tracking-[-0.015em]">
            What your risk officer asks about first.
          </h2>
        </div>
        <p class="md:col-span-7 text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)] mt-2">
          Pricing teams don't get to deploy a tool the risk officer hasn't cleared. We built Tesora for that conversation first.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {trustBand.map((t) => (
          <div class="trust-tile">
            <p class="trust-tile__title">{t.title}</p>
            <p class="trust-tile__body">{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Featured writing — spotlight */}
  <section id="writing" class="border-b border-[var(--rule)] bg-[var(--bg)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20">
      <a
        href="https://tesoraai.substack.com/p/jagged-intelligence-for-actuarial"
        class="group block relative bg-[var(--bg)] border border-[var(--rule)] rounded-[6px] overflow-hidden hover:border-[var(--color-oxblood)]/60 transition-colors shadow-[0_20px_50px_-30px_rgba(180,0,254,0.18)] hover:shadow-[0_24px_60px_-28px_rgba(180,0,254,0.28)]"
      >
        <span aria-hidden="true" class="absolute inset-x-0 top-0 h-[3px] bg-[var(--color-oxblood)]"></span>

        <div class="grid md:grid-cols-12 gap-10 p-10 md:p-14">
          <div class="md:col-span-4 flex flex-col gap-4">
            <span class="inline-flex items-center self-start gap-2 px-3 py-1 rounded-full bg-[var(--color-oxblood)]/10 text-[var(--color-oxblood)] text-[0.6875rem] font-semibold tracking-[0.18em] uppercase">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-oxblood)]"></span>
              Featured · Latest
            </span>
            <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">May 27, 2026 · Tesora Substack · 11 min read</p>
            <ul class="flex flex-col gap-2.5 mt-1" role="list">
              <li class="flex gap-3 items-start">
                <span class="mt-[0.55rem] inline-block h-px w-4 bg-[var(--color-oxblood)]/70 flex-shrink-0" aria-hidden="true"></span>
                <p class="text-[0.9375rem] leading-[1.5] text-[var(--fg)]">Why RLVR training spikes on code and math, but valleys on loss runs</p>
              </li>
              <li class="flex gap-3 items-start">
                <span class="mt-[0.55rem] inline-block h-px w-4 bg-[var(--color-oxblood)]/70 flex-shrink-0" aria-hidden="true"></span>
                <p class="text-[0.9375rem] leading-[1.5] text-[var(--fg)]">What Cursor and Claude Code got right that actuarial AI hasn't</p>
              </li>
              <li class="flex gap-3 items-start">
                <span class="mt-[0.55rem] inline-block h-px w-4 bg-[var(--color-oxblood)]/70 flex-shrink-0" aria-hidden="true"></span>
                <p class="text-[0.9375rem] leading-[1.5] text-[var(--fg)]">Why honest abstention is harder than capability, and matters more</p>
              </li>
            </ul>
          </div>

          <div class="md:col-span-8">
            <h2 class="font-semibold text-[2.25rem] md:text-[3rem] leading-[1.05] tracking-[-0.018em] group-hover:text-[var(--color-oxblood)] transition-colors" style="text-wrap: balance;">
              Jagged Intelligence for Actuarial AI
            </h2>
            <p class="mt-5 text-[1.25rem] md:text-[1.375rem] leading-[1.45] text-[var(--fg)]" style="text-wrap: pretty;">
              Why AI can be made reliable for complex actuarial tasks while it still can't count the R's in 'strawberry'.
            </p>

            <div class="mt-8 grid sm:grid-cols-2 gap-4 border-t border-[var(--rule)] pt-6">
              <div>
                <p class="text-[0.9375rem] font-semibold text-[var(--fg)]">Philo Bishay</p>
                <p class="text-[0.875rem] leading-[1.45] text-[var(--fg-muted)]">Former Gen Re actuary. Head of Product, Tesora.</p>
              </div>
              <div>
                <p class="text-[0.9375rem] font-semibold text-[var(--fg)]">Federico Reyes Gomez</p>
                <p class="text-[0.875rem] leading-[1.45] text-[var(--fg-muted)]">Stanford AI researcher. Co-founder, Tesora.</p>
              </div>
            </div>

            <p class="mt-7 text-sm font-medium text-[var(--fg)] group-hover:text-[var(--color-oxblood)] transition-colors">Read on Substack →</p>
          </div>
        </div>
      </a>
    </div>
  </section>

  {/* FAQ */}
  <section id="faq" class="bg-[var(--bg)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20">
      <div class="grid md:grid-cols-12 gap-10 mb-8">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">FAQ</p>
          <h2 class="font-semibold text-[2.25rem] md:text-[2.625rem] leading-[1.05] tracking-[-0.018em]">
            Frequently asked questions
          </h2>
        </div>
        <p class="md:col-span-7 text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)] mt-2">
          Common questions from chief actuaries, pricing teams, and the IT and risk officers who review us alongside them.
        </p>
      </div>

      <div class="border-t border-[var(--rule)]">
        {faqs.map((f, i) => (
          <details class="group border-b border-[var(--rule)]">
            <summary class="flex items-start gap-4 py-5 cursor-pointer list-none">
              <span class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase mt-1 w-8 flex-shrink-0">{String(i + 1).padStart(2, "0")}</span>
              <span class="flex-1 font-semibold text-[1.1875rem] leading-[1.4] tracking-[-0.005em] text-[var(--fg)]">{f.q}</span>
              <span aria-hidden="true" class="ml-3 mt-1 inline-flex h-6 w-6 items-center justify-center rounded-full border border-[var(--rule)] text-[var(--fg-muted)] transition-transform group-open:rotate-45 flex-shrink-0">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3">
                  <path d="M12 5v14" />
                  <path d="M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="pl-12 pr-10 pb-6 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
              {f.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="border-t border-[var(--rule)] bg-[var(--bg-panel)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16 text-center">
      <h2 class="font-semibold text-[2.25rem] md:text-[2.75rem] leading-[1.1] tracking-[-0.015em] max-w-[760px] mx-auto" style="text-wrap: balance;">
        Bring us your hardest pricing question.
      </h2>
      <p class="mt-4 text-[1.125rem] leading-[1.6] text-[var(--fg-muted)] max-w-[620px] mx-auto">
        An in-flight specialty filing, a stale memo, a rater your team can't get off Excel. Make it hard for us, and let us show you the breadth of the Workbench.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 justify-center">
        <a href="https://cal.com/team/tesora/quick-chat" class="inline-flex items-center justify-center px-6 py-3 text-sm font-medium tracking-tight bg-[var(--color-oxblood)] text-white hover:opacity-90 transition-opacity rounded-full">
          Request a walkthrough
        </a>
        <a href={u("/agents")} class="inline-flex items-center text-sm font-medium tracking-tight text-[var(--fg)] hover:text-[var(--color-oxblood)] transition-colors px-6 py-3">
          See the agents →
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .compare {
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
    background: #ffffff;
  }
  :global([data-theme="dark"]) .compare {
    background: rgba(250, 247, 240, 0.03);
  }
  .compare__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }
  .compare__row + .compare__row {
    border-top: 1px solid var(--rule);
  }
  .compare__row--head .compare__col {
    background: var(--bg-panel);
    padding-block: 14px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .compare__row--head .compare__col--ours {
    color: var(--color-oxblood);
  }
  .compare__col {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 18px 22px;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--fg);
  }
  .compare__col--theirs {
    color: var(--fg-muted);
    background: color-mix(in oklab, var(--fg-muted) 4%, transparent);
  }
  .compare__col--ours {
    background: color-mix(in oklab, var(--color-oxblood) 5%, transparent);
    border-left: 1px solid var(--rule);
  }
  .compare__mark {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 700;
    background: color-mix(in oklab, var(--fg-muted) 12%, transparent);
    color: var(--fg-muted);
    margin-top: 2px;
  }
  .compare__mark--check {
    background: color-mix(in oklab, var(--color-oxblood) 14%, transparent);
    color: var(--color-oxblood);
  }
  @media (max-width: 720px) {
    .compare__row { grid-template-columns: 1fr; }
    .compare__col--ours { border-left: 0; border-top: 1px solid var(--rule); }
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 760px) {
    .steps { grid-template-columns: 1fr; }
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    padding: 22px 22px 24px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: #ffffff;
    transition: border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  }
  :global([data-theme="dark"]) .step {
    background: rgba(250, 247, 240, 0.04);
  }
  .step:hover {
    border-color: color-mix(in oklab, var(--color-oxblood) 40%, var(--rule));
    transform: translateY(-2px);
    box-shadow: 0 18px 38px -28px color-mix(in oklab, var(--color-oxblood) 45%, transparent);
  }
  .step__num {
    font-family: var(--font-mono);
    font-size: 2.5rem;
