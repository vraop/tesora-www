---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import BackgroundsStrip from "../components/BackgroundsStrip.astro";
import AgentDef from "../components/AgentDef.astro";
import NewsItem from "../components/NewsItem.astro";
import { u } from "../lib/url";

const agents = [
  {
    name: "Migrate",
    oneLiner: "Pull any rater in.",
    body: "Internal models, competitor SERFF filings, ISO/bureau loops, legacy spreadsheets. Tesora reconstructs the rater with source tracing back to the originating filing.",
  },
  {
    name: "Manage",
    oneLiner: "Stand up, edit, test, deploy. Every change governed.",
    body: "Audit-trailed, SOX-aligned, SOC 2 Type II. Filings stay current with state, exposure, and trend. Reviewers sign off in the same surface they read the change in.",
  },
  {
    name: "Refit",
    oneLiner: "Ask the questions actuaries actually want answered.",
    body: "Is this rater keeping up with trend? Are factors stale? Which classes are bleeding margin and which are carrying the book? The refit agent surfaces the answer with the data behind it.",
  },
];

const news = [
  {
    date: "2026 · MAY",
    headline: "Philo Bishay joins Tesora as Head of Actuarial.",
    body: "Philo, a former chief actuary with fifteen years inside the rating function, joins to lead actuarial product and customer engagement.",
  },
  {
    date: "2025 · OCT",
    headline: "Top startup finalist at DPW Amsterdam 2025.",
    body: "DPW Amsterdam selected Tesora as a top startup finalist in its 2025 procurement-and-insurance innovation showcase.",
  },
  {
    date: "2025 · SEP",
    headline: "Tesora completes Y Combinator S25.",
    body: "Tesora completed the Y Combinator Summer 2025 cohort focused on AI-native applications for regulated industries.",
  },
];
---

<Layout
  title="Tesora · Frontier AI for actuaries"
  description="Frontier AI for actuaries. Tesora is the AI-native pricing substrate for specialty P&C carriers and MGAs. Migrate, Manage, and Refit any rater with a control plane built for chief actuaries."
  canonical="/"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    headline="Frontier AI for actuaries."
    deck="Tesora is the AI-native pricing substrate for specialty property and casualty. Migrate any rater. Manage every change. Refit on real loss data."
    primaryCta={{ label: "Talk to Tesora", href: "mailto:vivek@tesora.ai" }}
    secondaryCta={{ label: "See the agents", href: u("/agents") }}
  />

  <BackgroundsStrip />

  {/* Proof row */}
  <section class="border-b border-[var(--rule)] bg-[var(--bg)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-14">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-6 text-center md:text-left">
        <div>
          <p class="font-mono text-[1.75rem] leading-none tabular-nums text-[var(--fg)] tracking-tight">~10 min</p>
          <p class="mt-3 text-sm text-[var(--fg-muted)] leading-snug">ISO Ohio Commercial Auto reconstructed end to end.</p>
        </div>
        <div class="md:border-l md:border-[var(--rule)] md:pl-6">
          <p class="font-mono text-[1.75rem] leading-none tabular-nums text-[var(--fg)] tracking-tight">$442.80</p>
          <p class="mt-3 text-sm text-[var(--fg-muted)] leading-snug">Quote on a test policy, traceable back to the originating filing.</p>
        </div>
        <div class="md:border-l md:border-[var(--rule)] md:pl-6">
          <p class="font-mono text-[1.75rem] leading-none tabular-nums text-[var(--fg)] tracking-tight">4 agents</p>
          <p class="mt-3 text-sm text-[var(--fg-muted)] leading-snug">Migrate, Manage, Refit, Triage. One control plane.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Thesis */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-32 text-center">
    <p class="eyebrow mb-6">The thesis</p>
    <h2 class="font-semibold text-[2.5rem] leading-[1.1] tracking-[-0.015em] max-w-[820px] mx-auto">
      Insurance was a relay race. AI compresses the layers. Whoever holds the context wins.
    </h2>
    <p class="text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)] mt-7 max-w-[680px] mx-auto">
      Pricing context lives in two places today: the underwriter's head and the actuary's spreadsheets. Neither is durable. Neither survives a model migration. Tesora is the durable substrate: filings, raters, submissions, exposures, portfolio, in a single graph with lineage from the originating SERFF document to the quoted premium.
    </p>
  </section>

  {/* Agents preview */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 pb-24">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="eyebrow mb-3">The agents</p>
        <h2 class="font-semibold text-[2rem] leading-[1.15] tracking-[-0.012em] max-w-[520px]">
          Three primitives. One control plane.
        </h2>
      </div>
      <a href={u("/agents")} class="link hidden md:inline-block text-sm">All agents →</a>
    </div>

    <div>
      {agents.map((a) => (
        <AgentDef name={a.name} oneLiner={a.oneLiner} body={a.body} />
      ))}
    </div>
    <p class="mt-10 md:hidden">
      <a href={u("/agents")} class="link text-sm">All agents →</a>
    </p>
  </section>

  {/* Precedent / News strip */}
  <section class="bg-[var(--bg-panel)] border-y border-[var(--rule)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
      <div class="flex items-end justify-between mb-10">
        <div>
          <p class="eyebrow mb-3">Precedent</p>
          <h2 class="font-semibold text-[2rem] leading-[1.15] tracking-[-0.012em] max-w-[520px]">
            What's happened recently.
          </h2>
        </div>
        <a href={u("/news")} class="link hidden md:inline-block text-sm">Full timeline →</a>
      </div>
      <div>
        {news.map((n) => (
          <NewsItem date={n.date} headline={n.headline} body={n.body} />
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-32 text-center">
    <h2 class="font-semibold text-[2.25rem] leading-[1.15] tracking-[-0.012em] max-w-[680px] mx-auto">
      Talk to a team that has actually priced these lines.
    </h2>
    <p class="text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)] mt-5 max-w-[560px] mx-auto">
      We respond within a business day. No marketing forms. Email Vivek directly.
    </p>
    <div class="mt-8">
      <a href="mailto:vivek@tesora.ai" class="btn">vivek@tesora.ai</a>
    </div>
  </section>

  <Footer />
</Layout>
