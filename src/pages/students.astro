---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const formEndpoint = import.meta.env.PUBLIC_STUDENT_FORM_ENDPOINT ?? "";

const fallbackMailtoBody = encodeURIComponent(`Name:

School and program:

Email:

Exam progress (SOA / CAS):

Area of interest:

What I would build:

Optional link (writing sample, repo, class project):
`);
---

<Layout
  title="Students · Tesora"
  description="Tesora opens a research surface for actuarial students. Free access to a sandboxed substrate, public SERFF corpora, and a Tesora actuary as an informal advisor."
  canonical="/students"
  schemaType="WebPage"
>
  <Header variant="light" />

  <section class="mx-auto max-w-[760px] px-6 md:px-10 pt-24 pb-12">
    <p class="eyebrow mb-5">For actuarial students</p>
    <h1 class="font-semibold text-[2.75rem] md:text-[3.25rem] leading-[1.05] tracking-[-0.02em]">
      Submit for research access.
    </h1>
    <p class="mt-7 text-[1.125rem] leading-[1.55] text-[var(--fg-muted)]">
      Tesora opens a research surface for actuarial students working on capstone projects, exam papers, or independent pricing research. Free access to a sandboxed substrate, public SERFF corpora, and a Tesora actuary as an informal advisor.
    </p>
    <p class="mt-5 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
      Philo (Chief Product Officer) reads every submission within a week.
    </p>
  </section>

  <section class="mx-auto max-w-[760px] px-6 md:px-10 pb-32">
    <form
      id="student-form"
      class="border-t border-[var(--rule)] pt-10 space-y-7"
      data-endpoint={formEndpoint}
      data-fallback={`mailto:sales@tesora.ai?subject=${encodeURIComponent("Student research access")}&body=${fallbackMailtoBody}`}
      novalidate
    >
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <div>
        <label for="sf-name" class="block font-semibold text-[1rem]">Name</label>
        <p class="mt-1 text-[0.875rem] text-[var(--fg-muted)]">Full name as it appears on your transcript.</p>
        <input
          id="sf-name"
          name="name"
          type="text"
          required
          class="mt-3 w-full border border-[var(--rule)] bg-transparent px-4 py-3 text-[1rem] focus:border-[var(--fg)] focus:outline-none"
        />
      </div>

      <div>
        <label for="sf-school" class="block font-semibold text-[1rem]">School and program</label>
        <p class="mt-1 text-[0.875rem] text-[var(--fg-muted)]">University, degree, expected graduation, advisor if any.</p>
        <input
          id="sf-school"
          name="school"
          type="text"
          required
          class="mt-3 w-full border border-[var(--rule)] bg-transparent px-4 py-3 text-[1rem] focus:border-[var(--fg)] focus:outline-none"
        />
      </div>

      <div>
        <label for="sf-email" class="block font-semibold text-[1rem]">School email (.edu)</label>
        <p class="mt-1 text-[0.875rem] text-[var(--fg-muted)]">Your .edu address. Where Philo should reply.</p>
        <input
          id="sf-email"
          name="email"
          type="email"
          required
          pattern="[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.edu$"
          title="Please enter a valid .edu email address."
          placeholder="you@school.edu"
          class="mt-3 w-full border border-[var(--rule)] bg-transparent px-4 py-3 text-[1rem] focus:border-[var(--fg)] focus:outline-none"
        />
      </div>

      <div>
        <label for="sf-exams" class="block font-semibold text-[1rem]">Exam progress</label>
        <p class="mt-1 text-[0.875rem] text-[var(--fg-muted)]">SOA / CAS exams completed and in progress.</p>
        <input
          id="sf-exams"
          name="exam_progress"
          type="text"
          class="mt-3 w-full border border-[var(--rule)] bg-transparent px-4 py-3 text-[1rem] focus:border-[var(--fg)] focus:outline-none"
        />
      </div>

      <div>
        <label for="sf-interest" class="block font-semibold text-[1rem]">Area of interest</label>
        <p class="mt-1 text-[0.875rem] text-[var(--fg-muted)]">Pricing, reserving, ERM, reinsurance, or open. One paragraph.</p>
        <textarea
          id="sf-interest"
          name="area_of_interest"
          rows="3"
          required
          class="mt-3 w-full border border-[var(--rule)] bg-transparent px-4 py-3 text-[1rem] focus:border-[var(--fg)] focus:outline-none resize-y"
        ></textarea>
      </div>

      <div>
        <label for="sf-build" class="block font-semibold text-[1rem]">What you'd build</label>
        <p class="mt-1 text-[0.875rem] text-[var(--fg-muted)]">If we gave you a sandbox with public SERFF data and the Workbench, what would you do first?</p>
        <textarea
          id="sf-build"
          name="what_youd_build"
          rows="4"
          required
          class="mt-3 w-full border border-[var(--rule)] bg-transparent px-4 py-3 text-[1rem] focus:border-[var(--fg)] focus:outline-none resize-y"
        ></textarea>
      </div>

      <div>
        <label for="sf-link" class="block font-semibold text-[1rem]">Optional link</label>
        <p class="mt-1 text-[0.875rem] text-[var(--fg-muted)]">Writing sample, repo, or class project.</p>
        <input
          id="sf-link"
          name="optional_link"
          type="url"
          class="mt-3 w-full border border-[var(--rule)] bg-transparent px-4 py-3 text-[1rem] focus:border-[var(--fg)] focus:outline-none"
        />
      </div>

      <div class="pt-2 flex flex-col items-start gap-4">
        <button type="submit" class="btn" data-submit-label>Submit</button>
        <p id="sf-status" class="text-sm text-[var(--fg-muted)] hidden" role="status" aria-live="polite"></p>
      </div>
    </form>

    <div id="student-form-success" class="border-t border-[var(--rule)] pt-10 hidden">
      <p class="eyebrow mb-3">Submitted</p>
      <h2 class="font-semibold text-[1.5rem] leading-[1.2] tracking-[-0.008em]">
        Thanks. Philo will reply within a week.
      </h2>
      <p class="mt-4 text-[1rem] leading-[1.6] text-[var(--fg-muted)]">
        If you don't hear back, write directly to <a href="mailto:sales@tesora.ai" class="link">sales@tesora.ai</a>.
      </p>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  const form = document.getElementById("student-form") as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById("sf-status") as HTMLParagraphElement | null;
    const success = document.getElementById("student-form-success") as HTMLDivElement | null;
    const submitBtn = form.querySelector("[data-submit-label]") as HTMLButtonElement | null;
    const endpoint = form.dataset.endpoint || "";
    const fallback = form.dataset.fallback || "";

    const showStatus = (msg: string, isError = false) => {
      if (!status) return;
      status.textContent = msg;
      status.classList.remove("hidden");
      status.style.color = isError ? "var(--color-oxblood, #7a1f1f)" : "var(--fg-muted)";
    };

    const showSuccess = () => {
      form.classList.add("hidden");
      success?.classList.remove("hidden");
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const honeypot = (form.elements.namedItem("_gotcha") as HTMLInputElement | null)?.value;
      if (honeypot) return;

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (!endpoint) {
        if (fallback) window.location.href = fallback;
        else showStatus("Form endpoint not configured. Email sales@tesora.ai directly.", true);
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Submitting…";
      }
      showStatus("Submitting…");

      try {
        const data = new FormData(form);
        const res = await fetch(endpoint, {
          method: "POST",
          body: data,
          headers: { Accept: "application/json" },
        });
        if (res.ok) {
          showSuccess();
        } else {
          throw new Error(`Submission failed (${res.status})`);
        }
      } catch (err) {
        showStatus("Something went wrong. Please email sales@tesora.ai directly.", true);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Submit";
        }
      }
    });
  }
</script>
