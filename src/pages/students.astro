---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import { u } from "../lib/url";

const formEndpoint = import.meta.env.PUBLIC_STUDENT_FORM_ENDPOINT ?? "";
---

<Layout
  title="Students · Tesora"
  description="Tesora opens a research surface for actuarial students. Free access to a sandboxed substrate, public SERFF corpora, and a Tesora actuary as an informal advisor."
  canonical="/students"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/students-loop.mp4")}
    headline="For actuarial students."
    deck="Free research access to a sandboxed Workbench, public SERFF corpora, and a Tesora actuary as an informal advisor. Philo (CPO) reads every submission within a week."
    primaryCta={{ label: "Apply below", href: "#apply" }}
    secondaryCta={{ label: "Talk to us", href: "mailto:sales@tesora.ai?subject=Student%20research%20access" }}
  />

  <section id="why-now" class="border-b border-[var(--rule)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
      <div class="grid md:grid-cols-12 gap-8 mb-8">
        <div class="md:col-span-5 reveal">
          <p class="eyebrow mb-3">Why now</p>
          <h2 class="font-semibold text-[2.25rem] leading-[1.1] tracking-[-0.012em]">
            The best decade to enter the profession.
          </h2>
        </div>
        <p class="md:col-span-7 reveal text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)] mt-2" data-reveal-delay="120">
          A credentialed P&amp;C actuary today is in short supply, in high demand, and increasingly underwater on grunt work. The chief actuaries we work with are open about the bottleneck: there is more work than there are people who can sign off on it. That is the gap students are walking into.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-3">
        <div class="lesson-tile reveal" data-reveal-delay="0">
          <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
          <p class="lesson-tile-eyebrow">Growth</p>
          <p class="lesson-tile-title">Faster than the average job.</p>
          <p class="lesson-tile-body">
            The U.S. Bureau of Labor Statistics projects actuarial employment grows much faster than the all-occupations average over the decade. Specialty P&amp;C is where most of that hiring lands.
          </p>
        </div>
        <div class="lesson-tile reveal" data-reveal-delay="120">
          <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
          <p class="lesson-tile-eyebrow">Stability</p>
          <p class="lesson-tile-title">Among the lowest unemployment of any white-collar profession.</p>
          <p class="lesson-tile-body">
            Credentialed actuaries don't sit on the bench. The credential is regulator-recognized, the work is non-discretionary, and rate filings have to ship every year regardless of the cycle.
          </p>
        </div>
        <div class="lesson-tile reveal" data-reveal-delay="240">
          <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
          <p class="lesson-tile-eyebrow">Demographics</p>
          <p class="lesson-tile-title">A meaningful slice of the workforce is within a decade of retirement.</p>
          <p class="lesson-tile-body">
            The credentialed P&amp;C workforce skews older. People are leaving faster than the pipeline backfills. The next generation will own more of the rate plan, earlier, than any cohort before it.
          </p>
        </div>
      </div>

      <div class="mt-10 border-t border-[var(--rule)] pt-8 grid md:grid-cols-12 gap-8">
        <div class="md:col-span-5 reveal">
          <p class="eyebrow mb-3">Where Tesora fits</p>
          <h3 class="font-semibold text-[1.5rem] leading-[1.2] tracking-[-0.008em]">
            Lower grunt work. Hold the audit standard.
          </h3>
        </div>
        <p class="md:col-span-7 reveal text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]" data-reveal-delay="120">
          Tesora takes the steps where the work used to leak. Ingest, schedule build-up, citation, audit. The chief actuary still signs. You still own the judgment. The credential stays gold-standard because the audit trail is gold-standard. You spend the saved hours on the calls that move the rate plan, not on reformatting loss runs at midnight.
        </p>
      </div>
    </div>
  </section>

  <section id="apply" class="mx-auto max-w-[680px] px-6 md:px-10 py-24">
    <p class="eyebrow mb-4">Research access · application</p>
    <h2 class="font-semibold text-[2rem] leading-[1.1] tracking-[-0.012em]">
      Apply for free student access.
    </h2>
    <p class="mt-4 text-[1rem] leading-[1.6] text-[var(--fg-muted)]">
      Four questions. Submit opens your email with the application drafted to Philo. We capture it on our end too.
    </p>

    <form
      id="student-form"
      class="mt-10 space-y-6"
      data-endpoint={formEndpoint}
      novalidate
    >
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <div>
        <label for="sf-name" class="block font-semibold text-[0.9375rem]">Name</label>
        <input
          id="sf-name"
          name="name"
          type="text"
          required
          class="mt-2 w-full border border-[var(--rule)] bg-transparent px-4 py-3 text-[1rem] focus:border-[var(--fg)] focus:outline-none"
        />
      </div>

      <div>
        <label for="sf-email" class="block font-semibold text-[0.9375rem]">School email</label>
        <input
          id="sf-email"
          name="email"
          type="email"
          required
          placeholder="you@school.edu"
          class="mt-2 w-full border border-[var(--rule)] bg-transparent px-4 py-3 text-[1rem] focus:border-[var(--fg)] focus:outline-none"
        />
      </div>

      <div>
        <label for="sf-school" class="block font-semibold text-[0.9375rem]">School, program, exam progress</label>
        <input
          id="sf-school"
          name="school"
          type="text"
          required
          placeholder="UT Austin · BBA Actuarial Sci · P, FM done; IFM in progress"
          class="mt-2 w-full border border-[var(--rule)] bg-transparent px-4 py-3 text-[1rem] focus:border-[var(--fg)] focus:outline-none"
        />
      </div>

      <div>
        <label for="sf-build" class="block font-semibold text-[0.9375rem]">What you'd work on</label>
        <p class="mt-1 text-[0.8125rem] text-[var(--fg-muted)]">Sandbox + public SERFF data. What's the first thing you build?</p>
        <textarea
          id="sf-build"
          name="what_youd_build"
          rows="5"
          required
          class="mt-2 w-full border border-[var(--rule)] bg-transparent px-4 py-3 text-[1rem] focus:border-[var(--fg)] focus:outline-none resize-y"
        ></textarea>
      </div>

      <div class="pt-2 flex flex-col items-start gap-3">
        <button type="submit" class="btn" data-submit-label>Send application</button>
        <p id="sf-status" class="text-sm text-[var(--fg-muted)] hidden" role="status" aria-live="polite"></p>
      </div>
    </form>

    <div id="student-form-success" class="border-t border-[var(--rule)] pt-10 mt-12 hidden">
      <p class="eyebrow mb-3">Submitted</p>
      <h2 class="font-semibold text-[1.5rem] leading-[1.2] tracking-[-0.008em]">
        Thanks. Philo will reply within a week.
      </h2>
      <p class="mt-4 text-[1rem] leading-[1.6] text-[var(--fg-muted)]">
        If you don't hear back, write directly to <a href="mailto:sales@tesora.ai" class="link">sales@tesora.ai</a>.
      </p>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  const form = document.getElementById("student-form") as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById("sf-status") as HTMLParagraphElement | null;
    const success = document.getElementById("student-form-success") as HTMLDivElement | null;
    const submitBtn = form.querySelector("[data-submit-label]") as HTMLButtonElement | null;
    const endpoint = form.dataset.endpoint || "";

    const showStatus = (msg: string, isError = false) => {
      if (!status) return;
      status.textContent = msg;
      status.classList.remove("hidden");
      status.style.color = isError ? "var(--color-oxblood, #7a1f1f)" : "var(--fg-muted)";
    };

    const showSuccess = () => {
      form.classList.add("hidden");
      success?.classList.remove("hidden");
    };

    const buildMailto = (data: FormData) => {
      const name = (data.get("name") as string) || "";
      const email = (data.get("email") as string) || "";
      const school = (data.get("school") as string) || "";
      const build = (data.get("what_youd_build") as string) || "";
      const body = `Name: ${name}\n\nSchool email: ${email}\n\nSchool, program, exam progress: ${school}\n\nWhat I'd build:\n${build}\n`;
      return `mailto:sales@tesora.ai?subject=${encodeURIComponent(
        `Student research access — ${name}`
      )}&body=${encodeURIComponent(body)}`;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const honeypot = (form.elements.namedItem("_gotcha") as HTMLInputElement | null)?.value;
      if (honeypot) return;

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);

      // Fire-and-forget capture if an endpoint is configured.
      if (endpoint) {
        try {
          await fetch(endpoint, {
            method: "POST",
            body: data,
            headers: { Accept: "application/json" },
          });
        } catch {
          // continue to mailto anyway
        }
      }

      // Always open the user's email client with the application drafted.
      window.location.href = buildMailto(data);
      showSuccess();
    });
  }
</script>
